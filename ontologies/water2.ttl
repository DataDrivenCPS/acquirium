    ns1:informativeReference "http://en.wikipedia.org/wiki/Debye?oldid=492149112"^^xsd:anyURI ;
    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/debye> ;
    ns1:symbol "D" ;
