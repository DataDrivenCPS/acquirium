    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/SpecificHeatCapacity> ;
    ns1:iec61360Code "0112/2///62720#UAA119" ;
    ns1:plainTextDescription "unit of the heat energy according to the Imperial system of units divided by the product of the units avoirdupois pound according to the avoirdupois system of units and degree Fahrenheit" ;
    ns1:symbol "Btu{IT}/(lbf⋅°F)" ;
