    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> .

<http://qudt.org/vocab/quantitykind/PressureBasedMolality> a ns1:QuantityKind ;
    rdfs:label "pressure-based molality"@en-us ;
