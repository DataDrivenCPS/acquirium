<http://qudt.org/vocab/prefix/Micro> a ns1:DecimalPrefix,
        ns1:Prefix ;
    rdfs:label "Micro"@en ;
    dcterms:description "\"micro\" is a decimal prefix for expressing a value with a scaling of \\(10^{-6}\\)."^^ns1:LatexString ;
