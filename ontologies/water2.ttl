ns2:SymmetricPropertyShape a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:comment "Declare the inverse triples for symmetric relations" ;
            sh:construct """
CONSTRUCT {
?o ?p $this .
}
WHERE {
  $this ?p ?o .
  ?p a s223:SymmetricProperty .
}
			""" ;
            sh:prefixes <urn:nawi-water-ontology> ],
        [ a sh:SPARQLRule ;
            rdfs:comment "Declare the inverse triples for symmetric relations" ;
            sh:construct """
CONSTRUCT {
?o ?p $this .
}
WHERE {
  $this ?p ?o .
  ?p a s223:SymmetricProperty .
}
			""" ;
            sh:prefixes <urn:nawi-water-ontology> ] ;
    sh:targetClass ns2:Concept .

