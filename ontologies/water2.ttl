    ns1:symbol "L" ;
    ns1:ucumCode "Lmb"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "P30" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

