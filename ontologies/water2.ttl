<http://qudt.org/vocab/unit/B> a ns1:DimensionlessUnit,
        ns1:LogarithmicUnit,
        ns1:Unit ;
    rdfs:label "بل"@ar,
        "бел"@bg,
        "bel"@cs,
        "Bel"@de,
