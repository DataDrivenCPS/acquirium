        <http://qudt.org/vocab/unit/V-PER-MilliM>,
        <http://qudt.org/vocab/unit/V_Ab-PER-CentiM>,
        <http://qudt.org/vocab/unit/V_Stat-PER-CentiM> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0> ;
