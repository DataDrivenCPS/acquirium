    ns1:symbol "0173-1#Z4-BAJ421#003" ;
    rdfs:comment "Applicable units are those of quantitykind:SurfaceRelatedVolumeFlow" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> .

