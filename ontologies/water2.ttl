    rdfs:label "British Thermal Unit (international Table) Per Pound Degree Fahrenheit"@en ;
    dcterms:description "unit of the heat energy according to the Imperial system of units divided by the product of the units avoirdupois pound according to the avoirdupois system of units and degree Fahrenheit"^^rdf:HTML ;
