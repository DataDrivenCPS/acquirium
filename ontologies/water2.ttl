    rdfs:label "abstract" ;
    rdfs:isDefinedBy dcterms:,
        <http://qudt.org/2.1/schema/shacl/qudt> ;
    rdfs:range xsd:string .

dcterms:description a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "description" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

ns1:Verifiable a ns1:AspectClass,
        sh:NodeShape ;
    rdfs:label "Verifiable" ;
    rdfs:comment "An aspect class that holds properties that provide external knowledge and specifications of a given resource." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> ;
    rdfs:subClassOf ns1:Aspect ;
    sh:property ns1:Verifiable-dbpediaMatch,
        ns1:Verifiable-informativeReference,
        ns1:Verifiable-isoNormativeReference,
        ns1:Verifiable-normativeReference .

