    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/SecondAxialMomentOfArea> ;
    ns1:iec61360Code "0112/2///62720#UAA545" ;
