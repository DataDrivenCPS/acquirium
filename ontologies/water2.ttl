<http://qudt.org/vocab/quantitykind/ElectricCurrentPerUnitTemperature> a ns1:QuantityKind ;
    rdfs:label "Electric Current per Unit Temperature"@en ;
    dcterms:description "\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature. Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator derates with temperature."^^ns1:LatexString,
        "\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature. Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator derates with temperature."^^rdf:HTML ;
