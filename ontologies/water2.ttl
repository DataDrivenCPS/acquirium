    ns1:dimensionExponentForLuminousIntensity 0 ;
    ns1:dimensionExponentForMass -1 ;
    ns1:dimensionExponentForThermodynamicTemperature 0 ;
    ns1:dimensionExponentForTime 4 ;
    ns1:dimensionlessExponent 0 ;
