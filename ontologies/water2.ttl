    ns1:ucumCode "cL"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "CLT" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

<http://qudt.org/vocab/unit/CentiM-PER-K> a ns1:Unit ;
    rdfs:label "Centimetre Per Kelvin"@en,
