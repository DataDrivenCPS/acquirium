    ns1:symbol "TB" ;
    ns1:ucumCode "TBy"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "E35" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

