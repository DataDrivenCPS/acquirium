<http://qudt.org/vocab/unit/CentiST> a ns1:Unit ;
    rdfs:label "Centistokes"@en ;
    dcterms:description "\\(\\textbf{Centistokes}\\) is a C.G.S System unit for  'Kinematic Viscosity' expressed as \\(cSt\\)."^^ns1:LatexString ;
