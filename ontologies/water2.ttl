    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/HeatCapacity> ;
    ns1:symbol "Btu{IT}/°F" ;
    ns1:ucumCode "[Btu_IT].[degF]-1"^^ns1:UCUMcs,
        "[Btu_IT]/[degF]"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "N60" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

