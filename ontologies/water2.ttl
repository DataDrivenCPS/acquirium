    sh:path sh:minInclusive .

sh:MinLengthConstraintComponent-minLength a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minLength .

