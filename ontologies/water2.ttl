    dcterms:description "\\(\\textbf{Degree Celsius Centimeter} is a C.G.S System unit for 'Length Temperature' expressed as \\(cm-degC\\)."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
