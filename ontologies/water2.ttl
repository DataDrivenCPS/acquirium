    sh:property [ rdfs:comment "A WaterToAirHeatPump shall have at least one inlet using the medium Fluid-Air." ;
            sh:message "s223: A WaterToAirHeatPump shall have at least one inlet using the medium Fluid-Air." ;
            sh:minCount 1 ;
