    rdfs:label "dimensionless exponent" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

ns1:element a rdf:Property ;
    rdfs:label "element" ;
    dcterms:description "An element of an enumeration"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

