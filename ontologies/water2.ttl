        0.000001 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/KinematicViscosity> ;
