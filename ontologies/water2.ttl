ns6:GMD_DTYPE a ns3:GraphMetaData ;
    rdfs:label "DTYPE Schema Version 2.1 Metadata" ;
    dcterms:created "2011-05-29"^^xsd:date ;
    dcterms:modified "2023-11-14"^^xsd:date ;
    dcterms:title "DTYPE Version 2.1 Metadata" ;
    ns3:description """
The ontology "dtype" provides a specification of simple data types such as enumerations and codelists. 
These are needed in support of the conversion of XML Schemas and UML Models to OWL. 
The purpose of "dtype" is to provide a foundation for expressing rich data types. 
These data types are typically needed when dealing with OWL representations of data structures derived from XML Schema.
""" ;
    ns3:hasGraphRole ns3:SchemaGraph ;
    ns3:hasLicenseType <http://voag.linkedmodel.org/voag/CC-SHAREALIKE_3PT0-US> ;
    ns3:hasOwner ns3:TopQuadrant ;
    ns3:hasSteward ns3:TopQuadrant ;
    ns3:intent "The purpose of DTYPE is to provide, by import, a foundation for  data types." ;
    ns3:latestPublishedVersion "http://www.linkedmodel.org/doc/2023/SCHEMA_dtype"^^xsd:anyURI ;
    ns3:logo "http://www.linkedmodel.org/lib/lm/images/logos/dtype_logo-300x110.png"^^xsd:anyURI ;
    ns3:name "DTYPE" ;
    ns3:namespace "http://www.linkedmodel.org/schema/dtype#"^^xsd:anyURI ;
    ns3:namespacePrefix "dtype" ;
    ns3:owner "LinkedModel.org" ;
