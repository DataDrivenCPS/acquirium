    rdfs:label "Boltzmann constant in inverse metres per kelvin"@en,
        "Boltzmann constant in inverse meters per kelvin"@en-us ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/InverseLengthTemperature> ;
