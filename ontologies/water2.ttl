    dcterms:description "\"Foot per Minute\" is an Imperial unit for  'Linear Velocity' expressed as \\(ft/min\\)."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
