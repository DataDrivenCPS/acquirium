    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/PhotonRadiance> ;
    ns1:symbol "/s⋅m²⋅sr" ;
    ns1:ucumCode "/(s.m2.sr)"^^ns1:UCUMcs,
