    ns1:conversionMultiplier 1.0 ;
    ns1:expression "\\(m^2/kg\\)"^^ns1:LatexString ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0> ;
