<http://qudt.org/vocab/unit/KiloW> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "Kilowatt"@en ;
    dcterms:description "\\(The kilowatt is a derived unit of power in the International System of Units (SI),  The unit, defined as 1,000 joule per second, measures the rate of energy conversion or transfer.\\)"^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
