        "https://qudt.org/doc/2024/07/DOC_SCHEMA-SHACL-QUDT-v2.1.html"^^xsd:anyURI ;
    ns3:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
