    rdfs:label "RotationalFrequency"@en ;
    dcterms:description "A measure of the number of cycles that an item revolves per time period."^^ns1:LatexString ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/CYC-PER-SEC>,
