        "spin"@fr,
        "spin"@it,
        "スピン角運動量"@ja,
        "Spin"@ms,
        "spin"@pl,
        "spin"@pt,
        "Spin"@ro,
        "Спин"@ru,
        "spin"@sl,
        "Spin"@tr,
        "自旋"@zh ;
    dcterms:description "In quantum mechanics and particle physics \"Spin\" is an intrinsic form of angular momentum carried by elementary particles, composite particles (hadrons), and atomic nuclei."^^ns1:LatexString,
        "In quantum mechanics and particle physics \"Spin\" is an intrinsic form of angular momentum carried by elementary particles, composite particles (hadrons), and atomic nuclei."^^rdf:HTML ;
