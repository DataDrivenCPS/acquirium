    ns1:latexDefinition "$\\omega_L = \\frac{e}{2m_e}B$, where $e$ is the elementary charge, $m_e$ is the rest mass of electron, and $B$ is the magnetic flux density."^^ns1:LatexString ;
    ns1:latexSymbol "$\\omega_L$"^^ns1:LatexString ;
