    ns1:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI ;
    ns1:plainTextDescription "\"Luminous Emittance\" is the luminous flux per unit area emitted from a surface." ;
