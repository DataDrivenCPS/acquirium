    ns1:symbol "cup" ;
    ns1:ucumCode "[cup_us]"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "G21" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

