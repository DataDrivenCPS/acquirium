                        sh:path ns2:hasObservationLocation ] ] ),
        ( [ sh:property [ rdfs:comment "A Sensor must be associated with exactly 1 of Connectable, Connection, or ConnectionPoint using the relation hasObservationLocation." ;
                        sh:class ns2:Connectable ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path ns2:hasObservationLocation ] ] [ sh:property [ rdfs:comment "A Sensor must be associated with exactly 1 of Connectable, Connection, or ConnectionPoint using the relation hasObservationLocation." ;
                        sh:class ns2:Connection ;
