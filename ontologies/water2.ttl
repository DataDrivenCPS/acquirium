    ns1:symbol "/pL" ;
    ns1:ucumCode "/pL"^^ns1:UCUMcs,
        "{#}.pL-1"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

