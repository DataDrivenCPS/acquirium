    ns1:plainTextDescription "1,000,000-fold of the SI derived unit joule divided by the power of the SI base unit metre with the exponent 2" ;
    ns1:symbol "MJ/m²" ;
    ns1:ucumCode "MJ.m-2"^^ns1:UCUMcs ;
