    ns1:deprecated true ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H-1T0D0> ;
    ns1:plainTextDescription "\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature. Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator derates with temperature." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> .

