    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/dimensionvector> ;
    owl:versionIRI <http://qudt.org/2.1/vocab/dimensionvector> .

<http://qudt.org/2.1/vocab/constant> rdfs:label "QUDT VOCAB Physical Constants Release 2.1.41",
        "QUDT VOCAB Physical Constants Release 2.1.46" ;
    ns3:hasGraphMetadata ns3:GMD_QUDT-CONSTANTS ;
