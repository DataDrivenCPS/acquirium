        [ rdfs:comment "A FumeHood shall have at least one outlet using the medium Air." ;
            sh:message "s223: A FumeHood shall have at least one outlet using the medium Air." ;
            sh:minCount 1 ;
            sh:path ns2:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class ns2:OutletConnectionPoint ;
                    sh:node [ sh:property [ sh:class ns2:Fluid-Air ;
                                    sh:path ns2:hasMedium ] ] ] ],
        [ rdfs:comment "A FumeHood shall have at least one outlet using the medium Air." ;
            sh:message "s223: A FumeHood shall have at least one outlet using the medium Air." ;
            sh:minCount 1 ;
            sh:path ns2:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class ns2:OutletConnectionPoint ;
                    sh:node [ sh:property [ sh:class ns2:Fluid-Air ;
