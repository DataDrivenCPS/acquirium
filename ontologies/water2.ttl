    ns1:uneceCommonCode "J42" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    owl:sameAs <http://qudt.org/vocab/unit/BTU_IT-IN-PER-SEC-FT2-DEG_F> .

