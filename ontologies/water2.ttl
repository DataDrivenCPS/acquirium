ns2:Role-OutdoorAirIntake a ns2:Class,
        ns2:Role-OutdoorAirIntake,
        sh:NodeShape ;
    rdfs:label "Role-OutdoorAirIntake" ;
    rdfs:comment "Role-OutdoorAirIntake" ;
    rdfs:subClassOf ns2:EnumerationKind-Role ;
    sh:property [ rdfs:comment "Role-OutdoorAirIntake should only be associated with a Connectable directly connecting to Outdoor Air, or properties of this Connectable." ;
            sh:path ns2:hasMedium ;
            sh:severity sh:Warning ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Ensure that Role-OutdoorAirIntake is associated with a Connectable directly connecting to Outdoor Air, or properties of this Connectable." ;
                    sh:message "{?this} is associated with {$entity}, which does not directly connect to outdoor air." ;
                    sh:prefixes <urn:nawi-water-ontology> ;
                    sh:select """
SELECT $this ?entity
WHERE {
?entity (s223:hasRole | (s223:hasProperty/s223:hasAspect)) $this .
?outdoorSpace a/rdfs:subClassOf* s223:OutdoorPhysicalSpace .
?outdoorSpace s223:encloses ?outdoorAir  .
?outdoorAir s223:hasDomain s223:Domain-HVAC .
FILTER NOT EXISTS {?entity s223:connectedFrom ?outdoorAir} .
}
""" ] ],
        [ rdfs:comment "Role-OutdoorAirIntake should only be associated with a Connectable directly connecting to Outdoor Air, or properties of this Connectable." ;
            sh:path ns2:hasMedium ;
            sh:severity sh:Warning ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Ensure that Role-OutdoorAirIntake is associated with a Connectable directly connecting to Outdoor Air, or properties of this Connectable." ;
                    sh:message "{?this} is associated with {$entity}, which does not directly connect to outdoor air." ;
                    sh:prefixes <urn:nawi-water-ontology> ;
                    sh:select """
SELECT $this ?entity
WHERE {
?entity (s223:hasRole | (s223:hasProperty/s223:hasAspect)) $this .
?outdoorSpace a/rdfs:subClassOf* s223:OutdoorPhysicalSpace .
?outdoorSpace s223:encloses ?outdoorAir  .
?outdoorAir s223:hasDomain s223:Domain-HVAC .
FILTER NOT EXISTS {?entity s223:connectedFrom ?outdoorAir} .
}
""" ] ] .

