    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/LiquidVolume> ;
    ns1:iec61360Code "0112/2///62720#UAA373" ;
    ns1:plainTextDescription "0,01-fold of the unit litre" ;
