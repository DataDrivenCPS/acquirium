    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/SpecificEnergy> ;
    ns1:iec61360Code "0112/2///62720#UAB176" ;
