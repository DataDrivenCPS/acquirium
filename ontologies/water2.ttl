            sh:message "s223: A FanPoweredTerminal must be associated with at least one Fan by using the relation contains." ;
            sh:minCount 1 ;
            sh:path ns2:contains ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class ns2:Fan ] ] .

