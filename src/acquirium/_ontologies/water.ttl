watr:Process-pHAdjustment a watr:Class ;
    rdfs:label "pHAdjustment (deprecated)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-pHControl ;
    rdfs:comment "Deprecated designation; use TreatmentObjective-pHControl. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:ProcessAndRoleConstraintsReferenceDefinedClasses a sh:NodeShape ;
    rdfs:label "Process and role constraints reference defined classes" ;
    rdfs:comment "Every class named by a watr:hasProcess, watr:hasTreatmentObjective or s223:hasRole constraint must be defined." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:message "A watr:hasProcess, watr:hasTreatmentObjective or s223:hasRole constraint names a class that is not defined anywhere (check for a rename)." ;
    sh:or ( [ sh:not [ sh:property [ sh:in ( watr:hasProcess watr:hasTreatmentObjective s223:hasRole ) ;
                                sh:minCount 1 ;
                                sh:path sh:path ] ] ] [ sh:property [ sh:node watr:DefinedClassShape ;
                        sh:path ( sh:qualifiedValueShape sh:class ) ],
                    [ sh:node watr:DefinedClassShape ;
                        sh:path sh:hasValue ],
                    [ sh:node watr:DefinedClassShape ;
                        sh:path ( sh:qualifiedValueShape sh:in [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ],
                    [ sh:node watr:DefinedClassShape ;
                        sh:path sh:class ],
                    [ sh:node watr:DefinedClassShape ;
                        sh:path ( sh:in [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] ) ;
    sh:targetSubjectsOf sh:path .

watr:ProcessBearerShape a sh:NodeShape ;
    rdfs:label "Process bearers are equipment or systems" ;
    rdfs:comment "watr:hasProcess and watr:hasTreatmentObjective may only be asserted on an s223:Equipment or an s223:System." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:message "watr:hasProcess and watr:hasTreatmentObjective may only be asserted on s223:Equipment or s223:System. A process is performed by a machine or by a collection of them." ;
    sh:or ( [ sh:class s223:Equipment ] [ sh:class s223:System ] ) ;
    sh:targetSubjectsOf watr:hasProcess,
        watr:hasTreatmentObjective .

watr:ProcessObjectiveRule a sh:NodeShape ;
    rdfs:label "Objective from process" ;
    rdfs:comment "Materializes watr:hasTreatmentObjective onto anything that performs a process which declares watr:achievesTreatmentObjective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:label "Infer the treatment objective from the process performed" ;
            sh:construct """
            CONSTRUCT { $this watr:hasTreatmentObjective ?objective . }
            WHERE {
                $this watr:hasProcess ?process .
                ?process rdf:type?/rdfs:subClassOf*/watr:achievesTreatmentObjective ?objective .
            }
        """ ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ] ;
    sh:targetSubjectsOf watr:hasProcess .

watr:ProcessValueShape a sh:NodeShape ;
    rdfs:label "Process values are water processes" ;
    rdfs:comment "Every object of watr:hasProcess must be a watr:Process." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:class watr:Process ;
    sh:message "Every value of watr:hasProcess must be a watr:Process. An objective belongs on watr:hasTreatmentObjective." ;
    sh:targetObjectsOf watr:hasProcess .

watr:RapidSandFilter a sh:NodeShape,
        watr:Class ;
    rdfs:label "Rapid Sand Filter" ;
    rdfs:comment "A type of media filter that uses sand as the filter medium and operates at high filtration rates." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:MediaFiltrationUnit ;
    sh:property [ sh:message "Instances of RapidSandFilter must have a RapidSandFiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-RapidSandFiltration ] ] .

watr:Reservoir a sh:NodeShape,
        watr:Class ;
    rdfs:label "Reservoir" ;
    rdfs:comment "A large natural or artificial body of water used for water supply" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:ReverseOsmosisMembrane a sh:NodeShape,
        watr:Class ;
    rdfs:label "Reverse Osmosis Membrane" ;
    rdfs:comment "A membrane used for reverse osmosis" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter ;
    sh:property [ sh:message "Instances of ReverseOsmosisMembrane must have a ReverseOsmosis process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-ReverseOsmosis ] ] .

watr:Role-NitrogenRemoval a watr:Class ;
    rdfs:label "NitrogenRemoval (deprecated role)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:comment "Deprecated objective designation formerly modeled as a role; use TreatmentObjective-NitrogenRemoval." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
