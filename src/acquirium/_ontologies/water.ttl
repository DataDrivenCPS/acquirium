@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

watr:Class a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Class" ;
    rdfs:comment "This is a modeling construct. All classes defined in the watr ontology are instances of `watr:Class`." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf rdfs:Class ;
    sh:property [ rdfs:comment "A `Class` must be associated with at least one label using the relation `rdfs:label`." ;
            sh:message "Every term defined by the watr ontology must have an rdfs:label." ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ rdfs:comment "A `Class` must carry a human-readable definition using the relation `rdfs:comment`." ;
            sh:message "Every term defined by the watr ontology must have an rdfs:comment." ;
            sh:minCount 1 ;
            sh:path rdfs:comment ] .

watr:UnitProcess a rdfs:Class ;
    rdfs:label "Unit Process" ;
    rdfs:comment "A unit process is a specific type of water treatment process that can be applied to water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment ;
    sh:property [ sh:class watr:Process ;
            sh:message "A `Unit Process` must be associated with at least one water treatment process using the relation `watr:hasProcess`." ;
            sh:minCount 1 ;
            sh:path watr:hasProcess ] .

watr:AerationBasin a sh:NodeShape,
        watr:Class ;
    rdfs:label "Aeration Basin" ;
    rdfs:comment "A basin in a biological treatment train where air or oxygen is transferred into the mixed liquor to sustain the aerobic biomass. Named for the aeration equipment installed, not for the regime it is run in: a swing zone with diffusers that is operated unaerated is still an aeration basin, carrying Role-Anoxic." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of AerationBasin must have the aerobic or anoxic role." ;
            sh:path s223:hasRole ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:in ( watr:Role-Aerobic watr:Role-Anoxic ) ] ],
        [ sh:message "Instances of AerationBasin must have a Aeration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Aeration ] ] .

watr:AerobicDigester a sh:NodeShape,
        watr:Class ;
    rdfs:label "Aerobic Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste in aerobic conditions" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Digester ;
    sh:property [ sh:message "Instances of AerobicDigester must have a AerobicDigestion process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-AerobicDigestion ] ] .

watr:AirReleaseValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Air Release Valve" ;
    rdfs:comment "Valve for vent trapped air pockets" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:AirStripper a sh:NodeShape,
        watr:Class ;
    rdfs:label "Air Stripper" ;
    rdfs:comment "A vessel, typically a packed tower, in which air is contacted with water to transfer dissolved gases and volatile organic compounds out of the water and into an off-gas stream" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:SeparationTank ;
    sh:property [ sh:message "Instances of AirStripper must have a Stripping process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Stripping ] ] .

watr:AnaerobicDigester a sh:NodeShape,
        watr:Class ;
    rdfs:label "Anaerobic Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste in anaerobic conditions" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Digester ;
    sh:property [ sh:message "Instances of AnaerobicDigester must have a AnaerobicDigestion process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-AnaerobicDigestion ] ] .

watr:Anode a sh:NodeShape,
        watr:Class ;
    rdfs:label "Anode" ;
    rdfs:comment "An electrode where oxidation occurs, often a sacrificial component in electrocoagulation." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Electrode .

watr:BallValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Ball Valve" ;
    rdfs:comment "A valve which operates using a spherical ball with a hole (also known as a bore) through the middle." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:Battery a sh:NodeShape,
        watr:Class ;
    rdfs:label "Battery" ;
    rdfs:comment "A device that stores energy for later use" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Battery .

watr:BeltFilterPress a sh:NodeShape,
        watr:Class ;
    rdfs:label "Belt Filter Press" ;
    rdfs:comment "A dewatering unit that uses a belt system to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DewateringUnit ;
    sh:property [ sh:message "Instances of BeltFilterPress must have a Filtration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ] .

watr:BiologicalAeratedFilter a sh:NodeShape,
        watr:Class ;
    rdfs:label "Biological Aerated Filter (BAF)" ;
    rdfs:comment "A filter that uses biological processes to remove contaminants." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter,
        watr:Reactor ;
    sh:property [ sh:message "Instances of BiologicalAeratedFilter must have a BiologicallyActiveFiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-BiologicallyActiveFiltration ] ] .

watr:Boiler a sh:NodeShape,
        watr:Class ;
    rdfs:label "Boiler" ;
    rdfs:comment "A device for heating water" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Boiler,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Boiler must have a Combustion process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Combustion ] ] .

watr:ButterflyValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Butterfly Valve" ;
    rdfs:comment "A quarter-turn rotary valve used to isolate, start, stop, or regulate the flow of fluids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:CartridgeFiltrationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Cartridge Filtration Unit" ;
    rdfs:comment "A filter system using a cartridge to remove contaminants from fluids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter .

watr:Cathode a sh:NodeShape,
        watr:Class ;
    rdfs:label "Cathode" ;
    rdfs:comment "An electrode where reduction occurs." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Electrode .

watr:CentrifugalDewateringUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Centrifugal Dewatering Unit" ;
    rdfs:comment "A dewatering unit that uses centrifugal force to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DewateringUnit ;
    sh:property [ sh:message "Instances of CentrifugalDewateringUnit must have a Centrifugation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Centrifugation ] ] .

watr:CentrifugalThickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Centrifugal Thickener" ;
    rdfs:comment "A thickener that uses centrifugal force to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [ sh:message "Instances of CentrifugalThickener must have a Centrifugation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Centrifugation ] ] .

watr:CheckValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Check Valve" ;
    rdfs:comment "A valve that normally allows fluid (liquid or gas) to flow through it in only one direction" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:ChlorinationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Chlorination Unit" ;
    rdfs:comment "A unit that uses chlorine or chlorine compounds for disinfection." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DisinfectionUnit ;
    sh:property [ sh:message "Instances of ChlorinationUnit must have a Chlorination process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Chlorination ] ] .

watr:Clarifier a sh:NodeShape,
        watr:Class ;
    rdfs:label "Clarifier" ;
    rdfs:comment "A sedimentation tank operated for its clarified overflow, which passes to the next stage of treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:SedimentationTank ;
    sh:node watr:LiquidSludgeOutletShape ;
    sh:property [ sh:message "Instances of Clarifier must have the Clarification treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-Clarification ] ] .

watr:ClassDefaultsRule a sh:NodeShape ;
    rdfs:label "Class defaults" ;
    rdfs:comment "Materializes watr:hasProcess and watr:hasTreatmentObjective onto an instance from the qualified requirements of its class and that class's ancestors." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:label "Infer required process and treatment objective from the class" ;
            sh:construct """
            CONSTRUCT { $this ?pred ?value . }
            WHERE {
                VALUES ?pred { watr:hasProcess watr:hasTreatmentObjective }
                $this rdf:type/rdfs:subClassOf* ?cls .
                ?cls sh:property ?ps .
                ?ps sh:path ?pred ;
                    sh:qualifiedValueShape/sh:class ?value ;
                    sh:qualifiedMinCount ?min .
                FILTER ( ?min > 0 )
                FILTER NOT EXISTS {
                    $this ?pred ?existing .
                    ?existing rdf:type?/rdfs:subClassOf* ?value .
                }
            }
        """ ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ] ;
    sh:targetClass s223:Equipment .

watr:CoagulationBasin a sh:NodeShape,
        watr:Class ;
    rdfs:label "Coagulation Basin" ;
    rdfs:comment "A basin where coagulation occurs to destabilize particles in water" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of CoagulationBasin must have a Coagulation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Coagulation ] ] .

watr:Cogenerator a sh:NodeShape,
        watr:Class ;
    rdfs:label "Cogenerator" ;
    rdfs:comment "An equipment that produces both electricity and heat from the same energy source" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Cogenerator must have a Cogeneration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Cogeneration ] ] .

watr:CompleteCompositionShape a sh:NodeShape ;
    rdfs:label "Complete Composition Feasibility" ;
    rdfs:comment "A composition explicitly marked complete must permit a total of 100 percent on its common mass or volume basis. Exact values and upper bounds constrain the maximum; unknown and lower-only fractions remain unconstrained up to 100 percent." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:sparql [ sh:message "The complete composition of {$this} can reach at most {?maximum}%, below 100%." ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ;
            sh:select """
            SELECT $this ?kind ?maximum WHERE {
                $this watr:hasCompleteComposition true .
                {
                    SELECT $this ?kind (SUM(?upper) AS ?maximum) WHERE {
                        {
                            SELECT $this ?kind ?constituent (MIN(?bound) AS ?upper) WHERE {
                                $this s223:composedOf ?fraction .
                                ?fraction s223:ofConstituent ?constituent ;
                                          qudt:hasUnit unit:PERCENT ;
                                          qudt:hasQuantityKind ?kind .
                                FILTER (?kind IN (quantitykind:MassFraction, quantitykind:VolumeFraction))
                                OPTIONAL {
                                    ?fraction s223:hasValue ?value .
                                    FILTER NOT EXISTS { ?fraction s223:hasAspect s223:Aspect-LowLimit }
                                }
                                BIND (COALESCE(?value, 100) AS ?bound)
                            }
                            GROUP BY $this ?kind ?constituent
                        }
                    }
                    GROUP BY $this ?kind
                }
                # Different units or bases do not establish a common total.
                FILTER NOT EXISTS {
                    $this s223:composedOf ?other .
                    FILTER NOT EXISTS {
                        ?other s223:ofConstituent ?otherConstituent ;
                               qudt:hasUnit unit:PERCENT ;
                               qudt:hasQuantityKind ?kind .
                    }
                }
                FILTER (?maximum < 100)
            }
        """ ] ;
    sh:targetSubjectsOf s223:composedOf .

watr:CompositionComplementRule a sh:NodeShape ;
    rdfs:label "Composition Complement Rule" ;
    rdfs:comment "Completes an explicitly complete, common-basis percent composition (watr:hasCompleteComposition true) that leaves exactly one constituent unquantified: that fraction is inferred to be the remainder of the others, 100 minus their sum. A medium declared as 12% salt plus a water fraction with no value gains an inferred water value of 88. The fraction may be a blank node or a named one. The rule stays silent when more than one fraction is unquantified, when none is quantified, when any quantified fraction is a range (s223:Aspect-LowLimit / s223:Aspect-HighLimit), and when the remainder would be negative; watr:CompositionPercentageShape reports that last case." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:label "Infer the remaining constituent's percentage" ;
            sh:construct """
            CONSTRUCT {
                ?unquantified s223:hasValue ?complement .
            }
            WHERE {
                $this watr:hasCompleteComposition true ;
                      s223:composedOf ?unquantified .
                ?unquantified s223:ofConstituent ?constituent ;
                              qudt:hasUnit unit:PERCENT ;
                              qudt:hasQuantityKind ?kind .
                FILTER (?kind IN (quantitykind:MassFraction, quantitykind:VolumeFraction))
                # Every declared fraction must use the same basis and unit.
                FILTER NOT EXISTS {
                    $this s223:composedOf ?otherFraction .
                    FILTER NOT EXISTS {
                        ?otherFraction qudt:hasUnit unit:PERCENT ;
                                       qudt:hasQuantityKind ?kind .
                    }
                }
                FILTER NOT EXISTS { ?unquantified s223:hasValue ?existingValue }
                FILTER NOT EXISTS { ?unquantified s223:hasAspect ?anyAspect }

                # The remainder can only be attributed to a single constituent,
                # so bail out if another fraction is unquantified too.
                FILTER NOT EXISTS {
                    $this s223:composedOf ?sibling .
                    ?sibling s223:ofConstituent ?siblingConstituent ;
                             qudt:hasUnit unit:PERCENT .
                    FILTER NOT EXISTS { ?sibling s223:hasValue ?siblingValue }
                    FILTER (?sibling != ?unquantified)
                }

                # Duplicated constituent declarations must not be summed twice.
                FILTER NOT EXISTS {
                    $this s223:composedOf ?first, ?second .
                    ?first s223:ofConstituent ?duplicate .
                    ?second s223:ofConstituent ?duplicate .
                    FILTER (?first != ?second)
                }

                # A composition stated as ranges has no single complement.
                FILTER NOT EXISTS {
                    $this s223:composedOf ?ranged .
                    ?ranged qudt:hasUnit unit:PERCENT ;
                            s223:hasValue ?rangedValue ;
                            s223:hasAspect ?limit .
                    FILTER (?limit IN (s223:Aspect-LowLimit, s223:Aspect-HighLimit))
                }

                # No rows when nothing is quantified, so a composition that names
                # its constituents without values is left alone.
                {
                    SELECT $this ?kind (SUM(?value) AS ?total)
                    WHERE {
                        $this s223:composedOf ?quantified .
                        ?quantified s223:ofConstituent ?quantifiedConstituent ;
                                    qudt:hasUnit unit:PERCENT ;
                                    qudt:hasQuantityKind ?kind ;
                                    s223:hasValue ?value .
                    }
                    GROUP BY $this ?kind
                }
                BIND (100 - ?total AS ?complement)
                FILTER (?complement >= 0)
            }
        """ ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ] ;
    sh:targetSubjectsOf s223:composedOf .

watr:CompositionFractionBoundsShape a sh:NodeShape ;
    rdfs:label "Composition Fraction Bounds" ;
    rdfs:comment "Each declared constituent percentage must lie between zero and 100, inclusive." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:sparql [ sh:message "A constituent percentage must lie between 0 and 100." ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ;
            sh:select """
            SELECT $this ?value WHERE {
                $this qudt:hasUnit unit:PERCENT ; s223:hasValue ?value .
                FILTER (?value < 0 || ?value > 100)
            }
        """ ] ;
    sh:targetObjectsOf s223:composedOf .

watr:CompositionIntervalShape a sh:NodeShape ;
    rdfs:label "Composition Interval Consistency" ;
    rdfs:comment "Exact values and lower/upper bounds on each constituent and fraction basis must have a common feasible value." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:sparql [ sh:message "A constituent has conflicting exact values or lower and upper bounds." ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ;
            sh:select """
            SELECT $this ?constituent ?kind WHERE {
                $this s223:composedOf ?lowerFraction, ?upperFraction .
                ?lowerFraction s223:ofConstituent ?constituent ;
                    qudt:hasQuantityKind ?kind ; qudt:hasUnit unit:PERCENT ;
                    s223:hasValue ?lower .
                ?upperFraction s223:ofConstituent ?constituent ;
                    qudt:hasQuantityKind ?kind ; qudt:hasUnit unit:PERCENT ;
                    s223:hasValue ?upper .
                FILTER NOT EXISTS { ?lowerFraction s223:hasAspect s223:Aspect-HighLimit }
                FILTER NOT EXISTS { ?upperFraction s223:hasAspect s223:Aspect-LowLimit }
                FILTER (?lower > ?upper)
            }
        """ ] ;
    sh:targetSubjectsOf s223:composedOf .

watr:CompositionPercentageShape a sh:NodeShape ;
    rdfs:label "Composition Percentage Shape" ;
    rdfs:comment "A medium's constituent mass or volume fractions expressed in percent cannot add up to more than 100%. Where a constituent is given as a range (s223:Aspect-LowLimit / s223:Aspect-HighLimit), the greatest declared lower bound for that constituent is the one that counts, since only the lower bounds must all be simultaneously satisfiable." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The constituent percentages of {$this} add up to {?total}%, which exceeds 100%." ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ;
            sh:select """
            SELECT $this ?total
            WHERE {
                {
                    SELECT $this ?kind (SUM(?lowest) AS ?total)
                    WHERE {
                        {
                            SELECT $this ?kind ?constituent (MAX(?value) AS ?lowest)
                            WHERE {
                                $this s223:composedOf ?fraction .
                                ?fraction s223:ofConstituent ?constituent ;
                                          qudt:hasUnit unit:PERCENT ;
                                          qudt:hasQuantityKind ?kind ;
                                          s223:hasValue ?value .
                                FILTER (?kind IN (quantitykind:MassFraction, quantitykind:VolumeFraction))
                                FILTER NOT EXISTS { ?fraction s223:hasAspect s223:Aspect-HighLimit }
                            }
                            GROUP BY $this ?kind ?constituent
                        }
                    }
                    GROUP BY $this ?kind
                }
                FILTER (?total > 100)
            }
        """ ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf s223:composedOf .

watr:Compressor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Compressor" ;
    rdfs:comment "An equipment that increases the pressure of a gas" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Compressor .

watr:Condenser a sh:NodeShape,
        watr:Class ;
    rdfs:label "Condenser" ;
    rdfs:comment "A device used to condense a gaseous substance back into a liquid" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:HeatExchanger,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Condenser must have a Condensation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Condensation ] ] .

watr:Conditioner a sh:NodeShape,
        watr:Class ;
    rdfs:label "Conditioner" ;
    rdfs:comment "An equipment used to prepare raw biogas from a digester by removing impurities" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:ConductivitySensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Conductivity Sensor" ;
    rdfs:comment "A sensor used to measure the electrical conductivity of a solution" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:ConstituentRemovalTargetShape a sh:NodeShape ;
    rdfs:label "A constituent-removal objective names its constituent" ;
    rdfs:comment "Warns when a watr:TreatmentObjective-ConstituentRemoval neither states watr:targetsConstituent nor inherits one." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "{$this} is a constituent-removal objective but names no constituent. Add watr:targetsConstituent, or type it as an objective whose parent names one." ;
            sh:prefixes <https://watermetadata.org/ontology/watr> ;
            sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this rdf:type watr:Class }
                FILTER NOT EXISTS {
                    $this rdf:type?/rdfs:subClassOf*/watr:targetsConstituent ?constituent .
                }
            }
        """ ] ;
    sh:targetClass watr:TreatmentObjective-ConstituentRemoval .

watr:ConstituentTargetValueShape a sh:NodeShape ;
    rdfs:label "Constituent target values are constituents" ;
    rdfs:comment "Every object of watr:targetsConstituent must be an s223:Medium-Constituent." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:class s223:Medium-Constituent ;
    sh:message "Every value of watr:targetsConstituent must be an s223:Medium-Constituent, such as watr:Constituent-Nitrogen." ;
    sh:targetObjectsOf watr:targetsConstituent .

watr:ContinuouslyStirredTankReactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "ContinuouslyStirredTankReactor" ;
    rdfs:comment "A reactor in which contents are well mixed and reactants are added continuously" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor .

watr:Controller a sh:NodeShape,
        watr:Class ;
    rdfs:label "Controller" ;
    rdfs:comment "A piece of equipment for regulation of a system or component in normal operation, which executes one or more `Function`s." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Controller .

watr:Crystallizer a sh:NodeShape,
        watr:Class ;
    rdfs:label "Crystallizer" ;
    rdfs:comment "An equipment used to produce solid crystals from a solution" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Crystallizer must have a Crystallization process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Crystallization ] ] .

watr:DMERecoverySystem a sh:NodeShape,
        watr:Class ;
    rdfs:label "Dimethyl Ether (DME) Recovery System" ;
    rdfs:comment "A system designed to recover a high percentage of Dimethyl Ether solvent in solvent-driven processes." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:DissolvedAirFlotationThickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Dissolved Air Flotation Thickener" ;
    rdfs:comment "A thickener that uses dissolved air to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [ sh:message "Instances of DissolvedAirFlotationThickener must have a Flotation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Flotation ] ] .

watr:EfficiencySensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Efficiency Sensor" ;
    rdfs:comment "A sensor used to measure the efficiency of a system or equipment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:ElectricallyConductingMembrane a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electrically Conducting Membrane" ;
    rdfs:comment "A membrane capable of conducting electricity, used for in-situ cleaning or electro-oxidation processes." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter .

watr:ElectroDialyticCrystallizer a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electro-Dialytic Crystallizer (EDC)" ;
    rdfs:comment "A modular system designed for brine concentration and crystallization, integrating electrodialysis and crystallization." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of ElectroDialyticCrystallizer must have a Crystallization process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Crystallization ] ],
        [ sh:message "Instances of ElectroDialyticCrystallizer must have a Electrodialysis process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Electrodialysis ] ] .

watr:ElectrocoagulationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electrocoagulation Unit" ;
    rdfs:comment "A unit that uses electrocoagulation for contaminant removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:Reactor ;
    sh:property [ sh:message "Instances of ElectrocoagulationUnit must have a Electrocoagulation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Electrocoagulation ] ] .

watr:ElectrodialysisUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electrodialysis" ;
    rdfs:comment "A unit that uses electricity to drive ion movement through a membrane" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of ElectrodialysisUnit must have a Electrodialysis process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Electrodialysis ] ] .

watr:Electrolyzer a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electrolyzer" ;
    rdfs:comment "An equipment that uses electricity to split liquids into constituent elements" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Electrolyzer must have a Electrolysis process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Electrolysis ] ] .

watr:ElectromagneticFieldDevice a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electromagnetic Field (EMF) Device" ;
    rdfs:comment "A device that generates an electromagnetic field, used as a pretreatment method for membrane scaling and fouling control." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:EquipmentRegion a sh:NodeShape,
        watr:Class ;
    rdfs:label "Equipment Region" ;
    rdfs:comment "An identifiable functional portion of a piece of equipment, distinguished by its treatment activity. It need not be physically partitioned or independently installed. Each region has exactly one direct equipment parent, at least one process, and at least one connection point. Nested regions must ultimately belong to equipment that is not itself a region. Roles are optional." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment ;
    sh:property [ sh:class s223:ConnectionPoint ;
            sh:message "An EquipmentRegion must have at least one connection point." ;
            sh:minCount 1 ;
            sh:path s223:hasConnectionPoint ],
        [ sh:class watr:Process ;
            sh:message "An EquipmentRegion must identify at least one treatment process." ;
            sh:minCount 1 ;
            sh:path watr:hasProcess ],
        [ sh:class s223:Equipment ;
            sh:maxCount 1 ;
            sh:message "An EquipmentRegion must have exactly one direct parent Equipment through s223:contains." ;
            sh:minCount 1 ;
            sh:path [ sh:inversePath s223:contains ] ] ;
    sh:sparql [ sh:message "An EquipmentRegion must ultimately be contained by Equipment that is not an EquipmentRegion." ;
            sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX s223: <http://data.ashrae.org/standard223#>
            PREFIX watr: <https://watermetadata.org/ontology/watr#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this (^s223:contains)+ ?root .
                    ?root rdf:type/rdfs:subClassOf* s223:Equipment .
                    FILTER NOT EXISTS {
                        ?root rdf:type/rdfs:subClassOf* watr:EquipmentRegion .
                    }
                }
            }
        """ ],
        [ sh:message "An EquipmentRegion's containment ancestry must not contain a cycle." ;
            sh:select """
            PREFIX s223: <http://data.ashrae.org/standard223#>
            SELECT $this WHERE {
                $this (^s223:contains)* ?ancestor .
                ?ancestor s223:contains+ ?ancestor .
            }
        """ ] .

watr:Evaporator a sh:NodeShape,
        watr:Class ;
    rdfs:label "Evaporator" ;
    rdfs:comment "A device used to turn the liquid form of a substance into its gaseous form" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:HeatExchanger,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Evaporator must have a Evaporation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Evaporation ] ] .

watr:Flare a sh:NodeShape,
        watr:Class ;
    rdfs:label "Flare" ;
    rdfs:comment "A device used to burn off unwanted gas" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:FlocculationBasin a sh:NodeShape,
        watr:Class ;
    rdfs:label "Flocculation Basin" ;
    rdfs:comment "A tank where flocculation occurs to aggregate particles in water" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of FlocculationBasin must have a Flocculation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Flocculation ] ] .

watr:FlowSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Flow Sensor" ;
    rdfs:comment "A sensor used to measure the flow rate of liquids or gases" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:FlowSensor .

watr:FrequencySensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Frequency Sensor" ;
    rdfs:comment "A sensor used to measure the frequency of a signal or mechanical vibration" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:GlobeValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Globe Valve" ;
    rdfs:comment "A linear-motion valve primarily used for stopping, starting, and regulating (throttling) fluid flow" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:GranularActivatedCarbonAdsorber a sh:NodeShape,
        watr:Class ;
    rdfs:label "Granular Activated Carbon (GAC) Adsorber" ;
    rdfs:comment "A unit that uses granulated activated carbon to adsorb impurities from water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of GranularActivatedCarbonAdsorber must have a GACFiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-GACFiltration ] ] .

watr:GravityBeltThickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Gravity Belt Thickener" ;
    rdfs:comment "A belt thickener in which gravity drains water through a porous moving belt. It uses filtration rather than the sedimentation mechanism of a conventional gravity thickener." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:BeltThickener .

watr:GravityThickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Gravity Thickener" ;
    rdfs:comment "A thickener that uses gravity to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Thickener ;
    sh:node watr:LiquidSludgeOutletShape ;
    sh:property [ sh:message "Instances of GravityThickener must have a Settling process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Settling ] ] .

watr:Grinder a sh:NodeShape,
        watr:Class ;
    rdfs:label "Grinder" ;
    rdfs:comment "Machine that shreds solid waste into tiny particles" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Grinder must have the Comminution process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Comminution ] ] .

watr:GritChamber a sh:NodeShape,
        watr:Class ;
    rdfs:label "Grit Chamber" ;
    rdfs:comment "A chamber used to remove grit from wastewater" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of GritChamber must have a Settling process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Settling ] ],
        [ sh:message "Instances of GritChamber must have the SuspendedSolidsRemoval treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-SuspendedSolidsRemoval ] ] .

watr:ImhoffTank a sh:NodeShape,
        watr:Class ;
    rdfs:label "Imhoff Tank" ;
    rdfs:comment "A sedimentation tank specifically designed for septic treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:SepticTank .

watr:IonExchangeMembrane a sh:NodeShape,
        watr:Class ;
    rdfs:label "Ion Exchange Membrane" ;
    rdfs:comment "A membrane that selectively allows ions to pass through while blocking other substances" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of IonExchangeMembrane must have a IonExchange process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-IonExchange ] ] .

watr:LevelSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Level Sensor" ;
    rdfs:comment "A sensor used to detect the level of liquids or solids in a tank" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:ManualMeasurementPort a sh:NodeShape,
        watr:Class ;
    rdfs:label "Manual Measurement Port" ;
    rdfs:comment "A location where manual measurements are taken" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:MembraneAeratedBiofilmReaactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Membrane Aerated Biofilm Reactor" ;
    rdfs:comment "A reactor that grows biofilm on membranes supplied with air" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of MembraneAeratedBiofilmReactor must have a Aeration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Aeration ] ] .

watr:MembraneBioreactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Membrane Bioreactor" ;
    rdfs:comment "A filter system that combines a membrane process like microfiltration with a biological reactor" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter,
        watr:Reactor,
        watr:SeparationTank ;
    sh:property [ sh:message "Instances of MembraneBioreactor must have a Biofiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ],
        [ sh:message "Instances of MembraneBioreactor must have either the Microfiltration or Ultrafiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:in ( watr:Process-Microfiltration watr:Process-Ultrafiltration ) ] ] .

watr:MicrofiltrationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Microfiltration Unit" ;
    rdfs:comment "A filter system which removes contaminants from a liquid by passing it through a microporous membrane" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter ;
    sh:property [ sh:message "Instances of MicrofiltrationUnit must have a Microfiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Microfiltration ] ] .

watr:MixingBasin a sh:NodeShape,
        watr:Class ;
    rdfs:label "Mixing Basin" ;
    rdfs:comment "A tank where mixed liquor is stirred without aeration" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of MixingBasin must have the anoxic or anaerobic role." ;
            sh:path s223:hasRole ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:in ( watr:Role-Anoxic watr:Role-Anaerobic ) ] ],
        [ sh:message "Instances of MixingBasin must have a Mixing process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Mixing ] ] .

watr:MolybdenumSulfideBasedMembrane a sh:NodeShape,
        watr:Class ;
    rdfs:label "Molybdenum Sulfide (MoS2)-based Membrane" ;
    rdfs:comment "A specific material demonstrating effectiveness in removing heavy metals and oxyanions with high selectivity." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter .

watr:MovingBedBioreactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Moving Bed Bioreactor (MBBR)" ;
    rdfs:comment "MBBR process using suspended growth media a tank" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter,
        watr:Reactor ;
    sh:property [ sh:message "Instances of MovingBedBioreactor must have a Biofiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ] .

watr:MultifunctionalMembrane a sh:NodeShape,
        watr:Class ;
    rdfs:label "Multifunctional Membrane" ;
    rdfs:comment "A membrane integrating multiple processes (e.g., reduction, adsorption, filtration) for selective removal and recovery of contaminants." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter .

watr:NanofiltrationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Nanofiltration Unit" ;
    rdfs:comment "A membrane filter with a pore size between ultrafiltration and reverse osmosis, which rejects divalent ions and larger organic molecules while passing most monovalent salts" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter .

watr:OxidationDitch a sh:NodeShape,
        watr:Class ;
    rdfs:label "Oxidation Ditch" ;
    rdfs:comment "Modified activated sludge process that uses a ring-shaped channel to biologically remove pollutants" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of OxidationDitch must have a ActivatedSludge process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-ActivatedSludge ] ],
        [ sh:message "Instances of OxidationDitch must have the OrganicsRemoval treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-OrganicsRemoval ] ] .

watr:OxygenDemandSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "OxygenDemand Sensor" ;
    rdfs:comment "A sensor used to measure Chemical Oxygen Demand (COD) and Biological Oxygen Demand (BOD)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:OxygenMeter a sh:NodeShape,
        watr:Class ;
    rdfs:label "Oxygen Meter" ;
    rdfs:comment "A sensor used to measure the concentration of oxygen" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:ConcentrationSensor .

watr:OzonationUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Ozonation Unit" ;
    rdfs:comment "A unit that uses ozone for water treatment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:UnitProcess ;
    sh:property [ sh:message "Instances of OzonationUnit must have a Ozonation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Ozonation ] ] .

watr:PlugFlowReactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "PlugFlowReactor" ;
    rdfs:comment "A type of reactor where the fluid flows in one direction through the tube" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ rdfs:comment "A plug flow reactor has at least one inlet fluid connection point" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:InletConnectionPoint ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:path s223:hasMedium ] ] ],
        [ rdfs:comment "A plug flow reactor has at least one outlet fluid connection point" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:path s223:hasMedium ] ] ] .

watr:PlugValve a sh:NodeShape,
        watr:Class ;
    rdfs:label "Plug Valve" ;
    rdfs:comment "A valve with cylindrical or conically tapered plugs which can be rotated inside the valve body to control flow through the valve" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Valve .

watr:Pond a sh:NodeShape,
        watr:Class ;
    rdfs:label "Pond" ;
    rdfs:comment "A body of still water smaller than a lake, used for treatment or storage." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:PressureExchanger a sh:NodeShape,
        watr:Class ;
    rdfs:label "PressureExchanger" ;
    rdfs:comment "A device used to transfer pressure energy from one fluid to another" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:PressureSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Pressure Sensor" ;
    rdfs:comment "A sensor used to measure pressure" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:PressureSensor .

