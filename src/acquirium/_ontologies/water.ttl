watr:Role-SolidsHandling a watr:Class ;
    rdfs:label "SolidsHandling (deprecated role)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-VolumeReduction ;
    rdfs:comment "Deprecated objective designation formerly modeled as a role; use TreatmentObjective-VolumeReduction." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Role-Stabilization a watr:Class ;
    rdfs:label "Stabilization (deprecated role)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-Stabilization ;
    rdfs:comment "Deprecated objective designation formerly modeled as a role; use TreatmentObjective-Stabilization." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:RotaryDrumThickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Rotary Drum Thickener" ;
    rdfs:comment "A thickener that uses a rotating drum to separate solids from liquids" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [ sh:message "Instances of RotaryDrumThickener must have a Filtration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ] .

watr:RotatingBiologicalContactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Rotating Biological Contactor (RBC)" ;
    rdfs:comment "Fixed-film process using a slowly rotating discs partially submerged in a tank" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Filter,
        watr:Reactor ;
    sh:property [ sh:message "Instances of RotatingBiologicalContactor must have a Biofiltration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ] .

watr:RotationSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Rotation Sensor" ;
    rdfs:comment "A sensor used to measure the rotational speed or position of an object" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Sensor .

watr:Screen a sh:NodeShape,
        watr:Class ;
    rdfs:label "Screen" ;
    rdfs:comment "An equipment used for separation" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Screen must have the SuspendedSolidsRemoval treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-SuspendedSolidsRemoval ] ],
        [ sh:message "Instances of Screen must have a Screening process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Screening ] ] .

watr:SequencingBatchReactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "SequencingBatchReactor" ;
    rdfs:comment "A type of activated sludge process for wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor,
        watr:SeparationTank ;
    sh:property [ rdfs:comment "A SBR has at least 1 sludge outlet" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:property [ sh:class watr:Fluid-Sludge ;
                            sh:path s223:hasMedium ] ] ],
        [ sh:message "Instances of SequencingBatchReactor must have a Settling process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Settling ] ],
        [ sh:message "Instances of SequencingBatchReactor must have the OrganicsRemoval treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-OrganicsRemoval ] ],
        [ sh:message "Instances of SequencingBatchReactor must have a ActivatedSludge process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-ActivatedSludge ] ] .

