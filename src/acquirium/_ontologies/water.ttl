    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Process-ThermalDisinfection a watr:Class ;
    rdfs:label "ThermalDisinfection (deprecated)" ;
    dcterms:isReplacedBy watr:Process-ThermalTreatment ;
    rdfs:comment "Deprecated designation; use Process-ThermalTreatment. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Process-Thickening a watr:Class ;
    rdfs:label "Thickening (deprecated)" ;
