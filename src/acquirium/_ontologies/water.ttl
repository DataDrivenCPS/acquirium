    dcterms:isReplacedBy watr:TreatmentObjective-NutrientRemoval ;
    rdfs:comment "Deprecated objective designation formerly modeled as a role; use TreatmentObjective-NutrientRemoval." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Role-PhosphorusRemoval a watr:Class ;
    rdfs:label "PhosphorusRemoval (deprecated role)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:comment "Deprecated objective designation formerly modeled as a role; use TreatmentObjective-PhosphorusRemoval." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
