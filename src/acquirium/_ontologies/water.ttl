    dcterms:isReplacedBy watr:TreatmentObjective-Disinfection ;
    rdfs:comment "Deprecated designation; use TreatmentObjective-Disinfection. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Process-Drying a watr:Class ;
    rdfs:label "Drying (deprecated)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-Drying ;
    rdfs:comment "Deprecated designation; use TreatmentObjective-Drying. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Process-Landfill a watr:Class ;
    rdfs:label "Landfill (deprecated)" ;
    dcterms:isReplacedBy watr:Process-Landfilling ;
    rdfs:comment "Deprecated designation; use Process-Landfilling. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

watr:Process-Neutralization a watr:Class ;
    rdfs:label "Neutralization (deprecated)" ;
