    rdfs:comment "Deprecated designation; use TreatmentObjective-Neutralization. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    owl:deprecated true .

