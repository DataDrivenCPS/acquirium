    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics .

watr:Precision-ReproducibilityStdDev a sh:NodeShape,
        watr:Class,
        watr:Precision-ReproducibilityStdDev ;
    rdfs:label "Reproducibility Standard Deviation" ;
    rdfs:comment "Standard deviation under reproducibility conditions (different operators, equipment, time)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics .

watr:Process-AirScouring a watr:Class,
        watr:Process-AirScouring ;
    rdfs:label "Air Scouring" ;
    rdfs:comment "A cleaning process that uses injected air to dislodge accumulated foulants or solids from filter media or membrane surfaces." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Cleaning .

watr:Process-ChemicalAddition a watr:Class,
        watr:Process-ChemicalAddition ;
    rdfs:label "ChemicalAddition (deprecated)" ;
    dcterms:isReplacedBy watr:Process-Dosing ;
    rdfs:comment "Deprecated process designation; use Process-Dosing." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Dosing ;
    owl:deprecated true .

watr:Process-ChemicalPrecipitation a watr:Class,
        watr:Process-ChemicalPrecipitation ;
    rdfs:label "Chemical Precipitation" ;
    rdfs:comment "Addition of a reagent that converts a dissolved constituent into an insoluble solid, so that it can be separated from the water. This process implies general constituent removal. Which constituent it targets depends on the reagent, so the modeler states the specific removal objective on the equipment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-ConstituentRemoval .

watr:Process-ClosedCircuitReverseOsmosis a watr:Class,
        watr:Process-ClosedCircuitReverseOsmosis ;
    rdfs:label "Closed Circuit Reverse Osmosis (CCRO)" ;
    rdfs:comment "Reverse osmosis operated as a batch, with the concentrate recirculated to the feed side of the same module until a target recovery is reached and then displaced, rather than run as a once-through stage." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-Composting a watr:Class,
        watr:Process-Composting ;
    rdfs:label "Composting" ;
    rdfs:comment "Biological degradation of organic materials under controlled aerobic conditions." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal,
        watr:TreatmentObjective-Stabilization .

watr:Process-ElectroDialyticCrystallization a watr:Class,
        watr:Process-ElectroDialyticCrystallization ;
    rdfs:label "Electro-Dialytic Crystallization (EDC)" ;
    rdfs:comment "A novel integrated process combining electrodialysis and crystallization for energy-efficient Zero-Liquid Discharge (ZLD) by maintaining a saturated brine stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Crystallization,
        watr:Process-Electrodialysis .

watr:Process-Electrooxidation a watr:Class,
        watr:Process-Electrooxidation ;
    rdfs:label "Electrooxidation (EO)" ;
    rdfs:comment "Oxidation of contaminants at the surface of an anode, and by oxidants generated there, under an applied electric current rather than by a dosed reagent." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Oxidation,
        watr:Process-PhysicalProcess .

watr:Process-Elutriation a watr:Class,
        watr:Process-Elutriation ;
    rdfs:label "Elutriation" ;
    rdfs:comment "A process that uses a stream of fluid flowing upward to separate a mixture of particles based on their size, shape, and density." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-FeedReversalReverseOsmosis a watr:Class,
        watr:Process-FeedReversalReverseOsmosis ;
    rdfs:label "Feed Reversal Reverse Osmosis (FRRO)" ;
    rdfs:comment "Reverse osmosis in which the direction of feed flow through the train is periodically reversed, so that the elements which saw the most concentrated water see the feed next and scale that has begun to form is redissolved." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-FiveStageBardenpho a watr:Class,
        watr:Process-FiveStageBardenpho ;
    rdfs:label "Five-Stage BARDENPHO (BARnard DENitrification and PHOsphorus removal)" ;
    rdfs:comment "A five-stage biological nutrient removal process specifically designed for nitrogen and phosphorus." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ActivatedSludge ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval,
        watr:TreatmentObjective-PhosphorusRemoval ;
    watr:includesProcess watr:Process-Denitrification,
        watr:Process-EnhancedBiologicalPhosphorusRemoval,
        watr:Process-Nitrification,
        watr:Process-Recirculation .

watr:Process-FluidizedBedIncineration a watr:Class,
        watr:Process-FluidizedBedIncineration ;
    rdfs:label "Fluidized Bed Incineration" ;
    rdfs:comment "A process that combusts a constantly moving bed of biosolids." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Combustion ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal .

watr:Process-FourStageBardenpho a watr:Class,
        watr:Process-FourStageBardenpho ;
    rdfs:label "Four-Stage BARDENPHO (BARnard DENitrification and PHOsphorus removal)" ;
    rdfs:comment "A four-stage biological nutrient removal process with two anoxic and two aerobic zones." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ActivatedSludge ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    watr:includesProcess watr:Process-Denitrification,
        watr:Process-Nitrification,
        watr:Process-Recirculation .

watr:Process-GranularActivatedCarbon a watr:Class,
        watr:Process-GranularActivatedCarbon ;
    rdfs:label "GranularActivatedCarbon (deprecated)" ;
    dcterms:isReplacedBy watr:Process-GACFiltration ;
    rdfs:comment "Deprecated process designation; use Process-GACFiltration." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-GACFiltration ;
    owl:deprecated true .

watr:Process-HighDensitySludge a watr:Class,
        watr:Process-HighDensitySludge ;
    rdfs:label "High-Density Sludge (HDS) Process" ;
    rdfs:comment "Lime neutralization of an acidic stream, typically acid mine drainage, in which previously formed sludge is recycled into the reaction so that metal hydroxides precipitate onto existing particles and settle as a denser sludge." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Neutralization .

watr:Process-LandApplication a watr:Class,
        watr:Process-LandApplication ;
    rdfs:label "Land Application" ;
    rdfs:comment "Spreading treated biosolids on agricultural or reclamation land, where they serve as a soil amendment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal .

watr:Process-MLE a watr:Class,
        watr:Process-MLE ;
    rdfs:label "Modified Ludzack-Ettinger (MLE)" ;
    rdfs:comment "Modification of AO with an internal recycle returning nitrate to the anoxic zone." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-AO ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    watr:includesProcess watr:Process-Recirculation .

watr:Process-MembraneDistillation a watr:Class,
        watr:Process-MembraneDistillation ;
    rdfs:label "Membrane Distillation (MD)" ;
    rdfs:comment "Separation driven by a vapour pressure difference across a hydrophobic membrane: water evaporates on the warm feed side, crosses the membrane as vapour, and condenses on the cool permeate side, while the liquid feed is held back." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-MembraneProcess .

watr:Process-MultipleHearthIncineration a watr:Class,
        watr:Process-MultipleHearthIncineration ;
    rdfs:label "Multiple Hearth Incineration (MHI)" ;
    rdfs:comment "A process that combusts biosolids as they move through a series of stacked hearths with controlled air flow." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Combustion ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal .

watr:Process-OsmoticallyAssistedReverseOsmosis a watr:Class,
        watr:Process-OsmoticallyAssistedReverseOsmosis ;
    rdfs:label "Osmotically Assisted Reverse Osmosis (OARO)" ;
    rdfs:comment "Reverse osmosis in which a saline sweep stream on the permeate side lowers the osmotic pressure difference across the membrane, so that a hypersaline feed can be concentrated further than the applied pressure would otherwise allow." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-Purging a watr:Class,
        watr:Process-Purging ;
    rdfs:label "Purging" ;
    rdfs:comment "A process that flushes retained liquid, solids, or gas from equipment or piping to restore operating conditions or prepare for another cycle." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Cleaning .

watr:Process-Reduction a watr:Class,
        watr:Process-Reduction ;
    rdfs:label "Chemical Reduction" ;
    rdfs:comment "Mechanism by which contaminants are transformed through the gain of electrons." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-Sedimentation a watr:Class,
        watr:Process-Sedimentation ;
    rdfs:label "Sedimentation (deprecated)" ;
    dcterms:isReplacedBy watr:Process-Settling ;
    rdfs:comment "Deprecated process designation; use Process-Settling." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Settling ;
    owl:deprecated true .

watr:Process-SlowSandFiltration a watr:Class,
        watr:Process-SlowSandFiltration ;
    rdfs:label "Slow Sand Filtration" ;
    rdfs:comment "A filtration process that uses a bed of sand to remove impurities at low flow rates." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-MediaFiltration .

watr:Process-SulfiteDosing a watr:Class,
        watr:Process-SulfiteDosing ;
    rdfs:label "Sulfite Dosing" ;
    rdfs:comment "Metered addition of sulfur dioxide, sodium sulfite, bisulfite or metabisulfite, which reduces free and combined chlorine to chloride." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Dosing ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-ChlorineResidualRemoval .

watr:Process-ThermalHydrolysis a watr:Class,
        watr:Process-ThermalHydrolysis ;
    rdfs:label "Thermal Hydrolysis" ;
    rdfs:comment "A process that breaks down complex organic matter into soluble compounds using heat and pressure." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Hydrolysis,
        watr:Process-ThermalTreatment .

watr:Process-UCT a watr:Class,
        watr:Process-UCT ;
    rdfs:label "University of Cape Town (UCT)" ;
    rdfs:comment "Variant of A2O with modified recycle streams for phosphorus removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-A2O ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval,
        watr:TreatmentObjective-PhosphorusRemoval .

watr:Process-UVDisinfection a watr:Class,
        watr:Process-UVDisinfection ;
    rdfs:label "UVDisinfection (deprecated)" ;
    dcterms:isReplacedBy watr:Process-UVIrradiation ;
    rdfs:comment "Deprecated process designation; use Process-UVIrradiation." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-UVIrradiation ;
    owl:deprecated true .

watr:Pump a sh:NodeShape,
        watr:Class ;
    rdfs:label "Pump" ;
    rdfs:comment "A device used to move fluids by mechanical action. Unlike s223:Pump, which asks for water, oil or refrigerant, it accepts any s223:Mix-Fluid, so it covers sludge and other slurries." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment ;
    sh:property [ rdfs:comment "The non-electrical connection points of a Pump must have compatible media." ;
            sh:path s223:hasConnectionPoint ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "A Pump's connection points {?cpa} and {?cpb} on {$this} have incompatible media {$mediuma} and {$mediumb}." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT $this ?cpa ?cpb ?mediuma ?mediumb
WHERE {
  $this s223:hasConnectionPoint ?cpa .
  $this s223:hasConnectionPoint ?cpb .
  FILTER (?cpa != ?cpb) .
  ?cpa s223:hasMedium ?mediuma .
  FILTER (NOT EXISTS {?mediuma a/rdfs:subClassOf* s223:Constituent-Electricity}) .
  ?cpb s223:hasMedium ?mediumb .
  FILTER (NOT EXISTS {?mediumb a/rdfs:subClassOf* s223:Constituent-Electricity}) .
  FILTER (?mediuma != ?mediumb) .
  FILTER (NOT EXISTS {?mediumb a/rdfs:subClassOf* ?mediuma}) .
  FILTER (NOT EXISTS {?mediuma a/rdfs:subClassOf* ?mediumb}) .
}
""" ] ],
        [ rdfs:comment "A Pump has at least one outlet carrying a fluid or refrigerant" ;
            sh:message "A Pump shall have at least one outlet using a Mix-Fluid (water, oil, sludge) or Constituent-Refrigerant medium." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:node [ sh:property [ sh:or ( [ sh:class s223:Mix-Fluid ] [ sh:class s223:Constituent-Refrigerant ] ) ;
                                    sh:path s223:hasMedium ] ] ] ;
            sh:severity sh:Warning ],
        [ rdfs:comment "A Pump has at least one inlet carrying a fluid or refrigerant" ;
            sh:message "A Pump shall have at least one inlet using a Mix-Fluid (water, oil, sludge) or Constituent-Refrigerant medium." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:InletConnectionPoint ;
                    sh:node [ sh:property [ sh:or ( [ sh:class s223:Mix-Fluid ] [ sh:class s223:Constituent-Refrigerant ] ) ;
                                    sh:path s223:hasMedium ] ] ] ;
            sh:severity sh:Warning ],
        [ sh:path s223:hasConnectionPoint ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "Workaround: {$this} has a connection point with medium {?medium}, which s223:Pump does not accept (water, oil or refrigerant). It is validated as a watr:Pump only and is not typed s223:Pump. This workaround can be removed if the S223 pump shape accepts any Mix-Fluid." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT DISTINCT $this ?medium
WHERE {
  FILTER NOT EXISTS {$this a s223:Pump} .
  $this s223:hasConnectionPoint ?cp .
  ?cp s223:hasMedium ?medium .
  FILTER (EXISTS {?cp a ?cptype . FILTER (?cptype IN (s223:InletConnectionPoint, s223:OutletConnectionPoint, s223:BidirectionalConnectionPoint))}) .
  FILTER (NOT EXISTS {?medium a/rdfs:subClassOf* s223:Fluid-Water}) .
  FILTER (NOT EXISTS {?medium a/rdfs:subClassOf* s223:Fluid-Oil}) .
  FILTER (NOT EXISTS {?medium a/rdfs:subClassOf* s223:Constituent-Refrigerant}) .
  FILTER (NOT EXISTS {?medium a/rdfs:subClassOf* s223:Constituent-Electricity}) .
}
""" ] ] ;
    sh:rule [ a sh:TripleRule ;
            sh:condition s223:Pump ;
            sh:object s223:Pump ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] .

watr:ReducingAgent a sh:NodeShape,
        watr:Class,
        watr:ReducingAgent ;
    rdfs:label "Reducing Agent" ;
    rdfs:comment "Class for reducing agents used in water treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Role-Backwash a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Backwash ;
    rdfs:label "Role-Backwash" ;
    dcterms:isReplacedBy watr:Process-Backwashing ;
    rdfs:comment "Deprecated. Model backwashing as watr:hasProcess watr:Process-Backwashing on the equipment or system that performs it." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
    owl:deprecated true .

watr:Role-Containment a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Containment ;
    rdfs:label "Containment" ;
    rdfs:comment "The equipment confines a spill or an off-specification stream to keep it out of the rest of the plant." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Detention a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Detention ;
    rdfs:label "Detention" ;
    rdfs:comment "The equipment holds flow for a designed interval, typically to allow a reaction or settling to complete." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Equalization a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Equalization ;
    rdfs:label "Equalization" ;
    rdfs:comment "The equipment buffers variation in flow or load so that the processes downstream of it see a steadier stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Extended a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Extended ;
    rdfs:label "Extended" ;
    rdfs:comment "The equipment is operated at an extended solids retention time." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Feed a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Feed ;
    rdfs:label "Feed" ;
    rdfs:comment "A connection point that admits the stream a process acts on." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-MakeUp a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-MakeUp ;
    rdfs:label "Role-MakeUp" ;
    rdfs:comment "A connection point that admits water to replace what a process consumes or loses." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Permeate a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Permeate ;
    rdfs:label "Permeate" ;
    rdfs:comment "A connection point carrying the stream that has passed through a membrane." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Posttreatment a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Posttreatment ;
    rdfs:label "Posttreatment" ;
    rdfs:comment "The equipment sits after the main treatment train and conditions the effluent for discharge or reuse." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Pretreatment a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Pretreatment ;
    rdfs:label "Pretreatment" ;
    rdfs:comment "The equipment sits ahead of the main treatment train and conditions the influent for it." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Primary a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Primary ;
    rdfs:label "Primary" ;
    rdfs:comment "Primary treatment: the equipment belongs to the stage that removes settleable and floatable solids ahead of biological treatment. Not to be confused with s223:Role-Primary, which denotes a primary loop." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Retention a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Retention ;
    rdfs:label "Retention" ;
    rdfs:comment "The equipment holds flow to attenuate a peak, typically stormwater, and releases it at a controlled rate." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Secondary a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Secondary ;
    rdfs:label "Secondary" ;
    rdfs:comment "Secondary treatment: the equipment belongs to the stage that removes biodegradable organics and suspended solids, typically biologically. Not to be confused with s223:Role-Secondary, which denotes a secondary loop." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Stepfeed a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Stepfeed ;
    rdfs:label "Stepfeed" ;
    rdfs:comment "The equipment is fed at multiple points along its length rather than only at its head." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Storage a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Storage ;
    rdfs:label "Storage" ;
    rdfs:comment "The equipment holds water or sludge for later use rather than acting on it." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Tertiary a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Tertiary ;
    rdfs:label "Tertiary" ;
    rdfs:comment "Tertiary treatment: the equipment belongs to the polishing stage downstream of secondary treatment, for residual solids, nutrients or specific constituents." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:SepticTank a sh:NodeShape,
        watr:Class ;
    rdfs:label "Septic Tank" ;
    rdfs:comment "A septic tank for on-site wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:SedimentationTank .

watr:Sludge-MixedLiquor a sh:NodeShape,
        watr:Class,
        watr:Sludge-MixedLiquor ;
    rdfs:label "Sludge-MixedLiquor" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Suspended Solids Fraction" ;
            s223:ofConstituent watr:Constituent-SuspendedSolids ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Water Fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Mixed liquor is the mixture of wastewater and activated sludge in the aeration basin of a wastewater treatment plant. It contains suspended solids and water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Fluid-Sludge .

watr:Synchronization-Downsampling a sh:NodeShape,
        watr:Class,
        watr:Synchronization-Downsampling ;
    rdfs:label "Downsampling" ;
    rdfs:comment "Decrease the sampling frequency of data to a lower rate" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-Synchronization .

watr:Synchronization-Resampling a sh:NodeShape,
        watr:Class,
        watr:Synchronization-Resampling ;
    rdfs:label "Resampling" ;
    rdfs:comment "Resample data to a different frequency or time interval" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-Synchronization .

watr:Synchronization-TimeAlignment a sh:NodeShape,
        watr:Class,
        watr:Synchronization-TimeAlignment ;
    rdfs:label "Time Alignment" ;
    rdfs:comment "Align data points from different sources to common timestamps" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-Synchronization .

watr:Synchronization-Upsampling a sh:NodeShape,
        watr:Class,
        watr:Synchronization-Upsampling ;
    rdfs:label "Upsampling" ;
    rdfs:comment "Increase the sampling frequency of data to a higher rate" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:DataProcessing-Synchronization .

watr:TreatmentObjective-ArsenicRemoval a watr:Class,
        watr:TreatmentObjective-ArsenicRemoval ;
    rdfs:label "Arsenic Removal" ;
    rdfs:comment "Reduction of arsenic species in the treated stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Arsenic .

watr:TreatmentObjective-Desalination a watr:Class,
        watr:TreatmentObjective-Desalination ;
    rdfs:label "Desalination" ;
    rdfs:comment "Reduction of the dissolved salt content of the treated stream, whether by a membrane, an electrical or a thermal process." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Salt .

watr:TreatmentObjective-LeadRemoval a watr:Class,
        watr:TreatmentObjective-LeadRemoval ;
    rdfs:label "Lead Removal" ;
    rdfs:comment "Reduction of lead in the treated stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-MetalsRemoval ;
    watr:targetsConstituent watr:Constituent-Lead .

watr:TreatmentObjective-ResourceRecovery a watr:Class,
        watr:TreatmentObjective-ResourceRecovery ;
    rdfs:label "Resource Recovery" ;
    rdfs:comment "Recovery of a usable product -- water, energy or nutrients -- from a stream that would otherwise be discharged. A placeholder: the specific recovery objectives are not yet modeled." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:TreatmentObjective-SilicaRemoval a watr:Class,
        watr:TreatmentObjective-SilicaRemoval ;
    rdfs:label "Silica Removal" ;
    rdfs:comment "Reduction of the dissolved silica content of the treated stream, generally to protect downstream membranes from silica scaling." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Silica .

watr:TreatmentObjective-SolidsRemoval a watr:Class,
        watr:TreatmentObjective-SolidsRemoval ;
    rdfs:label "Solids Removal (deprecated)" ;
    dcterms:isReplacedBy watr:TreatmentObjective-SuspendedSolidsRemoval ;
    rdfs:comment "Deprecated. Use TreatmentObjective-SuspendedSolidsRemoval for removal of suspended or settleable solids. This legacy term does not include dissolved solids removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-SuspendedSolidsRemoval ;
    owl:deprecated true ;
    watr:targetsConstituent watr:Constituent-SuspendedSolids .

watr:TreatmentObjective-SulfateRemoval a watr:Class,
        watr:TreatmentObjective-SulfateRemoval ;
    rdfs:label "Sulfate Removal" ;
    rdfs:comment "Reduction of the dissolved sulfate content of the treated stream, as in acid mine drainage treatment where it is precipitated as gypsum or ettringite." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Sulfate .

watr:TreatmentObjective-TurbidityRemoval a watr:Class,
        watr:TreatmentObjective-TurbidityRemoval ;
    rdfs:label "Turbidity Removal" ;
    rdfs:comment "Reduction of the turbidity of the treated stream, the objective of polishing filtration." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-SuspendedSolidsRemoval .

watr:TreatmentObjectiveRequiresProcessProperty a sh:PropertyShape ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:message "watr:hasTreatmentObjective says what the equipment is for, so the process it does to get there must be stated with watr:hasProcess as well." ;
    sh:minCount 1 ;
    sh:path watr:hasProcess .

watr:Water-Brackish a sh:NodeShape,
        watr:Class,
        watr:Water-Brackish ;
    rdfs:label "Water-Brackish" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Water fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Salt fraction" ;
            s223:ofConstituent watr:Salt-NaCl ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Moderately saline water (typical salinity 0.5-3%) modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Fluid-Water .

watr:Water-Brine a sh:NodeShape,
        watr:Class,
        watr:Water-Brine ;
    rdfs:label "Water-Brine" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Water fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Salt fraction" ;
            s223:ofConstituent watr:Salt-NaCl ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Concentrated saline water modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Fluid-Water .

watr:Water-Freshwater a sh:NodeShape,
        watr:Class,
        watr:Water-Freshwater ;
    rdfs:label "Water-Freshwater" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Water fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Low-salinity surface or ground water modeled as a constituent-bearing mixture dominated by the water constituent so that S223 can recognize the shared water constituent across aqueous media." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Fluid-Water .

watr:Water-Seawater a sh:NodeShape,
        watr:Class,
        watr:Water-Seawater ;
    rdfs:label "Water-Seawater" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Salt fraction" ;
            s223:ofConstituent watr:Salt-NaCl ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Water fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Saline surface water (typical salinity ~3.5%) modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Fluid-Water .

watr:hasAccuracy a rdf:Property ;
    rdfs:label "has accuracy" ;
    rdfs:comment "The `hasAccuracy` relation is used to link to a numerical `Property` whose value indicates the maximum expected deviation between the measured value and the true value in engineering units." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasAggregation a rdf:Property ;
    rdfs:label "has aggregation" ;
    rdfs:comment "The `hasAggregation` relation associates a property with water-specific aggregation semantics such as total, mean, maximum, or minimum." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasBias a rdf:Property ;
    rdfs:label "has bias" ;
    rdfs:comment "The `hasBias` relation is used to link to a numerical `Property` whose value indicates the systematic offset or drift in measurements relative to the true value." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasCalibrationCurve a rdf:Property ;
    rdfs:label "has calibration curve" ;
    rdfs:comment "The `hasCalibrationCurve` relation is used to link to a `Property` that describes the mathematical relationship or lookup table between raw sensor output and calibrated engineering units." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasDropRate a rdf:Property ;
    rdfs:label "has drop rate" ;
    rdfs:comment "The `hasDropRate` relation is used to link to a `Property` describes the amount of data points lost within a range of time due to latencies or other factors." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasNumericRange a rdf:Property ;
    rdfs:label "has numeric range" ;
    rdfs:comment "The `hasNumericRange` relation is used to link to a numerical `Property` whose value indicates the span between the minimum and maximum measurable values in engineering units." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasNumericResolution a rdf:Property ;
    rdfs:label "has numeric resolution" ;
    rdfs:comment "The `hasNumericResolution` relation is used to link to a numerical `Property` whose value indicates the smallest distinguishable difference between two measured values in engineering units." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasPrecision a rdf:Property ;
    rdfs:label "has precision" ;
    rdfs:comment "The `hasPrecision` relation is used to link to a numerical `Property` whose value indicates the repeatability or reproducibility of measurements under identical conditions." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasProcessedData a rdf:Property ;
    rdfs:label "has processed data" ;
    rdfs:comment "The `hasProcessedData` relation is used to link to a `Property` that describes any data processing, filtering, or transformation applied to the raw measurement values." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasResponseTime a rdf:Property ;
    rdfs:label "has response time" ;
    rdfs:comment "The `hasResponseTime` relation is used to link to a numerical `Property` whose value indicates the time required for the sensor or measurement system to respond to a step change in the measured variable." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasTemporalRange a rdf:Property ;
    rdfs:label "has temporal range" ;
    rdfs:comment "The `hasTemporalRange` relation is used to link to a numerical `Property` whose value indicates the start and end times for which data has been recorded." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasTemporalResolution a rdf:Property ;
    rdfs:label "has temporal resolution" ;
    rdfs:comment "The `hasTemporalResolution` relation is used to link to a numerical `Property` whose value indicates the minimum time interval between successive measurements or data points." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:hasVariableRange a rdf:Property ;
    rdfs:label "has variable range" ;
    rdfs:comment "The `hasVariableRange` relation is used to link to a numerical `Property` whose value indicates the expected range of variation for the measured variable under normal operating conditions." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:pHAdjuster-Lime a sh:NodeShape,
        watr:Class,
        watr:pHAdjuster-Lime ;
    rdfs:label "Lime" ;
    rdfs:comment "Calcium hydroxide (lime), used to increase pH" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:pHAdjuster .

watr:pHAdjuster-SulfuricAcid a sh:NodeShape,
        watr:Class,
        watr:pHAdjuster-SulfuricAcid ;
    rdfs:label "Sulfuric Acid" ;
    rdfs:comment "Sulfuric acid, used to decrease pH" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:pHAdjuster .

watr:targetsConstituent a rdf:Property ;
    rdfs:label "targets constituent" ;
    rdfs:comment "Relates a treatment objective to the constituent it removes, converts or controls. An explicit target takes precedence over ancestor targets; without one, use the nearest declaring ancestor on each inheritance branch. See the constituent query in docs/guides/querying_treatment_function.md." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

s223:Filter rdfs:subClassOf watr:Filter .

s223:Pump rdfs:subClassOf watr:Pump .

watr:ConcentrationSensor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Concentration Sensor" ;
    rdfs:comment "A sensor used to measure the concentration of specific substances (e.g., Total Dissolved Solids)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:ConcentrationSensor .

watr:Constituent-Ammonia a sh:NodeShape,
        watr:Class,
        watr:Constituent-Ammonia ;
    rdfs:label "Ammonia" ;
    rdfs:comment "Ammonia present as a dissolved nitrogen-bearing constituent of a treatment medium." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Nitrogen .

watr:Constituent-Arsenic a sh:NodeShape,
        watr:Class,
        watr:Constituent-Arsenic ;
    rdfs:label "Arsenic" ;
    rdfs:comment "Arsenic species in water, including dissolved arsenite and arsenate." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:Constituent-ChlorineResidual a sh:NodeShape,
        watr:Class,
        watr:Constituent-ChlorineResidual ;
    rdfs:label "Chlorine Residual" ;
    rdfs:comment "Chlorine remaining in the water after disinfection, free or combined. Wanted in a distribution system and unwanted in a discharge, which is why removing it is an objective of its own." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:Constituent-Hardness a sh:NodeShape,
        watr:Class,
        watr:Constituent-Hardness ;
    rdfs:label "Hardness" ;
    rdfs:comment "Calcium and magnesium dissolved in a treatment medium, taken together as one constituent because that is what a hardness measurement reports and what softening removes." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:Constituent-InorganicSolids a sh:NodeShape,
        watr:Class,
        watr:Constituent-InorganicSolids ;
    rdfs:label "Constituent-InorganicSolids" ;
    rdfs:comment "The inorganic fraction of the solids in a treatment medium, such as grit, sand and mineral precipitates." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Solids .

watr:Constituent-Lead a sh:NodeShape,
        watr:Class,
        watr:Constituent-Lead ;
    rdfs:label "Lead" ;
    rdfs:comment "Lead species in water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Metals .

watr:Constituent-OrganicSolids a sh:NodeShape,
        watr:Class,
        watr:Constituent-OrganicSolids ;
    rdfs:label "Constituent-OrganicSolids" ;
    rdfs:comment "The organic fraction of the solids in a treatment medium, such as biomass and other biodegradable matter." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Solids .

watr:Constituent-Particles a sh:NodeShape,
        watr:Class,
        watr:Constituent-Particles ;
    rdfs:label "Particles" ;
    rdfs:comment "Particulate matter present as a constituent of a medium." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:Constituent-Silica a sh:NodeShape,
        watr:Class,
        watr:Constituent-Silica ;
    rdfs:label "Silica" ;
    rdfs:comment "Silica present as a constituent of a treatment medium, dissolved or colloidal. A scalant on membranes and in evaporators." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:Constituent-Sulfate a sh:NodeShape,
        watr:Class,
        watr:Constituent-Sulfate ;
    rdfs:label "Sulfate" ;
    rdfs:comment "Sulfate present as a dissolved constituent of a treatment medium." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:DewateringUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Dewatering Unit" ;
    rdfs:comment "A unit used to remove water from solid material" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of DewateringUnit must have the Dewatering treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-Dewatering ] ] .

watr:Digester a sh:NodeShape,
        watr:Class ;
    rdfs:label "Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Digester must have at least one Digestion process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Digestion ] ],
        [ sh:message "Instances of Digester must have the Stabilization treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-Stabilization ] ] .

watr:DisinfectionUnit a sh:NodeShape,
        watr:Class ;
    rdfs:label "Disinfection Unit" ;
    rdfs:comment "A unit used to eliminate or reduce harmful microorganisms" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [ sh:message "Instances of DisinfectionUnit must have the Disinfection treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-Disinfection ] ] .

watr:Electrode a sh:NodeShape,
        watr:Class ;
    rdfs:label "Electrode" ;
    rdfs:comment "A component where electrochemical reactions occur in electrified processes." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:FilterLiquidConnectionPointShape a sh:NodeShape ;
    rdfs:comment "A connection point whose medium is neither air nor electricity." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:property [ sh:minCount 1 ;
            sh:not [ sh:class s223:Fluid-Air ],
                [ sh:class s223:Constituent-Electricity ] ;
            sh:path s223:hasMedium ] .

watr:Flocculant a sh:NodeShape,
        watr:Class,
        watr:Flocculant ;
    rdfs:label "Flocculant" ;
    rdfs:comment "Class for flocculants used in wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Flocculant-Polymer a sh:NodeShape,
        watr:Class,
        watr:Flocculant-Polymer ;
    rdfs:label "Polymer Flocculant" ;
    rdfs:comment "Flocculant that is a type of polymer" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Flocculant .

watr:HeatExchanger a sh:NodeShape,
        watr:Class ;
    rdfs:label "Heat Exchanger" ;
    rdfs:comment "Equipment that transfers heat between media, such as an evaporator or a condenser. Unlike s223:HydronicHeatExchanger, it places no constraint on the number, pairing or phase of its connection points, so it covers single-feed evaporators and air-cooled condensers." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment .

watr:HeavyMetalRemovalAgent a sh:NodeShape,
        watr:Class,
        watr:HeavyMetalRemovalAgent ;
    rdfs:label "Heavy Metal Removal Agent" ;
    rdfs:comment "Class for chemicals used to remove heavy metals" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:LiquidSludgeOutletShape a sh:NodeShape ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:property [ sh:message "A clarifier or gravity thickener must have a liquid outlet carrying water." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:property [ sh:class s223:Fluid-Water ;
                            sh:minCount 1 ;
                            sh:path s223:hasMedium ] ] ],
        [ sh:message "A clarifier or gravity thickener must have a separate sludge outlet." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:property [ sh:class watr:Fluid-Sludge ;
                            sh:minCount 1 ;
                            sh:path s223:hasMedium ] ] ] .

watr:OdorControlAgent a sh:NodeShape,
        watr:Class,
        watr:OdorControlAgent ;
    rdfs:label "Odor Control Agent" ;
    rdfs:comment "Class for chemicals used for odor control" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:OxidizingAgent a sh:NodeShape,
        watr:Class,
        watr:OxidizingAgent ;
    rdfs:label "Oxidizing Agent" ;
    rdfs:comment "Class for oxidizing agents used in water treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Process-A2O a watr:Class,
        watr:Process-A2O ;
    rdfs:label "Anaerobic-Anoxic-Oxic (A2O)" ;
    rdfs:comment "Anaerobic-anoxic-aerobic process for simultaneous biological nitrogen and phosphorus removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ActivatedSludge ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval,
        watr:TreatmentObjective-PhosphorusRemoval ;
    watr:includesProcess watr:Process-Denitrification,
        watr:Process-EnhancedBiologicalPhosphorusRemoval,
        watr:Process-Nitrification,
        watr:Process-Recirculation .

watr:Process-AO a watr:Class,
        watr:Process-AO ;
    rdfs:label "Anoxic-Aerobic" ;
    rdfs:comment "Two-stage process with anoxic zone followed by aerobic zone for biological nitrogen removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ActivatedSludge ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    watr:includesProcess watr:Process-Denitrification,
        watr:Process-Nitrification .

watr:Process-Adsorption a watr:Class,
        watr:Process-Adsorption ;
    rdfs:label "Adsorption" ;
    rdfs:comment "A process by which substances bind to a surface." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-ConstituentRemoval .

watr:Process-AdvancedOxidation a watr:Class,
        watr:Process-AdvancedOxidation ;
    rdfs:label "Advanced Oxidation Process (AOP)" ;
    rdfs:comment "Processes combining UV light with oxidants (e.g., UV-AOP) to destroy contaminants." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Oxidation .

watr:Process-AerobicDigestion a watr:Class,
        watr:Process-AerobicDigestion ;
    rdfs:label "Aerobic Digestion" ;
    rdfs:comment "A biological process that breaks down organic matter in the presence of oxygen." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Digestion .

watr:Process-AnaerobicDigestion a watr:Class,
        watr:Process-AnaerobicDigestion ;
    rdfs:label "Anaerobic Digestion" ;
    rdfs:comment "A biological process that breaks down organic matter in the absence of oxygen." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Digestion .

watr:Process-Backwashing a watr:Class,
        watr:Process-Backwashing ;
    rdfs:label "Backwashing" ;
    rdfs:comment "A cleaning process in which water, and sometimes air, is driven backward through a filter or membrane system to remove accumulated solids." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Cleaning .

watr:Process-BiologicallyActiveFiltration a watr:Class,
        watr:Process-BiologicallyActiveFiltration ;
    rdfs:label "Biologically Active Filtration (BAF)" ;
    rdfs:comment "A biologically activated filtration column." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Biofiltration .

watr:Process-Cogeneration a watr:Class,
        watr:Process-Cogeneration ;
    rdfs:label "Cogeneration" ;
    rdfs:comment "A process that combusts biosolids or biogas to produce electricity and heat simultaneously." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Combustion .

watr:Process-Comminution a watr:Class,
        watr:Process-Comminution ;
    rdfs:label "Comminution" ;
    rdfs:comment "Process of reducing solid materials into smaller particles through mechanical forces such as crushing, grinding, impact, shear, or compression." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Condensation a watr:Class,
        watr:Process-Condensation ;
    rdfs:label "Condensation" ;
    rdfs:comment "A process of turning a vapor into a liquid." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Electrocoagulation a watr:Class,
        watr:Process-Electrocoagulation ;
    rdfs:label "Electrocoagulation (EC)" ;
    rdfs:comment "An electrified pretreatment technology using sacrificial anodes to release coagulant precursors for contaminant removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Coagulation,
        watr:Process-PhysicalProcess .

watr:Process-Electrolysis a watr:Class,
        watr:Process-Electrolysis ;
    rdfs:label "Electrolysis" ;
    rdfs:comment "A process that uses a direct electric current to drive an otherwise non-spontaneous chemical reaction." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-Evaporation a watr:Class,
        watr:Process-Evaporation ;
    rdfs:label "Evaporation" ;
    rdfs:comment "A process of turning a liquid into a vapor." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Flocculation a watr:Class,
        watr:Process-Flocculation ;
    rdfs:label "Flocculation" ;
    rdfs:comment "A unit process that gently mixes water to allow coagulated particles to form larger clumps." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-Mixing .

watr:Process-Flotation a watr:Class,
        watr:Process-Flotation ;
    rdfs:label "Flotation" ;
    rdfs:comment "A unit process that uses buoyancy to separate solids from water, often using air bubbles." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation .

watr:Process-GasTransfer a watr:Class,
        watr:Process-GasTransfer ;
    rdfs:label "Gas Transfer" ;
    rdfs:comment "A unit process that transfers gases, such as oxygen or carbon dioxide, into or out of water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Hydrolysis a watr:Class,
        watr:Process-Hydrolysis ;
    rdfs:label "Hydrolysis" ;
    rdfs:comment "A process reaction in which a water molecule is consumed to split a larger molecule into smaller fragments." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-IonExchange a watr:Class,
        watr:Process-IonExchange ;
    rdfs:label "Ion Exchange" ;
    rdfs:comment "A process in which ions are exchanged between a solution and an ion-exchange resin or membrane." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-ConstituentRemoval .

watr:Process-Landfilling a watr:Class,
        watr:Process-Landfilling ;
    rdfs:label "Landfilling" ;
    rdfs:comment "Placing treated biosolids in a landfill, whether in a dedicated cell or with municipal solid waste." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal .

watr:Process-Ozonation a watr:Class,
        watr:Process-Ozonation ;
    rdfs:label "Ozonation" ;
    rdfs:comment "A water treatment process that uses ozone as an oxidant. The process alone does not establish whether the intended treatment objective is disinfection, oxidation of a contaminant, or taste-and-odour control." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Oxidation .

watr:Process-RapidSandFiltration a watr:Class,
        watr:Process-RapidSandFiltration ;
    rdfs:label "Rapid Sand Filtration" ;
    rdfs:comment "A filtration process that uses a bed of sand to remove impurities at high flow rates." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-MediaFiltration .

watr:Process-Screening a watr:Class,
        watr:Process-Screening ;
    rdfs:label "Screening" ;
    rdfs:comment "A unit process that removes large solids from water, such as leaves, branches, and other debris." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-Solidification a watr:Class,
        watr:Process-Solidification ;
    rdfs:label "Solidification" ;
    rdfs:comment "A process of turning a liquid into a solid (e.g., freezing)." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-SolventExtraction a watr:Class,
        watr:Process-SolventExtraction ;
    rdfs:label "Solvent-Based Extraction" ;
    rdfs:comment "A non-membrane, non-thermal method using a solvent to selectively extract water from highly saline brines." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-Separation .

watr:Process-Stripping a watr:Class,
        watr:Process-Stripping ;
    rdfs:label "Stripping" ;
    rdfs:comment "Gas stripping for removal of dissolved gases such as ammonia and volatile organic compounds." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-TricklingFiltration a watr:Class,
        watr:Process-TricklingFiltration ;
    rdfs:label "TricklingFiltration" ;
    rdfs:comment "Trickling filter using any media (e.g., plastic, sand, gravel, etc.)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Biofiltration .

watr:Role-Aerobic a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Aerobic ;
    rdfs:label "Aerobic" ;
    rdfs:comment "The zone is commissioned to run in an aerobic regime, with dissolved oxygen present. A design claim, not a reading: a basin whose blowers are off still carries it." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Anaerobic a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Anaerobic ;
    rdfs:label "Anaerobic" ;
    rdfs:comment "The zone is commissioned to run in an anaerobic regime, without dissolved oxygen or nitrate." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Overflow a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Overflow ;
    rdfs:label "Role-Overflow" ;
    rdfs:comment "A connection point that discharges liquid above a tank's working level." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Role-Discharge .

watr:SedimentationTank a sh:NodeShape,
        watr:Class ;
    rdfs:label "Sedimentation Tank" ;
    rdfs:comment "A tank in which suspended solids separate from water by settling under gravity" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:SeparationTank ;
    sh:property [ sh:message "Instances of SedimentationTank must have a Settling process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Settling ] ] .

watr:Tank a sh:NodeShape,
        watr:Class ;
    rdfs:label "Tank" ;
    rdfs:comment "A vessel with at least one fluid connection point. A storage tank may use a single bidirectional port; flow-through subclasses require the appropriate inlet and outlet points." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment ;
    sh:property [ rdfs:comment "A tank's drain connection point, if it has one, is a fluid outlet" ;
            sh:message "A drain connection point on a Tank must be an outlet carrying a fluid." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:class s223:OutletConnectionPoint ;
                            sh:property [ sh:class s223:Mix-Fluid ;
                                    sh:minCount 1 ;
                                    sh:path s223:hasMedium ] ] ;
                    sh:property [ sh:hasValue watr:Role-Drain ;
                            sh:minCount 1 ;
                            sh:path s223:hasRole ] ] ],
        [ sh:message "A Tank must have at least one fluid connection point; a bidirectional port is sufficient." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:ConnectionPoint ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:minCount 1 ;
                            sh:path s223:hasMedium ] ] ],
        [ rdfs:comment "A tank's overflow connection point, if it has one, is a fluid outlet" ;
            sh:message "An overflow connection point on a Tank must be an outlet carrying a fluid." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:class s223:OutletConnectionPoint ;
                            sh:property [ sh:class s223:Mix-Fluid ;
                                    sh:minCount 1 ;
                                    sh:path s223:hasMedium ] ] ;
                    sh:property [ sh:hasValue watr:Role-Overflow ;
                            sh:minCount 1 ;
                            sh:path s223:hasRole ] ] ] .

watr:TreatmentObjective-AmmoniaControl a watr:Class,
        watr:TreatmentObjective-AmmoniaControl ;
    rdfs:label "Ammonia Control" ;
    rdfs:comment "Reduction or conversion of ammonia in the treated stream, typically by nitrification. Distinct from nitrogen removal, which requires nitrogen to leave the water altogether; nitrification converts ammonia to nitrate and removes no nitrogen." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    skos:altLabel "Ammonia Removal" ;
    watr:targetsConstituent watr:Constituent-Ammonia .

watr:TreatmentObjective-Clarification a watr:Class,
        watr:TreatmentObjective-Clarification ;
    rdfs:label "Clarification" ;
    rdfs:comment "Production of a clarified liquid stream by removing suspended solids from it. The objective of every clarifier, whatever the stage it serves and whatever mechanism it separates by." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-SuspendedSolidsRemoval .

watr:TreatmentObjective-Drying a watr:Class,
        watr:TreatmentObjective-Drying ;
    rdfs:label "Drying" ;
    rdfs:comment "Removing water from biosolids beyond the cake stage, to a dry product." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-Dewatering .

watr:TreatmentObjective-EquipmentCleaning a watr:Class,
        watr:TreatmentObjective-EquipmentCleaning ;
    rdfs:label "Equipment Cleaning" ;
    rdfs:comment "Removal of accumulated foulants or residual materials from equipment to maintain or restore operation. Distinct from removing a constituent from the treated product stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:TreatmentObjective-MetalsRemoval a watr:Class,
        watr:TreatmentObjective-MetalsRemoval ;
    rdfs:label "Metals Removal" ;
    rdfs:comment "Removal of dissolved metals from the treated stream, typically by raising pH or dosing sulfide so that they precipitate as hydroxides or sulfides and are then separated out." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Metals .

watr:TreatmentObjective-Softening a watr:Class,
        watr:TreatmentObjective-Softening ;
    rdfs:label "Softening" ;
    rdfs:comment "Reduction of hardness by removing calcium and magnesium from the treated stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-DissolvedSolidsRemoval ;
    watr:targetsConstituent watr:Constituent-Hardness .

watr:hasMeasurementRange a rdf:Property ;
    rdfs:label "has measurement range" ;
    rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the expected range of variation that can physically be measured, e.g. by a sensor." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:Constituent-Metals a sh:NodeShape,
        watr:Class,
        watr:Constituent-Metals ;
    rdfs:label "Metals" ;
    rdfs:comment "Metal species present as constituents of a treatment medium, dissolved or complexed." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:Constituent-Salt a sh:NodeShape,
        watr:Class,
        watr:Constituent-Salt ;
    rdfs:label "Salt" ;
    rdfs:comment "Dissolved inorganic salt present as a constituent of a treatment medium. The constituent desalination removes." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-DissolvedSolids .

watr:Disinfectant a sh:NodeShape,
        watr:Class,
        watr:Disinfectant ;
    rdfs:label "Disinfectant" ;
    rdfs:comment "Class for disinfectants used in wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Process-Centrifugation a watr:Class,
        watr:Process-Centrifugation ;
    rdfs:label "Centrifugation" ;
    rdfs:comment "A process that uses centrifugal force to separate substances of different densities." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation .

watr:Process-Chlorination a watr:Class,
        watr:Process-Chlorination ;
    rdfs:label "Chlorination" ;
    rdfs:comment "Dosing chlorine or a chlorine compound into water with contact time designed for disinfection. The intended objective is disinfection; actual performance depends on dose, contact time and water quality." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Dosing ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Disinfection .

watr:Process-Coagulation a watr:Class,
        watr:Process-Coagulation ;
    rdfs:label "Coagulation" ;
    rdfs:comment "A unit process that adds chemicals to water to cause small particles to clump together." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Dosing .

watr:Process-EnhancedBiologicalPhosphorusRemoval a watr:Class,
        watr:Process-EnhancedBiologicalPhosphorusRemoval ;
    rdfs:label "Enhanced Biological Phosphorus Removal (EBPR)" ;
    rdfs:comment "Uptake of phosphorus into biomass beyond ordinary metabolic requirements, achieved by cycling the biomass through anaerobic and aerobic conditions." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-PhosphorusRemoval .

watr:Process-Microfiltration a watr:Class,
        watr:Process-Microfiltration ;
    rdfs:label "Microfiltration" ;
    rdfs:comment "Membrane filtration at a pore size of roughly 0.1 to 1 micron, retaining suspended solids, bacteria and larger colloids. The pore-size range characterizes the method; a model states its intended treatment objective separately." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Filtration,
        watr:Process-MembraneProcess,
        watr:Process-SolidLiquidSeparation .

watr:Process-ThermalTreatment a watr:Class,
        watr:Process-ThermalTreatment ;
    rdfs:label "Thermal Treatment" ;
    rdfs:comment "Heating of water or biosolids, as in pasteurization. The process alone does not establish whether the intended treatment objective is disinfection, drying, hydrolysis, or another thermal result." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Ultrafiltration a watr:Class,
        watr:Process-Ultrafiltration ;
    rdfs:label "Ultrafiltration" ;
    rdfs:comment "Membrane filtration at a pore size of roughly 0.01 to 0.1 micron, retaining colloids and macromolecules as well as the suspended solids microfiltration retains. The pore-size range characterizes the method; a model states its intended treatment objective separately." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Filtration,
        watr:Process-MembraneProcess,
        watr:Process-SolidLiquidSeparation .

watr:Role-Anoxic a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Anoxic ;
    rdfs:label "Anoxic" ;
    rdfs:comment "The zone is commissioned to run in an anoxic regime, without dissolved oxygen and with nitrate present." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Role .

watr:Role-Drain a s223:EnumerationKind-Role,
        sh:NodeShape,
        watr:Class,
        watr:Role-Drain ;
    rdfs:label "Role-Drain" ;
    rdfs:comment "A connection point that empties a vessel below its working level, for maintenance or solids removal." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Role-Discharge .

watr:TreatmentObjective-ChlorineResidualRemoval a watr:Class,
        watr:TreatmentObjective-ChlorineResidualRemoval ;
    rdfs:label "Chlorine Residual Removal" ;
    rdfs:comment "Removal of the free and combined chlorine residual left by disinfection, before discharge or before a downstream process that the residual would damage." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    skos:altLabel "Dechlorination" ;
    watr:targetsConstituent watr:Constituent-ChlorineResidual .

watr:TreatmentObjective-Neutralization a watr:Class,
        watr:TreatmentObjective-Neutralization ;
    rdfs:label "Neutralization" ;
    rdfs:comment "pH adjustment to neutral, typically with a base, as in high-density sludge treatment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-pHControl .

watr:TreatmentObjective-Thickening a watr:Class,
        watr:TreatmentObjective-Thickening ;
    rdfs:label "Thickening" ;
    rdfs:comment "Raising the solids concentration of a sludge or slurry while it remains pumpable. Distinguished from dewatering by the state of the product." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-VolumeReduction .

watr:TreatmentObjective-pHControl a watr:Class,
        watr:TreatmentObjective-pHControl ;
    rdfs:label "pH Control" ;
    rdfs:comment "Bringing the pH of the treated stream to a target value, or holding it there." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective ;
    skos:altLabel "pH Adjustment" .

watr:pHAdjuster a sh:NodeShape,
        watr:Class,
        watr:pHAdjuster ;
    rdfs:label "pH Adjuster" ;
    rdfs:comment "Class for pH adjusters used in wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Coagulant a sh:NodeShape,
        watr:Class,
        watr:Coagulant ;
    rdfs:label "Coagulant" ;
    rdfs:comment "Class for coagulants used in wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:WastewaterTreatmentChemical .

watr:Constituent-Phosphorus a sh:NodeShape,
        watr:Class,
        watr:Constituent-Phosphorus ;
    rdfs:label "Phosphorus" ;
    rdfs:comment "Phosphorus present as a constituent of a treatment medium in any form, the constituent a total phosphorus limit is written against." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:Constituent-Solids a sh:NodeShape,
        watr:Class,
        watr:Constituent-Solids ;
    rdfs:label "Solids" ;
    rdfs:comment "Solid material present as a constituent of a treatment medium." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Particles .

watr:Constituent-SuspendedSolids a sh:NodeShape,
        watr:Class,
        watr:Constituent-SuspendedSolids ;
    rdfs:label "Suspended Solids" ;
    rdfs:comment "Solid particulate matter suspended in water rather than dissolved, including organic and inorganic material carried in the fluid." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Solids .

watr:DataProcessing-Normalization a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-Normalization ;
    rdfs:label "Normalization" ;
    rdfs:comment "Parent class for normalization methods to scale data to a standard range" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:Fluid-Sludge a sh:NodeShape,
        watr:Class,
        watr:Fluid-Sludge ;
    rdfs:label "Sludge" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Organic solids fraction" ;
            s223:ofConstituent watr:Constituent-OrganicSolids ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Inorganic solids fraction" ;
            s223:ofConstituent watr:Constituent-InorganicSolids ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:QuantifiableProperty ;
            rdfs:label "Water fraction" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:MassFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "A semi-solid slurry of water, organic solids and inorganic solids, modeled as a constituent-bearing mixture rather than a kind of water. Sharing s223:Constituent-H2O with the aqueous media keeps sludge compatible with them on S223 connection points in both directions, for example water in and sludge out of a clarifier, or sludge in and supernatant out of a thickener." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Mix-Fluid .

watr:Process-Aeration a watr:Class,
        watr:Process-Aeration ;
    rdfs:label "Aeration" ;
    rdfs:comment "A unit process that aerates (i.e., transfers oxygen into water)." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-GasTransfer .

watr:Process-Cleaning a watr:Class,
        watr:Process-Cleaning ;
    rdfs:label "Cleaning" ;
    rdfs:comment "A maintenance-oriented process that removes accumulated solids, foulants, or residual materials from water treatment equipment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-EquipmentCleaning .

watr:Process-Crystallization a watr:Class,
        watr:Process-Crystallization ;
    rdfs:label "Crystallization" ;
    rdfs:comment "A process of forming solid crystals from a solution." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Solidification .

watr:Process-Digestion a watr:Class,
        watr:Process-Digestion ;
    rdfs:label "Digestion" ;
    rdfs:comment "A biological process that breaks down organic matter over a long duration in a tank." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Stabilization .

watr:Process-Electrodialysis a watr:Class,
        watr:Process-Electrodialysis ;
    rdfs:label "Electrodialysis" ;
    rdfs:comment "A process that uses ion-exchange membranes and an electric potential to separate ions from water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-MembraneProcess,
        watr:Process-Separation .

watr:Process-GACFiltration a watr:Class,
        watr:Process-GACFiltration ;
    rdfs:label "GAC Filtration" ;
    rdfs:comment "Filtration through a bed of granular activated carbon, which retains particles as any granular medium does and adsorbs dissolved constituents onto the carbon's surface." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Adsorption,
        watr:Process-MediaFiltration ;
    skos:altLabel "Granular Activated Carbon" .

watr:Process-Mixing a watr:Class,
        watr:Process-Mixing ;
    rdfs:label "Mixing" ;
    rdfs:comment "A unit process that mixes water with chemicals or other substances to achieve a desired effect." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Oxidation a watr:Class,
        watr:Process-Oxidation ;
    rdfs:label "Oxidation" ;
    rdfs:comment "A unit process that adds oxidizing agents to water to remove contaminants or improve water quality." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-UVIrradiation a watr:Class,
        watr:Process-UVIrradiation ;
    rdfs:label "Ultraviolet Irradiation" ;
    rdfs:comment "Exposure of water to ultraviolet light. Named for what it does rather than what it is for: the same irradiation serves disinfection and, combined with an oxidant, advanced oxidation." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Salt-NaCl a sh:NodeShape,
        watr:Class,
        watr:Salt-NaCl ;
    rdfs:label "Sodium Chloride" ;
    rdfs:comment "Sodium chloride dissolved in a treatment medium, the dominant salt in seawater and in most brackish sources." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Constituent-Salt .

watr:SeparationTank a sh:NodeShape,
        watr:Class ;
    rdfs:label "Separation Tank" ;
    rdfs:comment "A tank that has at least two outlets (e.g. overflow and underflow)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Tank,
        watr:UnitProcess ;
    sh:property [ rdfs:comment "A separation tank has at least two outlet connection points" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 2 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:path s223:hasMedium ] ] ],
        [ sh:message "Instances of SeparationTank must have at least one Separation process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Separation ] ] .

watr:TreatmentObjective-Dewatering a watr:Class,
        watr:TreatmentObjective-Dewatering ;
    rdfs:label "Dewatering" ;
    rdfs:comment "Removing water from a sludge or slurry to the point that the product is a handleable cake rather than a pumpable liquid." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-VolumeReduction .

watr:TreatmentObjective-Disinfection a watr:Class,
        watr:TreatmentObjective-Disinfection ;
    rdfs:label "Disinfection" ;
    rdfs:comment "Inactivation or removal of pathogenic organisms from the treated stream. Reached by chlorination, ozonation, ultraviolet irradiation or thermal treatment, none of which is the outcome itself." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective ;
    watr:targetsConstituent watr:Constituent-Pathogens .

watr:TreatmentObjective-NutrientRemoval a watr:Class,
        watr:TreatmentObjective-NutrientRemoval ;
    rdfs:label "Nutrient Removal" ;
    rdfs:comment "Net removal of nitrogen or phosphorus from the treated stream, as opposed to its conversion from one form to another." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    watr:targetsConstituent watr:Constituent-Nitrogen,
        watr:Constituent-Phosphorus .

watr:TreatmentObjective-VolumeReduction a watr:Class,
        watr:TreatmentObjective-VolumeReduction ;
    rdfs:label "Volume Reduction" ;
    rdfs:comment "Reduction of the volume of a sludge or slurry by removing water from it. The parent of thickening, dewatering and drying, which differ in the state of the product." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:Constituent-Organics a sh:NodeShape,
        watr:Class,
        watr:Constituent-Organics ;
    rdfs:label "Organics" ;
    rdfs:comment "Organic chemical matter present as a constituent of a treatment medium." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:Constituent-Pathogens a sh:NodeShape,
        watr:Class,
        watr:Constituent-Pathogens ;
    rdfs:label "Pathogens" ;
    rdfs:comment "Disease-causing organisms present as constituents of a treatment medium. The constituent disinfection targets." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:DataProcessing-AccuracyMetrics a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-AccuracyMetrics ;
    rdfs:label "Accuracy Metrics" ;
    rdfs:comment "Combined accuracy measures (precision and trueness)" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:DataProcessing-PrecisionMetrics a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-PrecisionMetrics ;
    rdfs:label "Precision Metrics" ;
    rdfs:comment "Metrics for precision and repeatability measurements" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:DataProcessing-Synchronization a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-Synchronization ;
    rdfs:label "Synchronization" ;
    rdfs:comment "Parent class for synchronization methods to align data from multiple sources to common time intervals" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:DefinedClassShape a sh:NodeShape ;
    rdfs:label "Defined class" ;
    rdfs:comment "A class that exists: it carries at least one rdf:type." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:property [ sh:message "This class is referenced by a shape but is never defined." ;
            sh:minCount 1 ;
            sh:path rdf:type ] .

watr:Process-Combustion a watr:Class,
        watr:Process-Combustion ;
    rdfs:label "Combustion" ;
    rdfs:comment "A process that combusts biosolids or biogas." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess,
        watr:Process-PhysicalProcess .

watr:Process-Denitrification a watr:Class,
        watr:Process-Denitrification ;
    rdfs:label "Denitrification" ;
    rdfs:comment "Process by which nitrate is deoxidized to nitrogen gas and nitrogen oxides." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval .

watr:Process-MediaFiltration a watr:Class,
        watr:Process-MediaFiltration ;
    rdfs:label "Media Filtration" ;
    rdfs:comment "A filtration process that uses a bed of media (as opposed to a membrane-based process)." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Filtration,
        watr:Process-SolidLiquidSeparation .

watr:Process-Nitrification a watr:Class,
        watr:Process-Nitrification ;
    rdfs:label "Nitrification" ;
    rdfs:comment "Process by which ammonia is oxidized to nitrite and subsequently nitrate." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-AmmoniaControl .

watr:Process-Recirculation a watr:Class,
        watr:Process-Recirculation ;
    rdfs:label "Recirculation" ;
    rdfs:comment "A process that returns a portion of a treated or intermediate flow back upstream to maintain hydraulic, solids, or biological performance." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-ReverseOsmosis a watr:Class,
        watr:Process-ReverseOsmosis ;
    rdfs:label "Reverse Osmosis (RO)" ;
    rdfs:comment "Separation across a semi-permeable membrane under an applied pressure greater than the osmotic pressure of the feed, so that water passes and dissolved salts are retained." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Filtration,
        watr:Process-MembraneProcess .

watr:Thickener a sh:NodeShape,
        watr:Class ;
    rdfs:label "Thickener" ;
    rdfs:comment "A device used to increase the solids concentration of a slurry" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ sh:message "Instances of Thickener must have the Thickening treatment objective." ;
            sh:path watr:hasTreatmentObjective ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:TreatmentObjective-Thickening ] ] .

watr:TreatmentObjective-OrganicsRemoval a watr:Class,
        watr:TreatmentObjective-OrganicsRemoval ;
    rdfs:label "Organics Removal" ;
    rdfs:comment "Net removal of biodegradable or dissolved organic material, measured as BOD, COD or TOC." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    watr:targetsConstituent watr:Constituent-Organics .

watr:TreatmentObjective-Stabilization a watr:Class,
        watr:TreatmentObjective-Stabilization ;
    rdfs:label "Stabilization" ;
    rdfs:comment "Reduction of the volatile solids, pathogen content and odour potential of biosolids so that they can be stored, used or disposed of." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:Process a sh:NodeShape,
        watr:Class ;
    rdfs:label "Water Treatment Process" ;
    rdfs:comment "A physical, chemical, or biological activity performed by a piece of equipment or by a system." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable label for the process type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable definition of the process type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:comment ] .

watr:Process-Biofiltration a watr:Class,
        watr:Process-Biofiltration ;
    rdfs:label "Biofiltration" ;
    rdfs:comment "A filtration method that uses biological processes to remove contaminants." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess,
        watr:Process-Filtration .

watr:Process-Dosing a watr:Class,
        watr:Process-Dosing ;
    rdfs:label "Dosing" ;
    rdfs:comment "Metered addition of a reagent to water, such as chlorine, coagulant, polymer, acid, base, or sulfite." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-MembraneProcess a watr:Class,
        watr:Process-MembraneProcess ;
    rdfs:label "Membrane Process" ;
    rdfs:comment "A separation process that uses a membrane. Includes membrane filtration, membrane distillation and electrodialysis; transport may be driven by pressure, a vapour-pressure difference or an electric potential." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:TreatmentObjective-PhosphorusRemoval a watr:Class,
        watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:label "Phosphorus Removal" ;
    rdfs:comment "Net removal of phosphorus from the treated stream, by taking it into biomass or precipitating it into a solid that is then wasted." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-NutrientRemoval ;
    watr:targetsConstituent watr:Constituent-Phosphorus .

watr:Constituent-Nitrogen a sh:NodeShape,
        watr:Class,
        watr:Constituent-Nitrogen ;
    rdfs:label "Nitrogen" ;
    rdfs:comment "Nitrogen present as a constituent of a treatment medium in any form: ammonia, nitrite, nitrate and organic nitrogen together." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:DataProcessing-Interpolation a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-Interpolation ;
    rdfs:label "Interpolation" ;
    rdfs:comment "Parent class for interpolation methods to estimate values between known data points" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:Process-ActivatedSludge a watr:Class,
        watr:Process-ActivatedSludge ;
    rdfs:label "Activated Sludge" ;
    rdfs:comment "Suspended-growth biological treatment in which biomass is aerated and subsequently separated from the treated water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-BiologicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-OrganicsRemoval ;
    watr:includesProcess watr:Process-Aeration,
        watr:Process-SolidLiquidSeparation .

watr:Process-Settling a watr:Class,
        watr:Process-Settling ;
    rdfs:label "Settling" ;
    rdfs:comment "A unit process that allows solids to settle out of water by gravity." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation ;
    skos:altLabel "Sedimentation" .

watr:TreatmentObjective-BiosolidsDisposal a watr:Class,
        watr:TreatmentObjective-BiosolidsDisposal ;
    rdfs:label "Biosolids Disposal" ;
    rdfs:comment "Final disposition of biosolids, by land application, landfilling, incineration or another route." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:TreatmentObjective-DissolvedSolidsRemoval a watr:Class,
        watr:TreatmentObjective-DissolvedSolidsRemoval ;
    rdfs:label "Dissolved Solids Removal" ;
    rdfs:comment "Reduction of the dissolved solids content of the treated stream. The parent of the objectives aimed at a particular dissolved constituent." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    watr:targetsConstituent watr:Constituent-DissolvedSolids .

watr:TreatmentObjective-SuspendedSolidsRemoval a watr:Class,
        watr:TreatmentObjective-SuspendedSolidsRemoval ;
    rdfs:label "Suspended Solids Removal" ;
    rdfs:comment "Removal of suspended solids, including settleable solids, from the treated stream." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-ConstituentRemoval ;
    watr:targetsConstituent watr:Constituent-SuspendedSolids .

watr:Constituent-DissolvedSolids a sh:NodeShape,
        watr:Class,
        watr:Constituent-DissolvedSolids ;
    rdfs:label "Dissolved Solids" ;
    rdfs:comment "Material dissolved in a treatment medium rather than suspended in it, measured together as total dissolved solids." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

watr:DataProcessing-ErrorMetrics a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-ErrorMetrics ;
    rdfs:label "Error Metrics" ;
    rdfs:comment "Parent class for error and uncertainty measurements" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:Process-BiologicalProcess a watr:Class,
        watr:Process-BiologicalProcess ;
    rdfs:label "Biological Process" ;
    rdfs:comment "A unit process that utilizes biological activity for water treatment." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process .

watr:Process-SolidLiquidSeparation a watr:Class,
        watr:Process-SolidLiquidSeparation ;
    rdfs:label "Solid-Liquid Separation" ;
    rdfs:comment "Separation of suspended solids from the liquid carrying them, by settling, flotation, filtration or centrifugal force. Distinguished from separations that act on dissolved or gaseous constituents." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:EnumerationKind-DataProcessing a sh:NodeShape,
        watr:Class,
        watr:EnumerationKind-DataProcessing ;
    rdfs:label "DataProcessing" ;
    rdfs:comment "This EnumerationKind describes methods of data processing, aggregation, or imputation" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind .

watr:TreatmentObjective a sh:NodeShape,
        watr:Class ;
    rdfs:label "Treatment Objective" ;
    rdfs:comment "An objective that a piece of equipment or a system is intended to achieve." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable definition of the treatment objective." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable label for the treatment objective." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ] .

watr:TreatmentObjective-NitrogenRemoval a watr:Class,
        watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:label "Nitrogen Removal" ;
    rdfs:comment "Net removal of nitrogen from the treated stream, typically by converting nitrate to nitrogen gas so that it leaves as a gas." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective-NutrientRemoval ;
    watr:targetsConstituent watr:Constituent-Nitrogen .

watr:Process-Filtration a watr:Class,
        watr:Process-Filtration ;
    rdfs:label "Filtration" ;
    rdfs:comment "Separation of constituents by passing liquid water through a filter or membrane. Includes media filtration and membrane filtration such as microfiltration, ultrafiltration and reverse osmosis; membrane use alone does not imply filtration." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-Separation a watr:Class,
        watr:Process-Separation ;
    rdfs:label "Separation" ;
    rdfs:comment "The most generic process for separation of any two constituents." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process-PhysicalProcess ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-ConstituentRemoval .

watr:WastewaterTreatmentChemical a sh:NodeShape,
        watr:Class,
        watr:WastewaterTreatmentChemical ;
    rdfs:label "Wastewater Treatment Chemical" ;
    rdfs:comment "Base class for all chemicals used in wastewater treatment" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Medium-Constituent .

s223:Sensor sh:property [ rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum that can physically be measured, e.g. by a sensor." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasMeasurementRange ] .

watr:DataProcessing-Aggregate a sh:NodeShape,
        watr:Class,
        watr:DataProcessing-Aggregate ;
    rdfs:label "Aggregate" ;
    rdfs:comment "Parent class for aggregation functions that combine multiple data points" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:EnumerationKind-DataProcessing .

watr:TreatmentObjective-ConstituentRemoval a watr:Class,
        watr:TreatmentObjective-ConstituentRemoval ;
    rdfs:label "Constituent Removal" ;
    rdfs:comment "Net removal, conversion or control of a named constituent of the treated stream. The parent of the objectives that name what comes out of the water; the constituent each one is aimed at is stated with watr:targetsConstituent." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:TreatmentObjective .

watr:Process-ChemicalProcess a watr:Class,
        watr:Process-ChemicalProcess ;
    rdfs:label "Chemical Process" ;
    rdfs:comment "A unit process that uses chemical reaction, chemical addition, or both to achieve a desired effect." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process .

watr:EnumerationKind-Aggregation a sh:NodeShape,
        watr:Class,
        watr:EnumerationKind-Aggregation ;
    rdfs:label "Aggregation" ;
    rdfs:comment "EnumerationKind for aggregation semantics carried by a property, such as total, mean, maximum, or minimum." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

watr:hasTreatmentObjective a rdf:Property ;
    rdfs:label "has treatment objective" ;
    rdfs:comment "Associates a piece of equipment or a system with the treatment objective it is intended to achieve. What it does to achieve that is watr:hasProcess." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

watr:Filter a sh:NodeShape,
        watr:Class ;
    rdfs:label "Filter" ;
    rdfs:comment "An equipment used to remove impurities from liquids or gases. Unlike s223:Filter, which asks every connection point to carry one compatible medium, it lets air ports for scouring, aeration or venting, and electrical ports, sit beside the liquid ports." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf s223:Equipment,
        watr:UnitProcess ;
    sh:property [ rdfs:comment "A Filter has at least one liquid inlet." ;
            sh:message "A Filter shall have at least one inlet or bidirectional connection point carrying a medium other than air or electricity." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node watr:FilterLiquidConnectionPointShape ;
                    sh:or ( [ sh:class s223:InletConnectionPoint ] [ sh:class s223:BidirectionalConnectionPoint ] ) ] ],
        [ rdfs:comment "Incompatible Medium. Case 1: Two pure mediums on the connection points that carry neither air nor electricity." ;
            sh:path s223:hasConnectionPoint ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "s223: {$this} with inlet medium {?m2} is incompatible with outlet medium {?m1}." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT $this ?m2 ?m1
WHERE {
  $this s223:cnx ?cp1, ?cp2 .
  ?cp1 a/rdfs:subClassOf* s223:ConnectionPoint .
  ?cp2 a/rdfs:subClassOf* s223:ConnectionPoint .
  FILTER (?cp1 != ?cp2) .
  ?cp1 s223:hasMedium ?m1 .
  ?cp2 s223:hasMedium ?m2 .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  FILTER NOT EXISTS {?m1 s223:composedOf ?c1} .
  FILTER NOT EXISTS {?m2 s223:composedOf ?c2} .
  FILTER (NOT EXISTS {?m2 rdfs:subClassOf* ?m1}) .
  FILTER (NOT EXISTS {?m1 rdfs:subClassOf* ?m2}) .
}
""" ] ],
        [ rdfs:comment "Incompatible Medium. Case 2: A medium with constituents and a pure medium on the connection points that carry neither air nor electricity." ;
            sh:path s223:hasConnectionPoint ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "s223: {$this} has an incompatible medium {?m1} with any constituent of {?m2}." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT $this ?m2 ?m1
WHERE {
  $this s223:cnx ?cp1, ?cp2 .
  ?cp1 a/rdfs:subClassOf* s223:ConnectionPoint .
  ?cp2 a/rdfs:subClassOf* s223:ConnectionPoint .
  FILTER (?cp1 != ?cp2) .
  ?cp1 s223:hasMedium ?m1 .
  ?cp2 s223:hasMedium ?m2 .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  ?m2 s223:composedOf/s223:ofConstituent ?s2 .
  FILTER NOT EXISTS {?m1 s223:composedOf ?c1} .
  FILTER NOT EXISTS {
    ?m2 s223:composedOf/s223:ofConstituent ?s12 .
    {?s12 rdfs:subClassOf* ?m1} UNION {?m1 rdfs:subClassOf* ?s12} .
  }
}
""" ] ],
        [ sh:message "Instances of Filter must have at least one Filtration process." ;
            sh:path watr:hasProcess ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ],
        [ rdfs:comment "A Filter has at least one liquid outlet." ;
            sh:message "A Filter shall have at least one outlet or bidirectional connection point carrying a medium other than air or electricity." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node watr:FilterLiquidConnectionPointShape ;
                    sh:or ( [ sh:class s223:OutletConnectionPoint ] [ sh:class s223:BidirectionalConnectionPoint ] ) ] ],
        [ rdfs:comment "Incompatible Medium. Case 3: Two mediums with constituents on the connection points that carry neither air nor electricity." ;
            sh:path s223:hasConnectionPoint ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "s223: For `Filter` {$this} there is no compatible substance between medium {?m2} and medium {?m1}." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT $this ?m2 ?m1
WHERE {
  $this s223:cnx ?cp1, ?cp2 .
  ?cp1 a/rdfs:subClassOf* s223:ConnectionPoint .
  ?cp2 a/rdfs:subClassOf* s223:ConnectionPoint .
  FILTER (?cp1 != ?cp2) .
  ?cp1 s223:hasMedium ?m1 .
  ?cp2 s223:hasMedium ?m2 .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Fluid-Air} .
  FILTER NOT EXISTS {?m1 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  FILTER NOT EXISTS {?m2 a/rdfs:subClassOf* s223:Constituent-Electricity} .
  ?m1 s223:composedOf/s223:ofConstituent ?s1 .
  ?m2 s223:composedOf/s223:ofConstituent ?s2 .
  FILTER NOT EXISTS {
    ?m1 s223:composedOf/s223:ofConstituent ?s11 .
    ?m2 s223:composedOf/s223:ofConstituent ?s12 .
    FILTER (?s11 = ?s12) .
  }
  FILTER NOT EXISTS {
    ?m1 s223:composedOf/s223:ofConstituent ?s21 .
    ?m2 s223:composedOf/s223:ofConstituent ?s22 .
    {?s22 rdfs:subClassOf* ?s21} UNION {?s21 rdfs:subClassOf* ?s22} .
  }
}
""" ] ],
        [ sh:path s223:hasConnectionPoint ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "Workaround: {$this} has a connection point with medium {?medium}, which s223:Filter does not accept beside another medium. It is validated as a watr:Filter only and is not typed s223:Filter. This workaround can be removed if the S223 filter shape allows a second medium on a filter." ;
                    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
SELECT DISTINCT $this ?medium
WHERE {
  FILTER NOT EXISTS {$this a s223:Filter} .
  $this s223:cnx ?cp .
  ?cp a/rdfs:subClassOf* s223:ConnectionPoint .
  ?cp s223:hasMedium ?medium .
  FILTER (EXISTS {?medium a/rdfs:subClassOf* s223:Fluid-Air}
       || EXISTS {?medium a/rdfs:subClassOf* s223:Constituent-Electricity}) .
}
""" ] ] ;
    sh:rule [ a sh:TripleRule ;
            sh:condition s223:Filter ;
            sh:object s223:Filter ;
            sh:order 1 ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] .

watr:Reactor a sh:NodeShape,
        watr:Class ;
    rdfs:label "Reactor" ;
    rdfs:comment "A vessel in which a reaction or biological/chemical treatment process takes place" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Tank,
        watr:UnitProcess ;
    sh:property [ rdfs:comment "A reactor's recirculation or return connection points, if any, are fluid outlets" ;
            sh:message "A recirculation or return connection point on a Reactor must be an outlet carrying a fluid." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:class s223:OutletConnectionPoint ;
                            sh:property [ sh:class s223:Mix-Fluid ;
                                    sh:minCount 1 ;
                                    sh:path s223:hasMedium ] ] ;
                    sh:property [ sh:path s223:hasRole ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape [ sh:in ( s223:Role-Recirculating s223:Role-Return ) ] ] ] ],
        [ rdfs:comment "A reactor has an inlet fluid connection point" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:InletConnectionPoint ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:path s223:hasMedium ] ] ],
        [ rdfs:comment "A reactor has an outlet fluid connection point" ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:not [ sh:property [ sh:hasValue watr:Role-Drain ;
                                    sh:minCount 1 ;
                                    sh:path s223:hasRole ] ] ;
                    sh:property [ sh:class s223:Mix-Fluid ;
                            sh:path s223:hasMedium ] ] ] .

watr:Process-PhysicalProcess a watr:Class,
        watr:Process-PhysicalProcess ;
    rdfs:label "Physical Process" ;
    rdfs:comment "A unit process that relies on physical forces to separate or treat water." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:subClassOf watr:Process .

s223:QuantifiableProperty sh:property [ rdfs:comment "The `hasTemporalRange` relation is used to link to a numerical `Property` whose value indicates the start and end times for which data has been recorded." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasTemporalRange ],
        [ rdfs:comment "The `hasTemporalResolution` relation is used to link to a numerical `Property` whose value indicates the minimum time interval between successive measurements or data points." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasTemporalResolution ],
        [ rdfs:comment "The `hasVariableRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum for the measured variable during normal operation." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasVariableRange ],
        [ rdfs:comment "The `hasCalibrationCurve` relation is used to link to a `Property` that describes the mathematical relationship or lookup table between raw sensor output and calibrated engineering units." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasCalibrationCurve ],
        [ rdfs:comment "The `hasPrecision` relation is used to link to a numerical `Property` whose value indicates the repeatability or reproducibility of measurements under identical conditions." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasPrecision ],
        [ rdfs:comment "The `hasDropRate` relation is used to link to a `Property` describes the amount of data points lost within a range of time due to latencies or other factors." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasDropRate ],
        [ rdfs:comment "If present, `hasAggregation` associates a quantifiable property with one aggregation semantics such as total, mean, maximum, or minimum." ;
            sh:class watr:EnumerationKind-Aggregation ;
            sh:maxCount 1 ;
            sh:path watr:hasAggregation ],
        [ rdfs:comment "The `hasNumericResolution` relation is used to link to a numerical `Property` whose value indicates the smallest distinguishable difference between two measured values in engineering units." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasNumericResolution ],
        [ rdfs:comment "The `hasBias` relation is used to link to a numerical `Property` whose value indicates the systematic offset or drift in measurements relative to the true value." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasBias ],
        [ rdfs:comment "The `hasProcessedData` relation is used to link to a `Property` that describes any data processing, filtering, or transformation applied to the raw measurement values." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasProcessedData ],
        [ rdfs:comment "The `hasNumericRange` relation is used to link to a numerical `Property` whose value indicates the span between the minimum and maximum measured values." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasNumericRange ],
        [ rdfs:comment "The `hasAccuracy` relation is used to link to a numerical `Property` whose value indicates the maximum expected deviation between the measured value and the true value in engineering units." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasAccuracy ],
        [ rdfs:comment "The `hasResponseTime` relation is used to link to a numerical `Property` whose value indicates the time required for the sensor or measurement system to respond to a step change in the measured variable." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasResponseTime ],
        [ rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum that can physically be measured, e.g. by a sensor." ;
            sh:class s223:QuantifiableProperty ;
            sh:path watr:hasMeasurementRange ] .

watr:hasProcess a rdf:Property ;
    rdfs:label "has process" ;
    rdfs:comment "Associates a water treatment process with the entity that performs it: a piece of Equipment, or an s223:System where the process is performed by the collection and by no individual member (backwashing, or a treatment train such as an MLE). See watr:ProcessBearerShape and watr:ProcessValueShape." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> .

<https://watermetadata.org/ontology/watr> a owl:Ontology ;
    rdfs:label "NAWI Water Ontology - Version 0.3.rc2" ;
    dcterms:description "An ontology for describing water and wastewater treatment systems, built on ASHRAE Standard 223P." ;
    dcterms:license <https://github.com/DataDrivenCPS/water-ontology/blob/main/LICENSE> ;
    dcterms:modified "2026-11-10"^^xsd:date ;
    dcterms:title "NAWI Water Ontology" ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
    rdfs:seeAlso <https://watermetadata.org> ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all>,
        <http://qudt.org/3.4.0/vocab/quantitykind>,
        <http://qudt.org/3.4.0/vocab/unit>,
        sh: ;
    owl:versionIRI <https://watermetadata.org/ontology/watr> ;
    owl:versionInfo "0.3.rc2" ;
    sh:declare [ sh:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
            sh:prefix "qudt" ],
        [ sh:namespace "https://watermetadata.org/ontology/watr#"^^xsd:anyURI ;
            sh:prefix "watr" ],
        [ sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
            sh:prefix "rdfs" ],
        [ sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ;
            sh:prefix "sh" ],
        [ sh:namespace "https://watermetadata.org/ontology/watr#"^^xsd:anyURI ;
            sh:prefix "watr" ],
        [ sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
            sh:prefix "rdf" ],
        [ sh:namespace "http://data.ashrae.org/standard223#"^^xsd:anyURI ;
            sh:prefix "s223" ],
        [ sh:namespace "http://data.ashrae.org/standard223#"^^xsd:anyURI ;
            sh:prefix "s223" ],
        [ sh:namespace "http://qudt.org/vocab/unit/"^^xsd:anyURI ;
            sh:prefix "unit" ],
        [ sh:namespace "http://qudt.org/vocab/quantitykind/"^^xsd:anyURI ;
            sh:prefix "quantitykind" ] .

