    dcterms:isReplacedBy watr:TreatmentObjective-Dewatering ;
    rdfs:comment "Deprecated designation; use TreatmentObjective-Dewatering. The replacement distinguishes treatment mechanism from objective." ;
    rdfs:isDefinedBy <https://watermetadata.org/ontology/watr> ;
