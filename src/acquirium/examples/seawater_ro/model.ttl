    s223:hasRole watr:Role-Posttreatment ;
    rdfs:comment "WaterTAP: fs.posttreatment.uv_aop (UVAOPZO, hydrogen_peroxide); UV irradiation with hydrogen peroxide as the oxidant" ;
    watr:hasProcess watr:Process-AdvancedOxidation,
        watr:Process-UVIrradiation ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Disinfection .

wbs:anti-scalant-addition a watr:Reactor ;
    rdfs:label "Anti-scalant Addition" ;
    s223:cnx wbs:anti-scalant-addition-chem-in,
        wbs:anti-scalant-addition-in,
        wbs:anti-scalant-addition-out ;
    s223:connected wbs:cartridge-filtration,
        wbs:media-filtration ;
    s223:connectedFrom wbs:media-filtration ;
    s223:connectedThrough wbs:conn-anti-scalant-addition-to-cartridge-filtration,
        wbs:conn-media-filtration-to-anti-scalant-addition ;
    s223:connectedTo wbs:cartridge-filtration ;
    s223:hasConnectionPoint wbs:anti-scalant-addition-chem-in,
        wbs:anti-scalant-addition-in,
        wbs:anti-scalant-addition-out ;
    s223:hasProperty wbs:anti-scalant-addition-anti-scalant-dose ;
    s223:hasRole watr:Role-Pretreatment ;
    rdfs:comment "WaterTAP: fs.pretreatment.anti_scalant_addition (ChemicalAdditionZO, anti-scalant); chem-in = anti-scalant feed" ;
    watr:hasProcess watr:Process-Dosing .

wbs:co2-addition a watr:Reactor ;
    rdfs:label "CO2 Addition" ;
    s223:cnx wbs:co2-addition-chem-in,
        wbs:co2-addition-in,
        wbs:co2-addition-out ;
    s223:connected wbs:lime-addition,
        wbs:uv-aop ;
    s223:connectedFrom wbs:uv-aop ;
    s223:connectedThrough wbs:conn-co2-addition-to-lime-addition,
        wbs:conn-uv-aop-to-co2-addition ;
    s223:connectedTo wbs:lime-addition ;
    s223:hasConnectionPoint wbs:co2-addition-chem-in,
        wbs:co2-addition-in,
        wbs:co2-addition-out ;
    s223:hasRole watr:Role-Posttreatment ;
    rdfs:comment "WaterTAP: fs.posttreatment.co2_addition (CO2AdditionZO); carbon dioxide dosed for remineralization with the lime, chem-in = CO2 feed" ;
    watr:hasProcess watr:Process-Dosing ;
    watr:hasTreatmentObjective watr:TreatmentObjective-pHControl .

wbs:ferric-chloride-addition a watr:Reactor ;
    rdfs:label "Ferric Chloride Addition" ;
    s223:cnx wbs:ferric-chloride-addition-chem-in,
        wbs:ferric-chloride-addition-in,
        wbs:ferric-chloride-addition-out ;
    s223:connected wbs:chlorination,
        wbs:intake ;
    s223:connectedFrom wbs:intake ;
    s223:connectedThrough wbs:conn-ferric-chloride-addition-to-chlorination,
        wbs:conn-intake-to-ferric-chloride-addition ;
    s223:connectedTo wbs:chlorination ;
    s223:hasConnectionPoint wbs:ferric-chloride-addition-chem-in,
        wbs:ferric-chloride-addition-in,
        wbs:ferric-chloride-addition-out ;
    s223:hasProperty wbs:ferric-chloride-addition-ferric-chloride-dose ;
    s223:hasRole watr:Role-Pretreatment ;
    rdfs:comment "WaterTAP: fs.pretreatment.ferric_chloride_addition (ChemicalAdditionZO, ferric_chloride); coagulant dosed ahead of media filtration, chem-in = ferric chloride feed" ;
    watr:hasProcess watr:Process-Coagulation .

wbs:lime-addition a watr:Reactor ;
    rdfs:label "Lime Addition" ;
    s223:cnx wbs:lime-addition-chem-in,
        wbs:lime-addition-in,
        wbs:lime-addition-out ;
    s223:connected wbs:co2-addition,
        wbs:storage-tank-3 ;
    s223:connectedFrom wbs:co2-addition ;
    s223:connectedThrough wbs:conn-co2-addition-to-lime-addition,
        wbs:conn-lime-addition-to-storage-tank-3 ;
    s223:connectedTo wbs:storage-tank-3 ;
    s223:hasConnectionPoint wbs:lime-addition-chem-in,
        wbs:lime-addition-in,
        wbs:lime-addition-out ;
    s223:hasProperty wbs:lime-addition-lime-dose ;
    s223:hasRole watr:Role-Posttreatment ;
    rdfs:comment "WaterTAP: fs.posttreatment.lime_addition (ChemicalAdditionZO, lime); chem-in = lime feed" ;
    watr:hasProcess watr:Process-Dosing ;
    watr:hasTreatmentObjective watr:TreatmentObjective-pHControl .

wbs:P1 a watr:Pump ;
    rdfs:label "High-pressure Pump P1" ;
    s223:cnx wbs:P1-in,
        wbs:P1-out ;
    s223:connected wbs:M1,
        wbs:S1 ;
    s223:connectedFrom wbs:S1 ;
    s223:connectedThrough wbs:conn-P1-to-M1,
        wbs:conn-S1-to-P1 ;
    s223:connectedTo wbs:M1 ;
    s223:hasConnectionPoint wbs:P1-in,
        wbs:P1-out ;
    s223:hasProperty wbs:P1-efficiency,
        wbs:P1-mechanical-power ;
    rdfs:comment "WaterTAP: fs.desalination.P1 (Pump)" .

wbs:P2 a watr:Pump ;
    rdfs:label "Booster Pump P2" ;
    s223:cnx wbs:P2-in,
        wbs:P2-out ;
    s223:connected wbs:M1,
        wbs:PXR ;
    s223:connectedFrom wbs:PXR ;
    s223:connectedThrough wbs:conn-P2-to-M1,
        wbs:conn-PXR-to-P2 ;
    s223:connectedTo wbs:M1 ;
    s223:hasConnectionPoint wbs:P2-in,
        wbs:P2-out ;
    s223:hasProperty wbs:P2-efficiency,
        wbs:P2-mechanical-power ;
    rdfs:comment "WaterTAP: fs.desalination.P2 (Pump)" .

wbs:cartridge-filtration a watr:CartridgeFiltrationUnit ;
    rdfs:label "Cartridge Filtration" ;
    s223:cnx wbs:cartridge-filtration-in,
        wbs:cartridge-filtration-out,
        wbs:cartridge-filtration-outlet-cp ;
    s223:connected wbs:S1,
        wbs:anti-scalant-addition ;
    s223:connectedFrom wbs:anti-scalant-addition ;
    s223:connectedThrough wbs:conn-anti-scalant-addition-to-cartridge-filtration,
        wbs:conn-cartridge-filtration-to-S1 ;
    s223:connectedTo wbs:S1 ;
    s223:hasConnectionPoint wbs:cartridge-filtration-in,
        wbs:cartridge-filtration-out,
        wbs:cartridge-filtration-outlet-cp ;
    s223:hasRole watr:Role-Pretreatment ;
    rdfs:comment "WaterTAP: fs.pretreatment.cartridge_filtration (CartridgeFiltrationZO)" ;
    watr:hasProcess watr:Process-Filtration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-SuspendedSolidsRemoval .

wbs:M1 a s223:Junction ;
    rdfs:label "Feed Mixer M1" ;
    s223:cnx wbs:M1-inlet-cp,
        wbs:M1-inlet-cp-2,
        wbs:M1-outlet-cp ;
    s223:connected wbs:P1,
        wbs:P2,
        wbs:RO ;
    s223:connectedFrom wbs:P1,
        wbs:P2 ;
    s223:connectedThrough wbs:conn-M1-to-RO,
        wbs:conn-P1-to-M1,
        wbs:conn-P2-to-M1 ;
    s223:connectedTo wbs:RO ;
    s223:hasConnectionPoint wbs:M1-inlet-cp,
        wbs:M1-inlet-cp-2,
        wbs:M1-outlet-cp ;
    s223:hasMedium watr:Water-Seawater ;
    rdfs:comment "WaterTAP: fs.desalination.M1 (Mixer); joins the P1 and booster pump P2 streams ahead of the RO stage" .

wbs:RO a watr:ReverseOsmosisMembrane ;
    rdfs:label "Reverse Osmosis Stage" ;
    s223:cnx wbs:RO-in,
        wbs:RO-out,
        wbs:RO-out-retentate ;
    s223:connected wbs:M1,
        wbs:PXR,
        wbs:storage-tank-2 ;
    s223:connectedFrom wbs:M1 ;
    s223:connectedThrough wbs:conn-M1-to-RO,
        wbs:conn-RO-to-PXR,
        wbs:conn-RO-to-storage-tank-2 ;
    s223:connectedTo wbs:PXR,
        wbs:storage-tank-2 ;
    s223:hasConnectionPoint wbs:RO-in,
        wbs:RO-out,
        wbs:RO-out-retentate ;
    s223:hasProperty wbs:RO-membrane-area ;
    rdfs:comment "WaterTAP: fs.desalination.RO (ReverseOsmosis0D); out = permeate, out-retentate = concentrate" ;
    watr:hasProcess watr:Process-ReverseOsmosis ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Desalination .

wbs:S1 a s223:Junction ;
    rdfs:label "Feed Splitter S1" ;
    s223:cnx wbs:S1-inlet-cp,
        wbs:S1-outlet-cp,
        wbs:S1-outlet-cp-2 ;
    s223:connected wbs:P1,
        wbs:PXR,
        wbs:cartridge-filtration ;
    s223:connectedFrom wbs:cartridge-filtration ;
    s223:connectedThrough wbs:conn-S1-to-P1,
        wbs:conn-S1-to-PXR,
        wbs:conn-cartridge-filtration-to-S1 ;
    s223:connectedTo wbs:P1,
        wbs:PXR ;
    s223:hasConnectionPoint wbs:S1-inlet-cp,
        wbs:S1-outlet-cp,
        wbs:S1-outlet-cp-2 ;
    s223:hasMedium watr:Water-Seawater ;
    rdfs:comment "WaterTAP: fs.desalination.S1 (Separator); splits the pretreated feed between high-pressure pump P1 and the pressure exchanger" .

wbs:media-filtration a watr:MediaFiltrationUnit ;
    rdfs:label "Media Filtration" ;
    s223:cnx wbs:media-filtration-in,
        wbs:media-filtration-out,
        wbs:media-filtration-outlet-cp ;
    s223:connected wbs:anti-scalant-addition,
        wbs:backwash-handling,
        wbs:storage-tank-1 ;
    s223:connectedFrom wbs:storage-tank-1 ;
    s223:connectedThrough wbs:conn-media-filtration-to-anti-scalant-addition,
        wbs:conn-media-filtration-to-backwash-handling,
        wbs:conn-storage-tank-1-to-media-filtration ;
    s223:connectedTo wbs:anti-scalant-addition,
        wbs:backwash-handling ;
    s223:hasConnectionPoint wbs:media-filtration-in,
        wbs:media-filtration-out,
        wbs:media-filtration-outlet-cp ;
    s223:hasRole watr:Role-Pretreatment ;
    rdfs:comment "WaterTAP: fs.pretreatment.media_filtration (MediaFiltrationZO); out = treated, extra outlet = backwash byproduct" ;
    watr:hasProcess watr:Process-MediaFiltration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-SuspendedSolidsRemoval .

wbs:PXR a watr:PressureExchanger ;
    rdfs:label "Pressure Exchanger" ;
    s223:cnx wbs:PXR-brine-in,
        wbs:PXR-brine-out,
        wbs:PXR-in,
        wbs:PXR-out ;
    s223:connected wbs:P2,
        wbs:RO,
        wbs:S1 ;
    s223:connectedFrom wbs:RO,
        wbs:S1 ;
    s223:connectedThrough wbs:conn-PXR-to-P2,
        wbs:conn-RO-to-PXR,
        wbs:conn-S1-to-PXR ;
    s223:connectedTo wbs:P2 ;
    s223:hasConnectionPoint wbs:PXR-brine-in,
        wbs:PXR-brine-out,
        wbs:PXR-in,
        wbs:PXR-out ;
    s223:hasProperty wbs:PXR-efficiency ;
    rdfs:comment "WaterTAP: fs.desalination.PXR (PressureExchanger); energy recovery device: in/out = low-pressure feed side, brine-in/brine-out = high-pressure brine side" .

