# ----------------------------------------------------------------------------
# Sensors (observing properties at connection locations)
# ----------------------------------------------------------------------------

dum:conn-intake-pump-to-intake-tank-pressure-sensor a ns1:Sensor ;
    ns1:hasObservationLocation dum:conn-intake-pump-to-intake-tank ;
    ns1:observes dum:conn-intake-pump-to-intake-tank-pressure ;
    ns2:isDeltaQuantity false .

dum:conn-intake-valve-to-intake-junction-flow-rate-sensor a ns1:Sensor ;
    ns1:hasObservationLocation dum:conn-intake-valve-to-intake-junction ;
    ns1:observes dum:conn-intake-valve-to-intake-junction-flow-rate ;
    ns2:isDeltaQuantity false .

