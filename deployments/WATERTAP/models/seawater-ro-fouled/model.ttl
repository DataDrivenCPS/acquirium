    s223:connectedThrough wbsf:conn-co2-addition-to-lime-addition,
        wbsf:conn-uv-aop-to-co2-addition ;
    s223:connectedTo wbsf:lime-addition ;
    s223:hasConnectionPoint wbsf:co2-addition-in,
        wbsf:co2-addition-out ;
    rdfs:comment "WaterTAP: fs.posttreatment.co2_addition (CO2AdditionZO)" ;
    nawi:hasProcess nawi:Process-Mixing .

wbsf:ferric-chloride-addition a nawi:StaticMixer ;
    rdfs:label "Ferric Chloride Addition" ;
    s223:cnx wbsf:ferric-chloride-addition-in,
        wbsf:ferric-chloride-addition-out ;
    s223:connected wbsf:chlorination,
        wbsf:intake ;
    s223:connectedFrom wbsf:intake ;
    s223:connectedThrough wbsf:conn-ferric-chloride-addition-to-chlorination,
        wbsf:conn-intake-to-ferric-chloride-addition ;
    s223:connectedTo wbsf:chlorination ;
    s223:hasConnectionPoint wbsf:ferric-chloride-addition-in,
        wbsf:ferric-chloride-addition-out ;
    rdfs:comment "WaterTAP: fs.pretreatment.ferric_chloride_addition (ChemicalAdditionZO, ferric_chloride)" ;
    nawi:hasProcess nawi:Process-Mixing .

wbsf:lime-addition a nawi:StaticMixer ;
    rdfs:label "Lime Addition" ;
    s223:cnx wbsf:lime-addition-in,
        wbsf:lime-addition-out ;
    s223:connected wbsf:co2-addition,
        wbsf:storage-tank-3 ;
    s223:connectedFrom wbsf:co2-addition ;
    s223:connectedThrough wbsf:conn-co2-addition-to-lime-addition,
        wbsf:conn-lime-addition-to-storage-tank-3 ;
    s223:connectedTo wbsf:storage-tank-3 ;
    s223:hasConnectionPoint wbsf:lime-addition-in,
        wbsf:lime-addition-out ;
    rdfs:comment "WaterTAP: fs.posttreatment.lime_addition (ChemicalAdditionZO, lime)" ;
    nawi:hasProcess nawi:Process-Mixing .

wbsf:static-mixer a nawi:StaticMixer ;
    rdfs:label "Static Mixer" ;
    s223:cnx wbsf:static-mixer-in,
        wbsf:static-mixer-out ;
    s223:connected wbsf:chlorination,
        wbsf:storage-tank-1 ;
    s223:connectedFrom wbsf:chlorination ;
    s223:connectedThrough wbsf:conn-chlorination-to-static-mixer,
        wbsf:conn-static-mixer-to-storage-tank-1 ;
    s223:connectedTo wbsf:storage-tank-1 ;
    s223:hasConnectionPoint wbsf:static-mixer-in,
        wbsf:static-mixer-out ;
    rdfs:comment "WaterTAP: fs.pretreatment.static_mixer (StaticMixerZO)" ;
    nawi:hasProcess nawi:Process-Mixing .

wbsf:storage-tank-1 a nawi:Tank ;
    rdfs:label "Storage Tank 1" ;
    s223:cnx wbsf:storage-tank-1-in,
        wbsf:storage-tank-1-out ;
    s223:connected wbsf:media-filtration,
        wbsf:static-mixer ;
    s223:connectedFrom wbsf:static-mixer ;
    s223:connectedThrough wbsf:conn-static-mixer-to-storage-tank-1,
        wbsf:conn-storage-tank-1-to-media-filtration ;
    s223:connectedTo wbsf:media-filtration ;
    s223:hasConnectionPoint wbsf:storage-tank-1-in,
        wbsf:storage-tank-1-out ;
    s223:hasRole nawi:Role-Storage ;
    rdfs:comment "WaterTAP: fs.pretreatment.storage_tank_1 (StorageTankZO)" .

wbsf:storage-tank-2 a nawi:Tank ;
    rdfs:label "Storage Tank 2" ;
    s223:cnx wbsf:storage-tank-2-in,
        wbsf:storage-tank-2-out ;
    s223:connected wbsf:RO,
        wbsf:uv-aop ;
    s223:connectedFrom wbsf:RO ;
    s223:connectedThrough wbsf:conn-RO-to-storage-tank-2,
        wbsf:conn-storage-tank-2-to-uv-aop ;
    s223:connectedTo wbsf:uv-aop ;
    s223:hasConnectionPoint wbsf:storage-tank-2-in,
        wbsf:storage-tank-2-out ;
    s223:hasRole nawi:Role-Storage ;
    rdfs:comment "WaterTAP: fs.posttreatment.storage_tank_2 (StorageTankZO)" .

wbsf:uv-aop a nawi:UltravioletLightUnit ;
    rdfs:label "UV/AOP" ;
    s223:cnx wbsf:uv-aop-in,
        wbsf:uv-aop-out ;
    s223:connected wbsf:co2-addition,
        wbsf:storage-tank-2 ;
    s223:connectedFrom wbsf:storage-tank-2 ;
    s223:connectedThrough wbsf:conn-storage-tank-2-to-uv-aop,
        wbsf:conn-uv-aop-to-co2-addition ;
    s223:connectedTo wbsf:co2-addition ;
    s223:hasConnectionPoint wbsf:uv-aop-in,
        wbsf:uv-aop-out ;
    rdfs:comment "WaterTAP: fs.posttreatment.uv_aop (UVAOPZO, hydrogen_peroxide)" ;
    nawi:hasProcess nawi:Process-UVDisinfection .

wbsf:P1 a nawi:Pump ;
    rdfs:label "High-pressure Pump P1" ;
    s223:cnx wbsf:P1-in,
        wbsf:P1-out ;
    s223:connected wbsf:M1,
        wbsf:S1 ;
    s223:connectedFrom wbsf:S1 ;
    s223:connectedThrough wbsf:conn-P1-to-M1,
        wbsf:conn-S1-to-P1 ;
    s223:connectedTo wbsf:M1 ;
    s223:hasConnectionPoint wbsf:P1-in,
        wbsf:P1-out ;
    s223:hasProperty wbsf:P1-efficiency,
        wbsf:P1-mechanical-power ;
    rdfs:comment "WaterTAP: fs.desalination.P1 (Pump)" .

wbsf:P2 a nawi:Pump ;
    rdfs:label "Booster Pump P2" ;
    s223:cnx wbsf:P2-in,
        wbsf:P2-out ;
    s223:connected wbsf:M1,
        wbsf:PXR ;
    s223:connectedFrom wbsf:PXR ;
    s223:connectedThrough wbsf:conn-P2-to-M1,
        wbsf:conn-PXR-to-P2 ;
    s223:connectedTo wbsf:M1 ;
    s223:hasConnectionPoint wbsf:P2-in,
        wbsf:P2-out ;
    s223:hasProperty wbsf:P2-efficiency,
        wbsf:P2-mechanical-power ;
    rdfs:comment "WaterTAP: fs.desalination.P2 (Pump)" .

wbsf:M1 a s223:Junction ;
    s223:cnx wbsf:M1-inlet-cp,
        wbsf:M1-inlet-cp-2,
        wbsf:M1-outlet-cp ;
    s223:connected wbsf:P1,
        wbsf:P2,
        wbsf:RO ;
    s223:connectedFrom wbsf:P1,
        wbsf:P2 ;
    s223:connectedThrough wbsf:conn-M1-to-RO,
        wbsf:conn-P1-to-M1,
        wbsf:conn-P2-to-M1 ;
    s223:connectedTo wbsf:RO ;
    s223:hasConnectionPoint wbsf:M1-inlet-cp,
        wbsf:M1-inlet-cp-2,
        wbsf:M1-outlet-cp ;
    s223:hasMedium nawi:Water-Seawater .

wbsf:S1 a s223:Junction ;
    s223:cnx wbsf:S1-inlet-cp,
        wbsf:S1-outlet-cp,
        wbsf:S1-outlet-cp-2 ;
    s223:connected wbsf:P1,
        wbsf:PXR,
        wbsf:cartridge-filtration ;
    s223:connectedFrom wbsf:cartridge-filtration ;
    s223:connectedThrough wbsf:conn-S1-to-P1,
        wbsf:conn-S1-to-PXR,
        wbsf:conn-cartridge-filtration-to-S1 ;
    s223:connectedTo wbsf:P1,
        wbsf:PXR ;
    s223:hasConnectionPoint wbsf:S1-inlet-cp,
        wbsf:S1-outlet-cp,
        wbsf:S1-outlet-cp-2 ;
    s223:hasMedium nawi:Water-Seawater .

wbsf:media-filtration a nawi:Filter ;
    rdfs:label "Media Filtration" ;
    s223:cnx wbsf:media-filtration-in,
        wbsf:media-filtration-out,
        wbsf:media-filtration-outlet-cp ;
    s223:connected wbsf:anti-scalant-addition,
        wbsf:backwash-handling,
        wbsf:storage-tank-1 ;
    s223:connectedFrom wbsf:storage-tank-1 ;
    s223:connectedThrough wbsf:conn-media-filtration-to-anti-scalant-addition,
        wbsf:conn-media-filtration-to-backwash-handling,
        wbsf:conn-storage-tank-1-to-media-filtration ;
    s223:connectedTo wbsf:anti-scalant-addition,
        wbsf:backwash-handling ;
    s223:hasConnectionPoint wbsf:media-filtration-in,
        wbsf:media-filtration-out,
        wbsf:media-filtration-outlet-cp ;
    rdfs:comment "WaterTAP: fs.pretreatment.media_filtration (MediaFiltrationZO); out = treated, extra outlet = backwash byproduct" ;
    nawi:hasProcess nawi:Process-Filtration .

wbsf:RO a nawi:ReverseOsmosisMembrane ;
    rdfs:label "Reverse Osmosis Stage" ;
    s223:cnx wbsf:RO-in,
        wbsf:RO-out,
        wbsf:RO-out-retentate ;
    s223:connected wbsf:M1,
        wbsf:PXR,
        wbsf:storage-tank-2 ;
    s223:connectedFrom wbsf:M1 ;
    s223:connectedThrough wbsf:conn-M1-to-RO,
        wbsf:conn-RO-to-PXR,
        wbsf:conn-RO-to-storage-tank-2 ;
    s223:connectedTo wbsf:PXR,
        wbsf:storage-tank-2 ;
    s223:hasConnectionPoint wbsf:RO-in,
        wbsf:RO-out,
        wbsf:RO-out-retentate ;
    s223:hasProperty wbsf:RO-membrane-area,
        wbsf:RO-membrane-water-permeability ;
    rdfs:comment "WaterTAP: fs.desalination.RO (ReverseOsmosis0D); out = permeate, out-retentate = concentrate" ;
    nawi:hasProcess nawi:Process-ReverseOsmosis .

wbsf:PXR a nawi:PressureExchanger ;
    rdfs:label "Pressure Exchanger" ;
    s223:cnx wbsf:PXR-brine-in,
        wbsf:PXR-brine-out,
        wbsf:PXR-in,
        wbsf:PXR-out ;
    s223:connected wbsf:P2,
        wbsf:RO,
        wbsf:S1 ;
    s223:connectedFrom wbsf:RO,
        wbsf:S1 ;
    s223:connectedThrough wbsf:conn-PXR-to-P2,
        wbsf:conn-RO-to-PXR,
        wbsf:conn-S1-to-PXR ;
    s223:connectedTo wbsf:P2 ;
    s223:hasConnectionPoint wbsf:PXR-brine-in,
        wbsf:PXR-brine-out,
        wbsf:PXR-in,
        wbsf:PXR-out ;
    s223:hasProperty wbsf:PXR-efficiency ;
    rdfs:comment "WaterTAP: fs.desalination.PXR (PressureExchanger); in/out = feed side, brine-in/brine-out = brine side" .

