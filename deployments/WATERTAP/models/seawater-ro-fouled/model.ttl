@prefix nawi: <urn:nawi-water-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix wbsf: <urn:swro-fouled/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wbsf: a owl:Ontology ;
    owl:imports nawi: .

wbsf:P1-efficiency-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:P1 ;
    s223:observes wbsf:P1-efficiency ;
    qudt:isDeltaQuantity false .

wbsf:P1-mechanical-power-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:P1 ;
    s223:observes wbsf:P1-mechanical-power ;
    qudt:isDeltaQuantity false .

wbsf:P1-out-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:P1-out ;
    s223:observes wbsf:P1-out-pressure ;
    qudt:isDeltaQuantity false .

wbsf:P2-efficiency-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:P2 ;
    s223:observes wbsf:P2-efficiency ;
    qudt:isDeltaQuantity false .

wbsf:P2-mechanical-power-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:P2 ;
    s223:observes wbsf:P2-mechanical-power ;
    qudt:isDeltaQuantity false .

wbsf:PXR-brine-out-flow-mass-tds-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:PXR-brine-out ;
    s223:observes wbsf:PXR-brine-out-flow-mass-tds ;
    qudt:isDeltaQuantity false .

wbsf:PXR-brine-out-flow-mass-water-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:PXR-brine-out ;
    s223:observes wbsf:PXR-brine-out-flow-mass-water ;
    qudt:isDeltaQuantity false .

wbsf:PXR-brine-out-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:PXR-brine-out ;
    s223:observes wbsf:PXR-brine-out-pressure ;
    qudt:isDeltaQuantity false .

wbsf:PXR-brine-out-tds-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:PXR-brine-out ;
    s223:observes wbsf:PXR-brine-out-tds-concentration ;
    qudt:isDeltaQuantity false .

wbsf:PXR-efficiency-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:PXR ;
    s223:observes wbsf:PXR-efficiency ;
    qudt:isDeltaQuantity false .

wbsf:RO-in-flow-mass-tds-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-in ;
    s223:observes wbsf:RO-in-flow-mass-tds ;
    qudt:isDeltaQuantity false .

wbsf:RO-in-flow-mass-water-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-in ;
    s223:observes wbsf:RO-in-flow-mass-water ;
    qudt:isDeltaQuantity false .

wbsf:RO-in-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-in ;
    s223:observes wbsf:RO-in-pressure ;
    qudt:isDeltaQuantity false .

wbsf:RO-in-temperature-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-in ;
    s223:observes wbsf:RO-in-temperature ;
    qudt:isDeltaQuantity false .

wbsf:RO-membrane-area-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO ;
    s223:observes wbsf:RO-membrane-area ;
    qudt:isDeltaQuantity false .

wbsf:RO-membrane-water-permeability-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO ;
    s223:observes wbsf:RO-membrane-water-permeability ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-flow-mass-tds-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out ;
    s223:observes wbsf:RO-out-flow-mass-tds ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-flow-mass-water-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out ;
    s223:observes wbsf:RO-out-flow-mass-water ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out ;
    s223:observes wbsf:RO-out-pressure ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-retentate-flow-mass-tds-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out-retentate ;
    s223:observes wbsf:RO-out-retentate-flow-mass-tds ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-retentate-flow-mass-water-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out-retentate ;
    s223:observes wbsf:RO-out-retentate-flow-mass-water ;
    qudt:isDeltaQuantity false .

wbsf:RO-out-retentate-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:RO-out-retentate ;
    s223:observes wbsf:RO-out-retentate-pressure ;
    qudt:isDeltaQuantity false .

wbsf:conn-cartridge-filtration-to-S1-flow-mass-tds-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:conn-cartridge-filtration-to-S1 ;
    s223:observes wbsf:conn-cartridge-filtration-to-S1-flow-mass-tds ;
    qudt:isDeltaQuantity false .

wbsf:conn-cartridge-filtration-to-S1-flow-mass-water-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:conn-cartridge-filtration-to-S1 ;
    s223:observes wbsf:conn-cartridge-filtration-to-S1-flow-mass-water ;
    qudt:isDeltaQuantity false .

wbsf:conn-cartridge-filtration-to-S1-pressure-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:conn-cartridge-filtration-to-S1 ;
    s223:observes wbsf:conn-cartridge-filtration-to-S1-pressure ;
    qudt:isDeltaQuantity false .

wbsf:conn-cartridge-filtration-to-S1-temperature-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:conn-cartridge-filtration-to-S1 ;
    s223:observes wbsf:conn-cartridge-filtration-to-S1-temperature ;
    qudt:isDeltaQuantity false .

wbsf:intake-in-flow-rate-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:intake-in ;
    s223:observes wbsf:intake-in-flow-rate ;
    qudt:isDeltaQuantity false .

wbsf:intake-in-tds-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:intake-in ;
    s223:observes wbsf:intake-in-tds-concentration ;
    qudt:isDeltaQuantity false .

wbsf:intake-in-tss-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:intake-in ;
    s223:observes wbsf:intake-in-tss-concentration ;
    qudt:isDeltaQuantity false .

wbsf:intake-in-toc-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:intake-in ;
    s223:observes wbsf:intake-in-toc-concentration ;
    qudt:isDeltaQuantity false .

wbsf:cartridge-filtration-out-toc-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:cartridge-filtration-out ;
    s223:observes wbsf:cartridge-filtration-out-toc-concentration ;
    qudt:isDeltaQuantity false .

wbsf:seawater-ro-plant a s223:System ;
    s223:hasBoundaryConnectionPoint wbsf:PXR-brine-out,
        wbsf:backwash-handling-out,
        wbsf:intake-in,
        wbsf:storage-tank-3-out ;
    s223:hasMember wbsf:desalination-system,
        wbsf:posttreatment-system,
        wbsf:pretreatment-system .

wbsf:storage-tank-3-out-flow-rate-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:storage-tank-3-out ;
    s223:observes wbsf:storage-tank-3-out-flow-rate ;
    qudt:isDeltaQuantity false .

wbsf:storage-tank-3-out-tds-concentration-sensor a s223:Sensor ;
    s223:hasObservationLocation wbsf:storage-tank-3-out ;
    s223:observes wbsf:storage-tank-3-out-tds-concentration ;
    qudt:isDeltaQuantity false .

wbsf:desalination-system a s223:System ;
    s223:hasBoundaryConnectionPoint wbsf:PXR-brine-out,
        wbsf:RO-out,
        wbsf:S1-inlet-cp ;
    s223:hasMember wbsf:M1,
        wbsf:P1,
        wbsf:P2,
        wbsf:PXR,
        wbsf:RO,
        wbsf:S1 .

wbsf:posttreatment-system a s223:System ;
    s223:hasBoundaryConnectionPoint wbsf:storage-tank-2-in,
        wbsf:storage-tank-3-out ;
    s223:hasMember wbsf:co2-addition,
        wbsf:lime-addition,
        wbsf:storage-tank-2,
        wbsf:storage-tank-3,
        wbsf:uv-aop ;
    s223:hasRole nawi:Role-Posttreatment .

wbsf:pretreatment-system a s223:System ;
    s223:hasBoundaryConnectionPoint wbsf:backwash-handling-out,
        wbsf:cartridge-filtration-out,
        wbsf:intake-in ;
    s223:hasMember wbsf:anti-scalant-addition,
        wbsf:backwash-handling,
        wbsf:cartridge-filtration,
        wbsf:chlorination,
        wbsf:ferric-chloride-addition,
        wbsf:intake,
        wbsf:media-filtration,
        wbsf:static-mixer,
        wbsf:storage-tank-1 ;
    s223:hasRole nawi:Role-Pretreatment .

wbsf:P1-efficiency a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Efficiency ;
    qudt:hasUnit unit:UNITLESS .

wbsf:P1-mechanical-power a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Power ;
    qudt:hasUnit unit:W .

wbsf:P1-out-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure ;
    rdfs:comment "RO operating pressure" .

wbsf:P2-efficiency a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Efficiency ;
    qudt:hasUnit unit:UNITLESS .

wbsf:P2-mechanical-power a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Power ;
    qudt:hasUnit unit:W .

wbsf:PXR-brine-out-flow-mass-tds a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Brine ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:PXR-brine-out-flow-mass-water a s223:QuantifiableObservableProperty ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:PXR-brine-out-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure .

wbsf:PXR-brine-out-tds-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Brine ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassConcentration ;
    qudt:hasUnit unit:KiloGM-PER-M3 ;
    rdfs:comment "brine discharge TDS concentration (Ocean Plan III.M.3 effluent salinity)" .

wbsf:PXR-efficiency a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Efficiency ;
    qudt:hasUnit unit:UNITLESS .

wbsf:RO-in-flow-mass-tds a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-in-flow-mass-water a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-in-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure .

wbsf:RO-in-temperature a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Temperature .

wbsf:RO-membrane-area a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Area ;
    qudt:hasUnit unit:M2 .

wbsf:RO-membrane-water-permeability a s223:QuantifiableObservableProperty ;
    rdfs:comment "RO membrane water permeability coefficient A [m/s-Pa]; declines from fouling (cake layer / biofilm resistance to water transport)." .

wbsf:RO-out-flow-mass-tds a s223:QuantifiableObservableProperty ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-out-flow-mass-water a s223:QuantifiableObservableProperty ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-out-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure .

wbsf:RO-out-retentate-flow-mass-tds a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Brine ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-out-retentate-flow-mass-water a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Brine ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:RO-out-retentate-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure .

wbsf:conn-cartridge-filtration-to-S1-flow-mass-tds a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:conn-cartridge-filtration-to-S1-flow-mass-water a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    qudt:hasQuantityKind qudtqk:MassFlowRate ;
    qudt:hasUnit unit:KiloGM-PER-SEC .

wbsf:conn-cartridge-filtration-to-S1-pressure a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Pressure .

wbsf:conn-cartridge-filtration-to-S1-temperature a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:Temperature .

wbsf:intake-in-flow-rate a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:VolumeFlowRate ;
    rdfs:comment "feed volumetric flow" .

wbsf:intake-in-tds-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassConcentration ;
    qudt:hasUnit unit:KiloGM-PER-M3 ;
    rdfs:comment "feed TDS concentration" .

wbsf:intake-in-tss-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    s223:ofSubstance nawi:Constituent-SuspendedSolids ;
    qudt:hasQuantityKind qudtqk:Density ;
    qudt:hasUnit unit:MilliGM-PER-L ;
    rdfs:comment "feed TSS concentration" .

wbsf:intake-in-toc-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    qudt:hasQuantityKind qudtqk:MassConcentration ;
    qudt:hasUnit unit:KiloGM-PER-M3 ;
    rdfs:comment "feed TOC (nonvolatile organic carbon) concentration" .

wbsf:cartridge-filtration-out-toc-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium nawi:Water-Seawater ;
    qudt:hasQuantityKind qudtqk:MassConcentration ;
    qudt:hasUnit unit:KiloGM-PER-M3 ;
    rdfs:comment "pretreatment-effluent TOC concentration (after cartridge filtration)" .

wbsf:storage-tank-3-out-flow-rate a s223:QuantifiableObservableProperty ;
    qudt:hasQuantityKind qudtqk:VolumeFlowRate ;
    rdfs:comment "product volumetric flow" .

wbsf:storage-tank-3-out-tds-concentration a s223:QuantifiableObservableProperty ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance nawi:Constituent-Salt ;
    qudt:hasQuantityKind qudtqk:MassConcentration ;
    qudt:hasUnit unit:KiloGM-PER-M3 ;
    rdfs:comment "product TDS concentration" .

wbsf:M1-inlet-cp a s223:InletConnectionPoint ;
    s223:cnx wbsf:M1,
        wbsf:conn-P1-to-M1 ;
    s223:connectsThrough wbsf:conn-P1-to-M1 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:M1 .

wbsf:M1-inlet-cp-2 a s223:InletConnectionPoint ;
    s223:cnx wbsf:M1,
        wbsf:conn-P2-to-M1 ;
    s223:connectsThrough wbsf:conn-P2-to-M1 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:M1 .

wbsf:M1-outlet-cp a s223:OutletConnectionPoint ;
    s223:cnx wbsf:M1,
        wbsf:conn-M1-to-RO ;
    s223:connectsThrough wbsf:conn-M1-to-RO ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:M1 .

wbsf:P1-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:P1,
        wbsf:conn-S1-to-P1 ;
    s223:connectsThrough wbsf:conn-S1-to-P1 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:P1 .

wbsf:P2-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:P2,
        wbsf:conn-PXR-to-P2 ;
    s223:connectsThrough wbsf:conn-PXR-to-P2 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:P2 .

wbsf:P2-out a s223:OutletConnectionPoint ;
    s223:cnx wbsf:P2,
        wbsf:conn-P2-to-M1 ;
    s223:connectsThrough wbsf:conn-P2-to-M1 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:P2 .

wbsf:PXR-brine-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:PXR,
        wbsf:conn-RO-to-PXR ;
    s223:connectsThrough wbsf:conn-RO-to-PXR ;
    s223:hasMedium nawi:Water-Brine ;
    s223:isConnectionPointOf wbsf:PXR .

wbsf:PXR-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:PXR,
        wbsf:conn-S1-to-PXR ;
    s223:connectsThrough wbsf:conn-S1-to-PXR ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:PXR .

wbsf:PXR-out a s223:OutletConnectionPoint ;
    s223:cnx wbsf:PXR,
        wbsf:conn-PXR-to-P2 ;
    s223:connectsThrough wbsf:conn-PXR-to-P2 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:PXR .

wbsf:S1-outlet-cp a s223:OutletConnectionPoint ;
    s223:cnx wbsf:S1,
        wbsf:conn-S1-to-P1 ;
    s223:connectsThrough wbsf:conn-S1-to-P1 ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:S1 .

wbsf:S1-outlet-cp-2 a s223:OutletConnectionPoint ;
    s223:cnx wbsf:S1,
        wbsf:conn-S1-to-PXR ;
    s223:connectsThrough wbsf:conn-S1-to-PXR ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:S1 .

wbsf:anti-scalant-addition-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:anti-scalant-addition,
        wbsf:conn-media-filtration-to-anti-scalant-addition ;
    s223:connectsThrough wbsf:conn-media-filtration-to-anti-scalant-addition ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:anti-scalant-addition .

wbsf:anti-scalant-addition-out a s223:OutletConnectionPoint ;
    s223:cnx wbsf:anti-scalant-addition,
        wbsf:conn-anti-scalant-addition-to-cartridge-filtration ;
    s223:connectsThrough wbsf:conn-anti-scalant-addition-to-cartridge-filtration ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:anti-scalant-addition .

wbsf:backwash-handling-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:backwash-handling,
        wbsf:conn-media-filtration-to-backwash-handling ;
    s223:connectsThrough wbsf:conn-media-filtration-to-backwash-handling ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:backwash-handling .

wbsf:backwash-handling-out a s223:OutletConnectionPoint ;
    s223:hasMedium nawi:Fluid-Sludge ;
    s223:isConnectionPointOf wbsf:backwash-handling .

wbsf:cartridge-filtration-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:cartridge-filtration,
        wbsf:conn-anti-scalant-addition-to-cartridge-filtration ;
    s223:connectsThrough wbsf:conn-anti-scalant-addition-to-cartridge-filtration ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:cartridge-filtration .

wbsf:chlorination-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:chlorination,
        wbsf:conn-ferric-chloride-addition-to-chlorination ;
    s223:connectsThrough wbsf:conn-ferric-chloride-addition-to-chlorination ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:chlorination .

wbsf:chlorination-out a s223:OutletConnectionPoint ;
    s223:cnx wbsf:chlorination,
        wbsf:conn-chlorination-to-static-mixer ;
    s223:connectsThrough wbsf:conn-chlorination-to-static-mixer ;
    s223:hasMedium nawi:Water-Seawater ;
    s223:isConnectionPointOf wbsf:chlorination .

wbsf:co2-addition-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:co2-addition,
        wbsf:conn-uv-aop-to-co2-addition ;
    s223:connectsThrough wbsf:conn-uv-aop-to-co2-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf wbsf:co2-addition .

wbsf:co2-addition-out a s223:OutletConnectionPoint ;
    s223:cnx wbsf:co2-addition,
        wbsf:conn-co2-addition-to-lime-addition ;
    s223:connectsThrough wbsf:conn-co2-addition-to-lime-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf wbsf:co2-addition .

wbsf:ferric-chloride-addition-in a s223:InletConnectionPoint ;
    s223:cnx wbsf:conn-intake-to-ferric-chloride-addition,
