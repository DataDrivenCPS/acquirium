    s223:hasProperty wbs:influent-pump-out-flow-rate,
        wbs:influent-pump-out-pressure ;
    s223:isConnectionPointOf wbs:influent-pump .

wbs:rbc-secondary-clarifier-out a s223:OutletConnectionPoint ;
    s223:cnx wbs:conn-rbc-secondary-clarifier-to-chlorine-mixing-chamber,
        wbs:rbc-secondary-clarifier ;
    s223:connectsThrough wbs:conn-rbc-secondary-clarifier-to-chlorine-mixing-chamber ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty wbs:rbc-secondary-clarifier-out-tss-concentration,
        wbs:rbc-secondary-clarifier-out-turbidity ;
    s223:isConnectionPointOf wbs:rbc-secondary-clarifier .

wbs:return-pump-out a s223:OutletConnectionPoint ;
    s223:cnx wbs:conn-return-pump-to-primary-feed-junction,
        wbs:return-pump ;
    s223:connectsThrough wbs:conn-return-pump-to-primary-feed-junction ;
