    s223:hasProperty wbs:return-pump-out-flow-rate,
        wbs:return-pump-out-pressure ;
    s223:isConnectionPointOf wbs:return-pump .

wbs:influent-pump-in a s223:InletConnectionPoint ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty wbs:influent-pump-in-biochemical-oxygen-demand,
        wbs:influent-pump-in-cyanide,
        wbs:influent-pump-in-flow-rate,
        wbs:influent-pump-in-pressure,
        wbs:influent-pump-in-tss-concentration ;
    s223:isConnectionPointOf wbs:influent-pump .

wbs:wet-weather-screen a watr:Screen ;
    rdfs:label "Wet Weather Screening Structure" ;
    s223:cnx wbs:wet-weather-screen-in,
        wbs:wet-weather-screen-out ;
    s223:connected wbs:storage-basin ;
    s223:connectedThrough wbs:conn-wet-weather-screen-to-storage-basin ;
    s223:connectedTo wbs:storage-basin ;
    s223:hasConnectionPoint wbs:wet-weather-screen-in,
        wbs:wet-weather-screen-out ;
    s223:hasProperty wbs:wet-weather-screen-status-onoff ;
    rdfs:comment "Screens the influent wet weather relief sewer, maximum wet weather flow 19 mgd, into the multi-purpose storage basins" ;
    watr:hasProcess watr:Process-Screening ;
    watr:hasTreatmentObjective watr:TreatmentObjective-SuspendedSolidsRemoval .

wbs:belt-filter-press a watr:BeltFilterPress ;
    rdfs:label "Belt Filter Press" ;
    s223:cnx wbs:belt-filter-press-in,
        wbs:belt-filter-press-out ;
    s223:connected wbs:anaerobic-digester ;
    s223:connectedFrom wbs:anaerobic-digester ;
    s223:connectedThrough wbs:conn-anaerobic-digester-to-belt-filter-press ;
    s223:hasConnectionPoint wbs:belt-filter-press-in,
        wbs:belt-filter-press-out ;
    s223:hasProperty wbs:belt-filter-press-electric-current,
        wbs:belt-filter-press-status-onoff ;
    rdfs:comment "Dewatering; the cake outlet is the plant boundary for sludge disposal (hauled offsite)" ;
    watr:hasProcess watr:Process-Filtration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Dewatering .

wbs:influent-pump a watr:Pump ;
    rdfs:label "Influent Pump Station" ;
    s223:actuatedByProperty wbs:influent-pump-speed-command ;
    s223:cnx wbs:influent-pump-out ;
    s223:connected wbs:headworks-screen ;
    s223:connectedThrough wbs:conn-influent-pump-to-headworks-screen ;
    s223:connectedTo wbs:headworks-screen ;
    s223:hasConnectionPoint wbs:influent-pump-in,
        wbs:influent-pump-out ;
    s223:hasProperty wbs:influent-pump-electric-current,
        wbs:influent-pump-fault,
        wbs:influent-pump-speed-command,
        wbs:influent-pump-status-onoff ;
    rdfs:comment "Influent pump station, firm capacity 12 mgd, lifting the domestic and industrial influent sewers into the plant headworks; monitoring location INF-001 is its inlet" .

wbs:daf-thickener a watr:DissolvedAirFlotationThickener ;
    rdfs:label "DAF Thickener" ;
    s223:cnx wbs:daf-thickener-in,
        wbs:daf-thickener-out ;
    s223:connected wbs:anaerobic-digester,
        wbs:thickener-feed-junction ;
    s223:connectedFrom wbs:thickener-feed-junction ;
    s223:connectedThrough wbs:conn-daf-thickener-to-anaerobic-digester,
        wbs:conn-thickener-feed-junction-to-daf-thickener ;
    s223:connectedTo wbs:anaerobic-digester ;
    s223:hasConnectionPoint wbs:daf-thickener-in,
        wbs:daf-thickener-out ;
    watr:hasProcess watr:Process-Flotation ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Thickening .

wbs:grit-chamber a watr:GritChamber ;
    rdfs:label "Grit Chamber" ;
    s223:cnx wbs:grit-chamber-in,
        wbs:grit-chamber-out ;
    s223:connected wbs:grinder,
        wbs:primary-feed-junction ;
    s223:connectedFrom wbs:grinder ;
    s223:connectedThrough wbs:conn-grinder-to-grit-chamber,
        wbs:conn-grit-chamber-to-primary-feed-junction ;
    s223:connectedTo wbs:primary-feed-junction ;
    s223:hasConnectionPoint wbs:grit-chamber-in,
        wbs:grit-chamber-out ;
    s223:hasProperty wbs:grit-chamber-level-status ;
    rdfs:comment "Plant headworks grit removal" ;
    watr:hasProcess watr:Process-Settling ;
    watr:hasTreatmentObjective watr:TreatmentObjective-SuspendedSolidsRemoval .

wbs:dechlorination a watr:Reactor ;
    rdfs:label "Dechlorination" ;
    s223:cnx wbs:dechlorination-chem-in,
        wbs:dechlorination-in,
        wbs:dechlorination-out ;
    s223:connected wbs:chlorine-contact-tank,
        wbs:effluent-pump ;
    s223:connectedFrom wbs:chlorine-contact-tank ;
    s223:connectedThrough wbs:conn-chlorine-contact-tank-to-dechlorination,
        wbs:conn-dechlorination-to-effluent-pump ;
    s223:connectedTo wbs:effluent-pump ;
    s223:hasConnectionPoint wbs:dechlorination-chem-in,
        wbs:dechlorination-in,
        wbs:dechlorination-out ;
    s223:hasProperty wbs:dechlorination-dosing-flow-rate ;
    rdfs:comment "Sodium bisulfite dosing point downstream of the chlorine contact tanks; chem-in is the bisulfite feed" ;
    watr:hasProcess watr:Process-SulfiteDosing ;
    watr:hasTreatmentObjective watr:TreatmentObjective-ChlorineResidualRemoval .

wbs:effluent-junction a s223:Junction ;
    rdfs:label "Effluent pump discharge split" ;
    s223:cnx wbs:effluent-junction-inlet-cp,
        wbs:effluent-junction-outlet-cp,
        wbs:effluent-junction-outlet-cp-2 ;
    s223:connected wbs:effluent-pump,
        wbs:storage-basin ;
    s223:connectedFrom wbs:effluent-pump ;
    s223:connectedThrough wbs:conn-effluent-junction-to-storage-basin,
        wbs:conn-effluent-pump-to-effluent-junction ;
    s223:connectedTo wbs:storage-basin ;
    s223:hasConnectionPoint wbs:effluent-junction-inlet-cp,
        wbs:effluent-junction-outlet-cp,
        wbs:effluent-junction-outlet-cp-2 ;
    s223:hasMedium s223:Fluid-Water .

wbs:rbc-unit a watr:RotatingBiologicalContactor ;
    rdfs:label "RBC (1 train)" ;
    s223:cnx wbs:rbc-unit-in,
        wbs:rbc-unit-out ;
    s223:connected wbs:primary-effluent-junction,
        wbs:rbc-secondary-clarifier ;
    s223:connectedFrom wbs:primary-effluent-junction ;
    s223:connectedThrough wbs:conn-primary-effluent-junction-to-rbc-unit,
        wbs:conn-rbc-unit-to-rbc-secondary-clarifier ;
    s223:connectedTo wbs:rbc-secondary-clarifier ;
    s223:hasConnectionPoint wbs:rbc-unit-in,
        wbs:rbc-unit-out ;
    s223:hasProperty wbs:rbc-unit-electric-current,
        wbs:rbc-unit-status-onoff ;
    rdfs:comment "Rotating biological contactor, one train, maximum flow 3 mgd; takes primary effluent over the 8 mgd activated sludge capacity" ;
    watr:hasProcess watr:Process-Biofiltration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-OrganicsRemoval .

wbs:sluice-gate a watr:SluiceGate ;
    rdfs:label "Diurnal Flow Box Sluice Gate" ;
    s223:actuatedByProperty wbs:sluice-gate-opening-command ;
    s223:cnx wbs:sluice-gate-in,
        wbs:sluice-gate-out ;
    s223:connected wbs:diurnal-flow-box,
        wbs:primary-effluent-junction ;
    s223:connectedFrom wbs:primary-effluent-junction ;
    s223:connectedThrough wbs:conn-primary-effluent-junction-to-sluice-gate,
        wbs:conn-sluice-gate-to-diurnal-flow-box ;
    s223:connectedTo wbs:diurnal-flow-box ;
    s223:hasConnectionPoint wbs:sluice-gate-in,
        wbs:sluice-gate-out ;
    s223:hasProperty wbs:sluice-gate-opening-command,
        wbs:sluice-gate-opening-ratio,
        wbs:sluice-gate-status-position ;
    rdfs:comment "Gate on the primary effluent line into the diurnal flow box" .

wbs:anaerobic-digester a watr:AnaerobicDigester ;
    rdfs:label "Anaerobic Digesters" ;
    s223:cnx wbs:anaerobic-digester-in,
        wbs:anaerobic-digester-out ;
    s223:connected wbs:belt-filter-press,
        wbs:daf-thickener ;
    s223:connectedFrom wbs:daf-thickener ;
    s223:connectedThrough wbs:conn-anaerobic-digester-to-belt-filter-press,
        wbs:conn-daf-thickener-to-anaerobic-digester ;
    s223:connectedTo wbs:belt-filter-press ;
    s223:hasConnectionPoint wbs:anaerobic-digester-in,
        wbs:anaerobic-digester-out ;
    s223:hasProperty wbs:anaerobic-digester-ph,
        wbs:anaerobic-digester-temperature,
        wbs:anaerobic-digester-volume ;
    watr:hasProcess watr:Process-AnaerobicDigestion ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Stabilization .

wbs:effluent-pump a watr:Pump ;
    rdfs:label "Effluent Pumps" ;
    s223:actuatedByProperty wbs:effluent-pump-speed-command ;
    s223:cnx wbs:effluent-pump-in,
        wbs:effluent-pump-out ;
    s223:connected wbs:dechlorination,
        wbs:effluent-junction ;
    s223:connectedFrom wbs:dechlorination ;
    s223:connectedThrough wbs:conn-dechlorination-to-effluent-pump,
        wbs:conn-effluent-pump-to-effluent-junction ;
    s223:connectedTo wbs:effluent-junction ;
    s223:hasConnectionPoint wbs:effluent-pump-in,
        wbs:effluent-pump-out ;
    s223:hasProperty wbs:effluent-pump-electric-current,
        wbs:effluent-pump-fault,
        wbs:effluent-pump-speed-command,
        wbs:effluent-pump-status-onoff ;
    rdfs:comment "Final effluent pump station, 24 mgd maximum capacity; monitoring location EFF-001 is its outlet" .

wbs:flow-return-pump a watr:Pump ;
    rdfs:label "Flow Return Pump" ;
    s223:actuatedByProperty wbs:flow-return-pump-speed-command ;
    s223:cnx wbs:flow-return-pump-in,
        wbs:flow-return-pump-out ;
    s223:connected wbs:diurnal-flow-box,
        wbs:primary-effluent-junction ;
    s223:connectedFrom wbs:diurnal-flow-box ;
    s223:connectedThrough wbs:conn-diurnal-flow-box-to-flow-return-pump,
        wbs:conn-flow-return-pump-to-primary-effluent-junction ;
    s223:connectedTo wbs:primary-effluent-junction ;
    s223:hasConnectionPoint wbs:flow-return-pump-in,
        wbs:flow-return-pump-out ;
    s223:hasProperty wbs:flow-return-pump-electric-current,
        wbs:flow-return-pump-fault,
        wbs:flow-return-pump-speed-command,
        wbs:flow-return-pump-status-onoff ;
    rdfs:comment "Returns flow from the diurnal flow box to the primary-effluent split feeding the secondary trains" .

wbs:grinder a watr:Grinder ;
    rdfs:label "Headworks Grinder" ;
    s223:cnx wbs:grinder-in,
        wbs:grinder-out ;
    s223:connected wbs:grit-chamber,
        wbs:headworks-screen ;
    s223:connectedFrom wbs:headworks-screen ;
    s223:connectedThrough wbs:conn-grinder-to-grit-chamber,
        wbs:conn-headworks-screen-to-grinder ;
    s223:connectedTo wbs:grit-chamber ;
    s223:hasConnectionPoint wbs:grinder-in,
        wbs:grinder-out ;
    s223:hasProperty wbs:grinder-electric-current,
        wbs:grinder-fault,
        wbs:grinder-status-onoff ;
    rdfs:comment "Plant headworks grinding" ;
    watr:hasProcess watr:Process-Comminution .

wbs:headworks-screen a watr:Screen ;
    rdfs:label "Headworks Screen" ;
    s223:cnx wbs:headworks-screen-in,
        wbs:headworks-screen-out ;
    s223:connected wbs:grinder,
        wbs:influent-pump ;
    s223:connectedFrom wbs:influent-pump ;
    s223:connectedThrough wbs:conn-headworks-screen-to-grinder,
        wbs:conn-influent-pump-to-headworks-screen ;
    s223:connectedTo wbs:grinder ;
    s223:hasConnectionPoint wbs:headworks-screen-in,
        wbs:headworks-screen-out ;
    s223:hasProperty wbs:headworks-screen-electric-current,
        wbs:headworks-screen-fault,
        wbs:headworks-screen-status-onoff ;
    rdfs:comment "Plant headworks screening" ;
    watr:hasProcess watr:Process-Screening ;
    watr:hasTreatmentObjective watr:TreatmentObjective-SuspendedSolidsRemoval .

wbs:return-pump a watr:Pump ;
    rdfs:label "Return Pump" ;
    s223:actuatedByProperty wbs:return-pump-speed-command ;
    s223:cnx wbs:return-pump-in,
        wbs:return-pump-out ;
    s223:connected wbs:diurnal-flow-box,
        wbs:primary-feed-junction ;
    s223:connectedFrom wbs:diurnal-flow-box ;
    s223:connectedThrough wbs:conn-diurnal-flow-box-to-return-pump,
        wbs:conn-return-pump-to-primary-feed-junction ;
    s223:connectedTo wbs:primary-feed-junction ;
    s223:hasConnectionPoint wbs:return-pump-in,
        wbs:return-pump-out ;
    s223:hasProperty wbs:return-pump-electric-current,
        wbs:return-pump-fault,
        wbs:return-pump-speed-command,
        wbs:return-pump-status-onoff ;
    rdfs:comment "Returns up to 6 mgd from the diurnal flow box to the headworks line ahead of the primary sedimentation tanks" .

wbs:chlorine-contact-tank a watr:ChlorinationUnit ;
    rdfs:label "Chlorine Contact Tanks (2)" ;
    s223:cnx wbs:chlorine-contact-tank-in,
        wbs:chlorine-contact-tank-out ;
    s223:connected wbs:chlorine-mixing-chamber,
        wbs:dechlorination ;
    s223:connectedFrom wbs:chlorine-mixing-chamber ;
    s223:connectedThrough wbs:conn-chlorine-contact-tank-to-dechlorination,
        wbs:conn-chlorine-mixing-chamber-to-chlorine-contact-tank ;
    s223:connectedTo wbs:dechlorination ;
    s223:hasConnectionPoint wbs:chlorine-contact-tank-in,
        wbs:chlorine-contact-tank-out ;
    s223:hasProperty wbs:chlorine-contact-tank-cl2-mgL,
        wbs:chlorine-contact-tank-ph,
        wbs:chlorine-contact-tank-temperature,
        wbs:chlorine-contact-tank-volume ;
    rdfs:comment "Two chlorine contact tanks giving the disinfection contact time; monitoring location EFF-001D is their outlet" ;
    watr:hasProcess watr:Process-Chlorination ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Disinfection .

wbs:effluent-pump-out a s223:OutletConnectionPoint ;
    s223:cnx wbs:conn-effluent-pump-to-effluent-junction,
        wbs:effluent-pump ;
    s223:connectsThrough wbs:conn-effluent-pump-to-effluent-junction ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty wbs:effluent-pump-out-biochemical-oxygen-demand,
        wbs:effluent-pump-out-cl2-mgL,
        wbs:effluent-pump-out-copper,
        wbs:effluent-pump-out-cyanide,
        wbs:effluent-pump-out-flow-rate,
        wbs:effluent-pump-out-flow-rate-2,
        wbs:effluent-pump-out-nh4-mgL,
        wbs:effluent-pump-out-ph,
        wbs:effluent-pump-out-pressure,
        wbs:effluent-pump-out-teq-dioxin,
        wbs:effluent-pump-out-tss-concentration ;
    s223:isConnectionPointOf wbs:effluent-pump .

wbs:as-aeration-basin a watr:AerationBasin ;
    rdfs:label "Aeration Basins (2)" ;
    s223:cnx wbs:as-aeration-basin-in,
        wbs:as-aeration-basin-out ;
    s223:connected wbs:as-secondary-clarifier,
        wbs:primary-effluent-junction ;
    s223:connectedFrom wbs:primary-effluent-junction ;
    s223:connectedThrough wbs:conn-as-aeration-basin-to-as-secondary-clarifier,
        wbs:conn-primary-effluent-junction-to-as-aeration-basin ;
    s223:connectedTo wbs:as-secondary-clarifier ;
    s223:hasConnectionPoint wbs:as-aeration-basin-in,
        wbs:as-aeration-basin-out ;
    s223:hasProperty wbs:as-aeration-basin-dissolved-o2,
        wbs:as-aeration-basin-mlss-concentration,
        wbs:as-aeration-basin-ph,
        wbs:as-aeration-basin-temperature,
        wbs:as-aeration-basin-volume ;
    s223:hasRole watr:Role-Aerobic ;
    rdfs:comment "Two aeration basins of the activated sludge train, maximum flow 8 mgd" ;
    watr:hasProcess watr:Process-Aeration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-OrganicsRemoval .

wbs:primary-feed-junction a s223:Junction ;
    rdfs:label "Primary feed header" ;
    s223:cnx wbs:primary-feed-junction-inlet-cp,
        wbs:primary-feed-junction-inlet-cp-2,
        wbs:primary-feed-junction-outlet-cp ;
    s223:connected wbs:grit-chamber,
        wbs:primary-clarifier,
        wbs:return-pump ;
    s223:connectedFrom wbs:grit-chamber,
        wbs:return-pump ;
    s223:connectedThrough wbs:conn-grit-chamber-to-primary-feed-junction,
        wbs:conn-primary-feed-junction-to-primary-clarifier,
        wbs:conn-return-pump-to-primary-feed-junction ;
    s223:connectedTo wbs:primary-clarifier ;
    s223:hasConnectionPoint wbs:primary-feed-junction-inlet-cp,
        wbs:primary-feed-junction-inlet-cp-2,
        wbs:primary-feed-junction-outlet-cp ;
    s223:hasMedium s223:Fluid-Water .

wbs:as-secondary-clarifier a watr:Clarifier ;
    rdfs:label "A/S Secondary Clarifiers (2)" ;
    s223:cnx wbs:as-secondary-clarifier-in,
        wbs:as-secondary-clarifier-out,
        wbs:as-secondary-clarifier-out-sludge ;
    s223:connected wbs:as-aeration-basin,
        wbs:chlorine-mixing-chamber,
        wbs:thickener-feed-junction ;
    s223:connectedFrom wbs:as-aeration-basin ;
    s223:connectedThrough wbs:conn-as-aeration-basin-to-as-secondary-clarifier,
        wbs:conn-as-secondary-clarifier-to-chlorine-mixing-chamber,
        wbs:conn-as-secondary-clarifier-to-thickener-feed-junction ;
    s223:connectedTo wbs:chlorine-mixing-chamber,
        wbs:thickener-feed-junction ;
    s223:hasConnectionPoint wbs:as-secondary-clarifier-in,
        wbs:as-secondary-clarifier-out,
        wbs:as-secondary-clarifier-out-sludge ;
    s223:hasProperty wbs:as-secondary-clarifier-level-status,
        wbs:as-secondary-clarifier-volume ;
    s223:hasRole watr:Role-Secondary ;
    rdfs:comment "Two secondary clarifiers of the activated sludge train; waste activated sludge goes to the thickener" ;
    watr:hasProcess watr:Process-Settling ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Clarification .

wbs:rbc-secondary-clarifier a watr:Clarifier ;
    rdfs:label "RBC Secondary Clarifiers (3)" ;
    s223:cnx wbs:rbc-secondary-clarifier-in,
        wbs:rbc-secondary-clarifier-out,
        wbs:rbc-secondary-clarifier-out-sludge ;
    s223:connected wbs:chlorine-mixing-chamber,
        wbs:rbc-unit,
        wbs:thickener-feed-junction ;
    s223:connectedFrom wbs:rbc-unit ;
    s223:connectedThrough wbs:conn-rbc-secondary-clarifier-to-chlorine-mixing-chamber,
        wbs:conn-rbc-secondary-clarifier-to-thickener-feed-junction,
        wbs:conn-rbc-unit-to-rbc-secondary-clarifier ;
    s223:connectedTo wbs:chlorine-mixing-chamber,
        wbs:thickener-feed-junction ;
    s223:hasConnectionPoint wbs:rbc-secondary-clarifier-in,
        wbs:rbc-secondary-clarifier-out,
        wbs:rbc-secondary-clarifier-out-sludge ;
    s223:hasProperty wbs:rbc-secondary-clarifier-level-status,
        wbs:rbc-secondary-clarifier-volume ;
    s223:hasRole watr:Role-Secondary ;
    rdfs:comment "Three secondary clarifiers following the rotating biological contactor" ;
    watr:hasProcess watr:Process-Settling ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Clarification .

wbs:primary-clarifier a watr:Clarifier ;
    rdfs:label "Primary Sedimentation Tanks (4)" ;
    s223:cnx wbs:primary-clarifier-in,
        wbs:primary-clarifier-out,
        wbs:primary-clarifier-out-sludge ;
    s223:connected wbs:primary-effluent-junction,
        wbs:primary-feed-junction,
        wbs:thickener-feed-junction ;
    s223:connectedFrom wbs:primary-feed-junction ;
    s223:connectedThrough wbs:conn-primary-clarifier-to-primary-effluent-junction,
        wbs:conn-primary-clarifier-to-thickener-feed-junction,
        wbs:conn-primary-feed-junction-to-primary-clarifier ;
    s223:connectedTo wbs:primary-effluent-junction,
        wbs:thickener-feed-junction ;
    s223:hasConnectionPoint wbs:primary-clarifier-in,
        wbs:primary-clarifier-out,
        wbs:primary-clarifier-out-sludge ;
    s223:hasProperty wbs:primary-clarifier-level-status,
        wbs:primary-clarifier-turbidity,
        wbs:primary-clarifier-volume ;
    s223:hasRole watr:Role-Primary ;
    rdfs:comment "Four primary sedimentation tanks, maximum hydraulic flow 18 mgd; primary sludge goes to the thickener" ;
    watr:hasProcess watr:Process-Settling ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Clarification .

wbs:thickener-feed-junction a s223:Junction ;
    rdfs:label "Thickener feed header" ;
    s223:cnx wbs:thickener-feed-junction-inlet-cp,
        wbs:thickener-feed-junction-inlet-cp-2,
        wbs:thickener-feed-junction-inlet-cp-3,
        wbs:thickener-feed-junction-outlet-cp ;
    s223:connected wbs:as-secondary-clarifier,
        wbs:daf-thickener,
        wbs:primary-clarifier,
        wbs:rbc-secondary-clarifier ;
    s223:connectedFrom wbs:as-secondary-clarifier,
        wbs:primary-clarifier,
        wbs:rbc-secondary-clarifier ;
    s223:connectedThrough wbs:conn-as-secondary-clarifier-to-thickener-feed-junction,
        wbs:conn-primary-clarifier-to-thickener-feed-junction,
        wbs:conn-rbc-secondary-clarifier-to-thickener-feed-junction,
        wbs:conn-thickener-feed-junction-to-daf-thickener ;
    s223:connectedTo wbs:daf-thickener ;
    s223:hasConnectionPoint wbs:thickener-feed-junction-inlet-cp,
        wbs:thickener-feed-junction-inlet-cp-2,
        wbs:thickener-feed-junction-inlet-cp-3,
        wbs:thickener-feed-junction-outlet-cp ;
    s223:hasMedium watr:Fluid-Sludge .

wbs:chlorine-mixing-chamber a watr:StaticMixer ;
    rdfs:label "Chlorine Mixing Chamber" ;
    s223:cnx wbs:chlorine-mixing-chamber-chem-in,
        wbs:chlorine-mixing-chamber-in,
        wbs:chlorine-mixing-chamber-inlet-cp,
        wbs:chlorine-mixing-chamber-inlet-cp-2,
        wbs:chlorine-mixing-chamber-out ;
    s223:connected wbs:as-secondary-clarifier,
        wbs:chlorine-contact-tank,
        wbs:rbc-secondary-clarifier,
        wbs:storage-basin ;
    s223:connectedFrom wbs:as-secondary-clarifier,
        wbs:rbc-secondary-clarifier,
        wbs:storage-basin ;
    s223:connectedThrough wbs:conn-as-secondary-clarifier-to-chlorine-mixing-chamber,
        wbs:conn-chlorine-mixing-chamber-to-chlorine-contact-tank,
        wbs:conn-rbc-secondary-clarifier-to-chlorine-mixing-chamber,
        wbs:conn-storage-basin-to-chlorine-mixing-chamber ;
    s223:connectedTo wbs:chlorine-contact-tank ;
    s223:hasConnectionPoint wbs:chlorine-mixing-chamber-chem-in,
        wbs:chlorine-mixing-chamber-in,
        wbs:chlorine-mixing-chamber-inlet-cp,
        wbs:chlorine-mixing-chamber-inlet-cp-2,
        wbs:chlorine-mixing-chamber-out ;
    s223:hasProperty wbs:chlorine-mixing-chamber-dosing-flow-rate ;
    rdfs:comment "Static mixing chamber where chlorine is dosed into the combined secondary effluent; chem-in is the chlorine feed" ;
    watr:hasProcess watr:Process-Chlorination,
        watr:Process-Mixing .

wbs:primary-effluent-junction a s223:Junction ;
    rdfs:label "Primary effluent split" ;
    s223:cnx wbs:primary-effluent-junction-inlet-cp,
        wbs:primary-effluent-junction-inlet-cp-2,
        wbs:primary-effluent-junction-outlet-cp,
        wbs:primary-effluent-junction-outlet-cp-2,
        wbs:primary-effluent-junction-outlet-cp-3 ;
    s223:connected wbs:as-aeration-basin,
        wbs:flow-return-pump,
        wbs:primary-clarifier,
        wbs:rbc-unit,
        wbs:sluice-gate ;
    s223:connectedFrom wbs:flow-return-pump,
        wbs:primary-clarifier ;
    s223:connectedThrough wbs:conn-flow-return-pump-to-primary-effluent-junction,
        wbs:conn-primary-clarifier-to-primary-effluent-junction,
        wbs:conn-primary-effluent-junction-to-as-aeration-basin,
        wbs:conn-primary-effluent-junction-to-rbc-unit,
        wbs:conn-primary-effluent-junction-to-sluice-gate ;
    s223:connectedTo wbs:as-aeration-basin,
        wbs:rbc-unit,
        wbs:sluice-gate ;
    s223:hasConnectionPoint wbs:primary-effluent-junction-inlet-cp,
        wbs:primary-effluent-junction-inlet-cp-2,
        wbs:primary-effluent-junction-outlet-cp,
        wbs:primary-effluent-junction-outlet-cp-2,
        wbs:primary-effluent-junction-outlet-cp-3 ;
    s223:hasMedium s223:Fluid-Water ;
    rdfs:comment "Primary effluent plus the flow return pump stream, split to the activated sludge train (8 mgd), the RBC train (3 mgd) and the diurnal flow box" .

wbs:diurnal-flow-box a watr:Tank ;
    rdfs:label "Diurnal Flow Box" ;
    s223:cnx wbs:diurnal-flow-box-in,
        wbs:diurnal-flow-box-inlet-cp,
        wbs:diurnal-flow-box-out,
        wbs:diurnal-flow-box-outlet-cp,
        wbs:diurnal-flow-box-outlet-cp-2 ;
    s223:connected wbs:flow-return-pump,
        wbs:return-pump,
        wbs:sluice-gate,
        wbs:storage-basin ;
    s223:connectedFrom wbs:sluice-gate,
        wbs:storage-basin ;
    s223:connectedThrough wbs:conn-diurnal-flow-box-to-flow-return-pump,
        wbs:conn-diurnal-flow-box-to-return-pump,
        wbs:conn-diurnal-flow-box-to-storage-basin,
        wbs:conn-sluice-gate-to-diurnal-flow-box,
        wbs:conn-storage-basin-to-diurnal-flow-box ;
    s223:connectedTo wbs:flow-return-pump,
        wbs:return-pump,
        wbs:storage-basin ;
    s223:hasConnectionPoint wbs:diurnal-flow-box-in,
        wbs:diurnal-flow-box-inlet-cp,
        wbs:diurnal-flow-box-out,
        wbs:diurnal-flow-box-outlet-cp,
        wbs:diurnal-flow-box-outlet-cp-2 ;
    s223:hasProperty wbs:diurnal-flow-box-level-status,
        wbs:diurnal-flow-box-ph,
        wbs:diurnal-flow-box-temperature,
        wbs:diurnal-flow-box-turbidity,
        wbs:diurnal-flow-box-volume ;
    s223:hasRole watr:Role-Equalization ;
    rdfs:comment "Flow equalization box between the primary effluent split and the multi-purpose storage basins" .

wbs:storage-basin a watr:Tank ;
    rdfs:label "Multi-purpose Storage Basins (7)" ;
    s223:cnx wbs:storage-basin-in,
        wbs:storage-basin-inlet-cp,
        wbs:storage-basin-inlet-cp-2,
        wbs:storage-basin-out,
        wbs:storage-basin-outlet-cp ;
    s223:connected wbs:chlorine-mixing-chamber,
        wbs:diurnal-flow-box,
        wbs:effluent-junction,
        wbs:wet-weather-screen ;
    s223:connectedFrom wbs:diurnal-flow-box,
        wbs:effluent-junction,
        wbs:wet-weather-screen ;
    s223:connectedThrough wbs:conn-diurnal-flow-box-to-storage-basin,
        wbs:conn-effluent-junction-to-storage-basin,
        wbs:conn-storage-basin-to-chlorine-mixing-chamber,
        wbs:conn-storage-basin-to-diurnal-flow-box,
        wbs:conn-wet-weather-screen-to-storage-basin ;
    s223:connectedTo wbs:chlorine-mixing-chamber,
        wbs:diurnal-flow-box ;
    s223:hasConnectionPoint wbs:storage-basin-in,
        wbs:storage-basin-inlet-cp,
        wbs:storage-basin-inlet-cp-2,
        wbs:storage-basin-out,
        wbs:storage-basin-outlet-cp ;
    s223:hasProperty wbs:storage-basin-level-status,
        wbs:storage-basin-ph,
        wbs:storage-basin-temperature,
        wbs:storage-basin-turbidity,
        wbs:storage-basin-volume ;
    s223:hasRole watr:Role-Equalization,
        watr:Role-Storage ;
    rdfs:comment "Seven flow equalization and storage basins, 1 million gallons in all, that take wet-weather flow, diurnal flow box exchange and returned final effluent and overflow to the chlorine mixing chamber" .

