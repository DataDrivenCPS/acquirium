    s223:connectsThrough wbs:conn-flow-return-pump-to-primary-effluent-junction ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty wbs:flow-return-pump-out-flow-rate,
        wbs:flow-return-pump-out-pressure ;
    s223:isConnectionPointOf wbs:flow-return-pump .

wbs:influent-pump-out a s223:OutletConnectionPoint ;
    s223:cnx wbs:conn-influent-pump-to-headworks-screen,
        wbs:influent-pump ;
