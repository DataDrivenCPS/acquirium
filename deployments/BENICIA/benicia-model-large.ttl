    s223:connectsFrom wbs:wet-weather-screen ;
    s223:connectsTo wbs:storage-basin ;
    s223:hasMedium s223:Fluid-Water .

wbs:daf-thickener-in a s223:InletConnectionPoint ;
    s223:cnx wbs:conn-thickener-feed-junction-to-daf-thickener,
        wbs:daf-thickener ;
    s223:connectsThrough wbs:conn-thickener-feed-junction-to-daf-thickener ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:hasProperty wbs:daf-thickener-in-flow-rate,
        wbs:daf-thickener-in-tss-concentration ;
    s223:isConnectionPointOf wbs:daf-thickener .

wbs:daf-thickener-out a s223:OutletConnectionPoint ;
    s223:cnx wbs:conn-daf-thickener-to-anaerobic-digester,
        wbs:daf-thickener ;
    s223:connectsThrough wbs:conn-daf-thickener-to-anaerobic-digester ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:hasProperty wbs:daf-thickener-out-flow-rate,
        wbs:daf-thickener-out-tss-concentration ;
    s223:isConnectionPointOf wbs:daf-thickener .

